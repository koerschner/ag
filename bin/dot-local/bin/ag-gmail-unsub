#!/usr/bin/env python3
"""ag-gmail-unsub: tag an email in Gmail and never see that sender again. Nightly routine
gmail-unsubscribe (routines/gmail-unsubscribe.md) runs "ag-gmail-unsub sweep" on the session host.

For each of the user's Google accounts (personal: $AG_PERSONAL_GOOGLE_ACCOUNT, work: $AG_WORK_GOOGLE_ACCOUNT,
both from ~/ag-personal/env), every message carrying the label "Unsubscribe" is handled by sender address:

  1. Unsubscribe from everything that service sends: every mailing list (List-Unsubscribe header) seen in the
     last year from the sender's domain (only the address itself for shared domains: gmail.com, substack.com,
     github.com, google.com and the like, where one domain is many unrelated senders). Only the easy methods:
     RFC 8058 one-click POST, or a mailto: request sent from the account. Web pages that need clicking are
     not attempted.
  2. If the tagged address itself couldn't be unsubscribed that way, create a Gmail filter on that address
     (skip the inbox, mark read, label "Unsubscribed").
  3. Tagged mail and the rest of that address's inbox mail move out of the inbox to "Unsubscribed"; the
     "Unsubscribe" label comes off.
  An address that was unsubscribed but still lands in the inbox 3+ days later (up to 30 days) gets the filter.

  ag-gmail-unsub sweep [--dry-run] [--account personal|work]   the nightly pass (prints one summary line last)
  ag-gmail-unsub auth personal|work                            (on ag-mac) one-time consent in its Chrome

OAuth: the Desktop client "ag-gcal" in Google Cloud project ag-calendar-nk (Gmail API enabled), scopes
gmail.modify + gmail.settings.basic. Refresh tokens: personal in op-shared (item "ag-gmail-unsub personal",
vault machine-shared, read through ag-mac off the Mac), work in op-work (item "ag-gmail-unsub work", vault
ag-vault). State per account in ~/.local/state/ag-gmail-unsub/.
"""
import base64, json, os, platform, re, shlex, subprocess, sys, time, urllib.error, urllib.parse, urllib.request
from email.message import EmailMessage
from email.utils import getaddresses, parseaddr

API = "https://gmail.googleapis.com/gmail/v1/users/me"
SCOPE = "https://www.googleapis.com/auth/gmail.modify https://www.googleapis.com/auth/gmail.settings.basic"
TAG, DONE = "Unsubscribe", "Unsubscribed"
CLIENT_ITEM, CLIENT_VAULT = "ag-gcal Google Calendar OAuth", "machine-shared"
ACCOUNTS = {  # name -> (env var with the address, 1Password wrapper, vault)
    "personal": ("AG_PERSONAL_GOOGLE_ACCOUNT", "op-shared", "machine-shared"),
    "work": ("AG_WORK_GOOGLE_ACCOUNT", "op-work", "ag-vault"),
}
SHARED = {  # domains that carry many unrelated senders: unsubscribe only the tagged address there
    "gmail.com", "googlemail.com", "outlook.com", "hotmail.com", "live.com", "yahoo.com", "icloud.com", "me.com",
    "aol.com", "proton.me", "protonmail.com", "substack.com", "beehiiv.com", "ghost.io", "buttondown.email",
    "mailchimpapp.com", "mcsv.net", "sendgrid.net", "convertkit-mail.com", "googlegroups.com", "google.com",
    "github.com", "linear.app", "slack.com", "atlassian.net", "notion.so", "superbuilders.school",
}
ON_MAC = platform.system() == "Darwin"
STATE_DIR = os.path.expanduser("~/.local/state/ag-gmail-unsub")
CACHE_DIR = os.path.expanduser("~/.cache/ag-gmail-unsub")
GRACE, WATCH = 3 * 86400, 30 * 86400
UA = "Mozilla/5.0 (ag-gmail-unsub)"


def die(msg, code=1):
    print(f"ag-gmail-unsub: {msg}", file=sys.stderr)
    sys.exit(code)


def env_value(key):
    if os.environ.get(key):
        return os.environ[key]
    try:
        for line in open(os.path.expanduser("~/ag-personal/env")):
            if line.startswith(key + "="):
                return line.split("=", 1)[1].strip().strip("'\"")
    except OSError:
        pass
    return ""


# ---------- credentials ----------

def op_json(wrapper, item, vault):
    cmd = [wrapper, "item", "get", item, "--vault", vault, "--reveal", "--format", "json"]
    if wrapper == "op-shared" and not ON_MAC:
        cmd = ["ag-mac", "run", " ".join(map(shlex.quote, cmd)) + " </dev/null"]
    r = subprocess.run(cmd, capture_output=True, text=True, stdin=subprocess.DEVNULL)
    if r.returncode:
        raise RuntimeError(f"can't read {item!r} from {wrapper}: {r.stderr.strip()[:300]}")
    return {f.get("label"): f.get("value") for f in json.loads(r.stdout)["fields"]}


def post_form(url, data):
    req = urllib.request.Request(url, urllib.parse.urlencode(data).encode())
    try:
        return json.load(urllib.request.urlopen(req, timeout=30))
    except urllib.error.HTTPError as e:
        raise RuntimeError(f"{url}: {e.code} {e.read().decode()[:400]}")


class Gmail:
    def __init__(self, name):
        self.name = name
        self.var, self.wrapper, self.vault = ACCOUNTS[name]
        self.item = f"ag-gmail-unsub {name}"
        self.cache = os.path.join(CACHE_DIR, f"{name}.json")

    def token(self, force=False):
        if not force and os.path.exists(self.cache):
            c = json.load(open(self.cache))
            if c.get("exp", 0) > time.time() + 60:
                return c["token"]
        f = op_json(self.wrapper, self.item, self.vault)
        t = post_form("https://oauth2.googleapis.com/token", {"client_id": f["client_id"], "client_secret": f["client_secret"],
                      "refresh_token": f["refresh_token"], "grant_type": "refresh_token"})
        os.makedirs(CACHE_DIR, mode=0o700, exist_ok=True)
        fd = os.open(self.cache, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as fh:
            json.dump({"token": t["access_token"], "exp": time.time() + t.get("expires_in", 3600)}, fh)
        return t["access_token"]

    def api(self, method, path, params=None, body=None, retry=True):
        url = API + path + ("?" + urllib.parse.urlencode(params, doseq=True) if params else "")
        for attempt in range(6):
            req = urllib.request.Request(url, method=method, data=json.dumps(body).encode() if body is not None else None,
                                         headers={"Authorization": "Bearer " + self.token(force=not retry),
                                                  "Content-Type": "application/json"})
            try:
                data = urllib.request.urlopen(req, timeout=60).read()
                return json.loads(data) if data else {}
            except urllib.error.HTTPError as e:
                err = e.read().decode()
                if e.code == 401 and retry:
                    return self.api(method, path, params, body, retry=False)
                if (e.code == 429 or "rateLimitExceeded" in err) and attempt < 5:
                    time.sleep(15 * (attempt + 1))  # per-user Gmail quota is per minute
                    continue
                raise RuntimeError(f"{method} {path}: {e.code} {err[:600]}")

    def search(self, q=None, label_ids=None, limit=500):
        ids, page = [], None
        while len(ids) < limit:
            p = {"maxResults": min(500, limit - len(ids))}
            if q:
                p["q"] = q
            if label_ids:
                p["labelIds"] = label_ids
            if page:
                p["pageToken"] = page
            r = self.api("GET", "/messages", p)
            ids += [m["id"] for m in r.get("messages", [])]
            page = r.get("nextPageToken")
            if not page:
                break
        return ids

    def headers(self, mid):
        try:
            m = self.api("GET", f"/messages/{mid}", {"format": "metadata", "metadataHeaders":
                         ["From", "List-Unsubscribe", "List-Unsubscribe-Post", "List-Id"]})
        except RuntimeError as e:
            if "failedPrecondition" in str(e):  # e.g. chat items Gmail can't return as messages
                return {"_date": 0}
            raise
        h = {x["name"].lower(): x["value"] for x in m.get("payload", {}).get("headers", [])}
        h["_date"] = int(m.get("internalDate", 0))
        return h

    def labels(self):
        have = {l["name"]: l["id"] for l in self.api("GET", "/labels").get("labels", [])}
        for name in (TAG, DONE):
            if name not in have:
                have[name] = self.api("POST", "/labels", body={"name": name, "labelListVisibility": "labelShow",
                                                               "messageListVisibility": "show"})["id"]
        return have[TAG], have[DONE]

    def modify(self, ids, add=(), remove=()):
        for i in range(0, len(ids), 1000):
            self.api("POST", "/messages/batchModify", body={"ids": ids[i:i + 1000], "addLabelIds": list(add),
                                                             "removeLabelIds": list(remove)})


# ---------- unsubscribing ----------

def sender(h):
    return parseaddr(h.get("from", ""))[1].lower()


def base_domain(addr):
    host = addr.rsplit("@", 1)[-1]
    parts = host.split(".")
    n = 3 if len(parts) >= 3 and len(parts[-1]) == 2 and parts[-2] in {"co", "com", "org", "net", "ac", "gov", "edu"} else 2
    return ".".join(parts[-n:])


def unsub_targets(h):
    return re.findall(r"<\s*([^>]+?)\s*>", h.get("list-unsubscribe", ""))


def one_click(url):
    req = urllib.request.Request(url, data=b"List-Unsubscribe=One-Click", method="POST",
                                 headers={"Content-Type": "application/x-www-form-urlencoded", "User-Agent": UA})
    try:
        return 200 <= urllib.request.urlopen(req, timeout=30).status < 300
    except Exception:
        return False


def mailto(g, target, me):
    u = urllib.parse.urlparse(target)
    q = {k.lower(): v[0] for k, v in urllib.parse.parse_qs(u.query).items()}
    to = urllib.parse.unquote(u.path)
    if not to or not getaddresses([to])[0][1]:
        return False
    msg = EmailMessage()
    msg["To"], msg["From"], msg["Subject"] = to, me, q.get("subject", "unsubscribe")
    msg.set_content(q.get("body", "unsubscribe"))
    raw = base64.urlsafe_b64encode(msg.as_bytes()).decode()
    try:
        g.api("POST", "/messages/send", body={"raw": raw})
        return True
    except RuntimeError:
        return False


def unsubscribe(g, h, me, dry):
    """-> method used ('one-click' | 'mailto' | 'dry-run') or None if no easy way worked."""
    targets = unsub_targets(h)
    https = [t for t in targets if t.lower().startswith("https://")]
    mails = [t for t in targets if t.lower().startswith("mailto:")]
    can_click = https and "one-click" in h.get("list-unsubscribe-post", "").lower()
    if dry:
        return "dry-run" if can_click or mails else None
    if can_click and one_click(https[0]):
        return "one-click"
    if mails and mailto(g, mails[0], me):
        return "mailto"
    return None


def make_filter(g, addr, done_id, filters, dry):
    if any((f.get("criteria") or {}).get("from", "").lower() == addr for f in filters):
        return
    if not dry:
        f = g.api("POST", "/settings/filters", body={"criteria": {"from": addr},
                  "action": {"addLabelIds": [done_id], "removeLabelIds": ["INBOX", "UNREAD"]}})
        filters.append(f)


# ---------- sweep ----------

def load_state(name):
    try:
        return json.load(open(os.path.join(STATE_DIR, f"{name}.json")))
    except (OSError, ValueError):
        return {"unsubscribed": {}, "filtered": {}}


def save_state(name, st):
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(os.path.join(STATE_DIR, f"{name}.json"), "w") as fh:
        json.dump(st, fh, indent=1, sort_keys=True)


def sweep_account(name, dry):
    me = env_value(ACCOUNTS[name][0])
    g = Gmail(name)
    tag_id, done_id = g.labels()
    filters = g.api("GET", "/settings/filters").get("filter", [])
    st = load_state(name)
    now = time.time()
    stats = {"senders": 0, "unsub": 0, "filtered": 0, "lists": 0, "relapsed": 0}

    tagged = {}
    for mid in g.search(label_ids=[tag_id]):
        tagged.setdefault(sender(g.headers(mid)), []).append(mid)
    tagged.pop("", None)
    tagged.pop(me.lower(), None)  # never filter the user's own address

    for addr, mids in tagged.items():
        stats["senders"] += 1
        dom = addr.rsplit("@", 1)[-1]
        base = base_domain(addr)
        scope = addr if dom in SHARED or base in SHARED else base
        # Every list this service sends: newest message per List-Id (or per sender when there's none).
        lists = {}
        for mid in set(g.search(q=f"from:({scope}) newer_than:1y", limit=300)) | set(mids):
            h = g.headers(mid)
            s = sender(h)
            if not (s == addr or (scope != addr and (s.endswith("@" + scope) or s.endswith("." + scope)))):
                continue
            if not unsub_targets(h):
                continue
            key = h.get("list-id") or s
            if key not in lists or h["_date"] > lists[key][0]["_date"]:
                lists[key] = (h, s)
        own_ok = False
        for key, (h, s) in lists.items():
            method = unsubscribe(g, h, me, dry)
            if method:
                stats["lists"] += 1
                if not dry:
                    st["unsubscribed"][s] = {"at": now, "method": method, "list": key}
                own_ok |= s == addr
            print(f"[{name}] {addr}: list {key} ({s}) -> {method or 'no easy unsubscribe'}")
        if own_ok:
            stats["unsub"] += 1
        else:
            make_filter(g, addr, done_id, filters, dry)
            stats["filtered"] += 1
            if not dry:
                st["filtered"][addr] = now
            print(f"[{name}] {addr}: filtered")
        if not dry:
            inbox = g.search(q=f"in:inbox from:({addr})", limit=1000)
            g.modify(list(set(mids) | set(inbox)), add=[done_id], remove=[tag_id, "INBOX"])

    # Unsubscribed but still arriving after the grace period -> filter it after all.
    for addr, rec in list(st["unsubscribed"].items()):
        age = now - rec["at"]
        if addr in st["filtered"] or age < GRACE or age > WATCH:
            continue
        late = g.search(q=f"in:inbox from:({addr}) after:{int(rec['at'] + GRACE)}", limit=50)
        if late:
            stats["relapsed"] += 1
            print(f"[{name}] {addr}: still sending after unsubscribe, filtered")
            if not dry:
                make_filter(g, addr, done_id, filters, dry)
                g.modify(late, add=[done_id], remove=["INBOX"])
                st["filtered"][addr] = now
    if not dry:
        save_state(name, st)
    return stats


def sweep(args):
    dry = "--dry-run" in args
    names = [args[args.index("--account") + 1]] if "--account" in args else list(ACCOUNTS)
    parts, failed = [], False
    for name in names:
        try:
            s = sweep_account(name, dry)
            parts.append(f"{name}: {s['senders']} tagged senders, {s['unsub']} unsubscribed ({s['lists']} lists), "
                         f"{s['filtered']} filtered" + (f", {s['relapsed']} re-filtered" if s["relapsed"] else ""))
        except Exception as e:
            failed = True
            parts.append(f"{name}: FAILED {str(e)[:200]}")
            print(f"[{name}] error: {e}", file=sys.stderr)
    print(("dry run; " if dry else "") + "; ".join(parts))
    sys.exit(1 if failed else 0)


# ---------- auth (on ag-mac, once per account) ----------

def auth(name):
    import http.server, secrets
    if name not in ACCOUNTS:
        die("usage: ag-gmail-unsub auth personal|work", 2)
    if not ON_MAC:
        die("run auth on ag-mac (its Chrome is signed in to both accounts)")
    var, wrapper, vault = ACCOUNTS[name]
    item = f"ag-gmail-unsub {name}"
    c = op_json("op-shared", CLIENT_ITEM, CLIENT_VAULT)
    port, state = 8767, secrets.token_urlsafe(16)
    redirect = f"http://127.0.0.1:{port}/"
    url = "https://accounts.google.com/o/oauth2/v2/auth?" + urllib.parse.urlencode({
        "client_id": c["client_id"], "redirect_uri": redirect, "response_type": "code", "scope": SCOPE,
        "access_type": "offline", "prompt": "consent", "state": state, "login_hint": env_value(var)})
    got = {}

    class H(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            qs = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            if qs.get("state", [""])[0] == state and "code" in qs:
                got["code"] = qs["code"][0]
            self.send_response(200); self.end_headers()
            self.wfile.write(b"ag-gmail-unsub: done, you can close this tab." if got else b"ag-gmail-unsub: no code")

        def log_message(self, *a):
            pass

    srv = http.server.HTTPServer(("127.0.0.1", port), H)
    print("open this URL in Chrome on ag-mac and allow access:\n" + url, flush=True)
    srv.timeout = 900
    while "code" not in got:
        srv.handle_request()
    t = post_form("https://oauth2.googleapis.com/token", {"client_id": c["client_id"], "client_secret": c["client_secret"],
                  "code": got["code"], "redirect_uri": redirect, "grant_type": "authorization_code"})
    if "refresh_token" not in t:
        die("no refresh token returned")
    rec = {"title": item, "category": "API_CREDENTIAL", "fields": [
        {"id": "client_id", "label": "client_id", "type": "STRING", "value": c["client_id"]},
        {"id": "client_secret", "label": "client_secret", "type": "CONCEALED", "value": c["client_secret"]},
        {"id": "refresh_token", "label": "refresh_token", "type": "CONCEALED", "value": t["refresh_token"]},
        {"id": "notesPlain", "label": "notesPlain", "type": "STRING", "purpose": "NOTES",
         "value": f"Used by ag-gmail-unsub (ag repo), {name} account. Google Cloud project ag-calendar-nk, "
                  "Desktop OAuth client ag-gcal, scopes gmail.modify + gmail.settings.basic."}]}
    subprocess.run([wrapper, "item", "delete", item, "--vault", vault], capture_output=True, stdin=subprocess.DEVNULL)
    r = subprocess.run([wrapper, "item", "create", "--vault", vault, "-"], input=json.dumps(rec), text=True, capture_output=True)
    if r.returncode:
        die(f"storing in {wrapper} failed: " + r.stderr)
    print(f"stored refresh token in {wrapper}: {item}")


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip()); return
    if argv[0] == "auth":
        return auth(argv[1] if len(argv) > 1 else "")
    if argv[0] == "sweep":
        return sweep(argv[1:])
    die(f"unknown command {argv[0]!r} (see --help)", 2)


if __name__ == "__main__":
    main(sys.argv[1:])
