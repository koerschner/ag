#!/usr/bin/env python3
"""ag link — print a session's link (default: this one), stable across tab moves.

    ag link [session…] [--phone] [--url] [--app]
Under T3 (AG_UI=t3) a session with a T3 thread links to that thread; otherwise to ag-dash.
    (default)  "<title>  <url>", plus an "in-app" line with the T3 form when the session has a thread
    --app      just the in-app form, [title](t3-thread://v1/<thread id>): paste it in a T3 reply and it opens
               the thread right there (T3's Mac, web and iOS apps all handle it)
    --url      just the URL (https://ag.<tailnet>/<env>/<thread>, or http://ag:7376/<sid> for ag-dash)
    --phone    the https link for the phone (the same T3 URL; ag-dash's https port otherwise)
In a T3 reply, use the in-app form; in a terminal, put the URL on its own line, bare.
"""
import os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from aglib import *


def main(argv):
    o, pos = flags(argv, {"--phone": False, "--url": False, "--app": False})
    if o.get("--help"):
        return usage(__doc__)
    ix = Index(with_board=False)
    for ref in pos or [None]:
        s = resolve(ref, ix)
        if not s.sid:
            raise AgError(f"{s.title} ({s.tab}) has no pi session, so no link")
        app = app_link(s.sid)
        if o.get("--app"):
            if not app:
                raise AgError(f"{s.title} has no T3 thread yet (ag-t3 import {s.sid[-8:]} gives it one)")
            print(app)
            continue
        url = phone_link(s.sid) if o.get("--phone") else s.link
        if o.get("--url"):
            print(url)
        else:
            print(f"{s.title}  {url}")
            if app:
                print(f"  in-app  {app}")


run_main(main)
