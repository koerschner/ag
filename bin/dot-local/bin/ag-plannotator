#!/usr/bin/env bash
# ag-plannotator: the Plannotator Inbox (https://plannotator.ai/inbox/) on the session host, Ag's trial of an
# agent inbox: Pi agents leave questions, blockers, files and guided reviews there; the user answers from any
# device on the tailnet, and the reply arrives as the session's next turn.
#
#   ag-plannotator setup     install plannotator + the Pi extension, write its config, publish over the tailnet
#   ag-plannotator start     start the Inbox in the background (agents also start it on demand)
#   ag-plannotator url       the tailnet URL of the running Inbox (or its local one)
#   ag-plannotator status    plannotator inbox status
#
# Config written by setup (~/.plannotator/config.json): the Pi inbox tool on (off by default upstream; it adds
# ~3k tokens to every request of sessions that have it), publish over the tailnet at every start, let in the
# tailnet owner (AG_TAILNET_OWNER in ~/ag-personal/env: this machine is a tagged device, so it has no owner of
# its own), and no managed note in agents' instruction files (ours is agents.md/sections/097-plannotator-inbox.md;
# ~/.pi/agent/AGENTS.md is generated and would lose it). The Inbox binds 127.0.0.1 on a port it picks; the
# tailnet address is https://<this host>.<tailnet>.ts.net:<port>, via tailscale serve (needs this user as the
# Tailscale operator: setup sets it).
set -euo pipefail
cfg=~/.plannotator/config.json
penv() { sed -n "s/^$1=//p" ~/ag-personal/env 2>/dev/null | tail -1; }
export PLANNOTATOR_INBOX_NOTES=0 PLANNOTATOR_INBOX_CONNECT=0

case ${1:-status} in
setup)
	command -v plannotator >/dev/null || curl -fsSL https://plannotator.ai/install.sh | bash >/dev/null
	grep -q '@plannotator/pi-extension' ~/.pi/agent/settings.json 2>/dev/null || pi install npm:@plannotator/pi-extension >/dev/null
	owner=$(penv AG_TAILNET_OWNER)
	mkdir -p ~/.plannotator
	[[ -s $cfg ]] || echo '{}' > "$cfg"
	python3 - "$cfg" "$owner" <<-'EOF'
	import json, sys
	path, owner = sys.argv[1], sys.argv[2]
	c = json.load(open(path))
	c["inboxTool"] = {**(c.get("inboxTool") if isinstance(c.get("inboxTool"), dict) else {}), "pi": True}
	c["inboxTailscale"] = True
	if owner: c["inboxTailscaleAllow"] = sorted(set(c.get("inboxTailscaleAllow", []) + [owner]))
	c["inboxNotes"] = False
	json.dump(c, open(path, "w"), indent=2)
	EOF
	tailscale status --self --json 2>/dev/null | grep -q '"BackendState": "Running"' && sudo -n tailscale set --operator="$USER" 2>/dev/null || true
	"$0" start
	;;
start) (cd ~ && plannotator inbox --background) ;;
url)
	local_url=$(plannotator inbox status --json 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("url",""))')
	port=${local_url##*:}; port=${port%%/*}
	tailscale serve status 2>/dev/null | sed -nE "s#^(https://[^ ]+:$port) .*#\\1#p" | head -1 | grep . || echo "$local_url"
	;;
status) plannotator inbox status ;;
*) sed -n '2,9p' "$0"; exit 2 ;;
esac
