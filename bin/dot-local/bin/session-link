#!/bin/sh
# session-link: print a link that opens this pi session on AG Dash (bin/dot-local/bin/ag-board), for the
# phone: https://ag.<tailnet>.ts.net:7377/<pi session id> (full name + https so iMessage linkifies it and the
# phone resolves it without MagicDNS short names). The board shows the live session (transcript, reply), or a
# hibernated/closed one with Wake / Resume; its "📱 Open in Moshi" button goes on to the terminal via file-inbox
# (GET /m/<session id> → moshi://herdr?workspace&tab&pane).
# Usage: session-link [pi session file]   (default: $PI_SESSION_FILE)
set -eu
f=${1:-${PI_SESSION_FILE:?not in a pi session; pass a session file}}
id=$(basename "$f" .jsonl | sed 's/.*_//')
ts=/Applications/Tailscale.app/Contents/MacOS/Tailscale
[ -x "$ts" ] || ts=/usr/local/bin/tailscale
# The Tailscale Service svc:ag (ag-svc), not a machine name, so links survive moving the session host.
dns=ag.$("$ts" status --json 2>/dev/null | /usr/bin/python3 -c 'import json,sys; print(json.load(sys.stdin)["MagicDNSSuffix"])' 2>/dev/null || echo tail44736d.ts.net)
echo "https://$dns:7377/$id"
