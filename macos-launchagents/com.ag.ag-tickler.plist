<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ag.ag-tickler</string>
  <!-- Tickler: every minute, fire due deferred tasks as new pi tabs. Host only, where the pi sessions live. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>"$HOME/.local/bin/ag-machine-role" host || exit 0; exec "$HOME/.local/bin/ag-tickler" fire</string>
  </array>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/ag-tickler.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/ag-tickler.log</string>
</dict>
</plist>
