#!/usr/bin/env bun
// ag-board (AG Dash): a Kanban dashboard over every agent session (ag-mux on tmux). http://ag:7376/ (Tailscale only).
//
// ag-mux stays the runtime; this is a view on it plus a little metadata ag-mux doesn't keep.
//   - Polls `ag-mux api snapshot` (~15 ms) every POLL_MS; each tab hosting an agent is a card.
//   - Reads each card's Pi session file incrementally (only appended bytes) for the latest ask/answer,
//     live activity (thinking / running a tool since when), recent tools, thinking, cost and context size.
//   - Keeps its own state in ~/.local/state/ag-board/state.json: pinned flag, list, seenAt, status timing, lists.
//   - Pushes the whole board to browsers over SSE (/events) whenever anything changes.
// Card semantics:
//   ready     = agent idle/done/blocked (at its prompt)
//   needsYou  = blocked, or ready with an answer newer than seenAt. Seen = opened on the board, replied
//               from it, jumped to in tmux, or the tab is focused in tmux.
//   resolved  = the latest answer ends with a DONE line (the global "signal completion" convention).
//   pinned    = top priority (shift+click / long-press). Pinned to the top everywhere; its siren ring runs
//               whenever the agent isn't working (throb). Becoming needsYou fires the fast lane: ag-text + a tmux toast.
//               While the siren runs, the client keeps a persistent desktop alert up (GET /api/pinned → hammerspoon ag_pinned.lua).
// Every page is a URL (views, columns, /new, /help, /<session id>[/live]); the page's router handles back/forward.
// Deep links: http://ag:7376/<pi session id> (the UUID in the session filename; stable, unlike tab ids) serves the
// board with that session open: the live card's drawer, or, for a hibernated pane or a closed session, its
// transcript read-only with Wake in tmux / Resume (POST /api/resume: new tab running `pi --session <file>`).
// GET /api/session/<id> resolves an id; GET /api/transcript?sid=<id> reads any session file.
// Media: GET /api/file?path= (image/video files under ~ or /tmp, Range-capable), GET /api/embedded?tab=&line=&idx=
// (base64 images inside the session, e.g. pasted screenshots and read-tool images).
// Also: dictated replies (POST /api/dictate: answered at once, Whisper via TrueFoundry in the background, then
// sent), pasted files (POST /api/upload → ~/inbox/clipboard), new items (POST /api/new: text and/or a recording,
// handed to the ag inbox, which opens it in Inbox and names it), renaming tabs (POST /api/rename). Served on the Tailscale IP (http://ag:7376), on
// 127.0.0.1 (for tailscale serve), and at https://ag.<tailnet>.ts.net:7377 (set up at startup), where voice works.
// Waiting for: a session with a live tickler item (a wake-up on CI / a condition / an event, a presence item, a
// scheduled time, or a GTD waiting-for on a person; ~/.local/state/tickler/*.json, matched by session file), or
// marked by hand (POST /api/card {waiting}). Waiting cards sit in their own column, aren't "needs you", never ping
// or get the red siren; they get a blue orbit instead.
// "Waiting always wakes up" (AGENTS.md → GTD model): nothing may sit in Waiting for without a tickler item that will
// wake it. A hand-set wait prompts the session (once it's at its prompt) to schedule its own wake-up at an interval
// it chooses; until the item exists the card is flagged "no wake-up" (noWake) and re-asked up to WAKE_MAX times,
// WAKE_EVERY_MS apart. When the tickler item appears it takes over and the hand-set flag drops; the flag also clears
// if the session is given new work (a prompt that isn't ours).
// Control (Pi semantics): a prompt sent while the agent works is queued as steering (delivered after the
// current step). Interrupt = Esc twice (this Pi setup asks for a second Esc); Pi puts any queued steering
// back in its editor. Interrupt & send = interrupt, wait until ready, clear the editor (Ctrl+U), then send.
// Telemetry: the page sends one POST /api/click {name, view} per control click (sendBeacon); it's appended to
// ~/.local/state/ag-board/clicks.jsonl. GET /api/stats?days=N ranks controls by clicks (`ag-dash-stats` prints it).
// New item routing: POST /api/new asks Jev what the text is for. Housekeeping on sessions (pin, close, file,
// gather …) → a short-lived session in the Meta workspace ({kind:"meta"}; it closes itself 10 min after DONE).
// Looking for an existing session → it answers
// {kind:"find"} and the page calls POST /api/search {q} → `ag search --json` (an LLM picks the matching sessions)
// and shows them as cards, with "Start a new session instead" (route=new skips the check).
// API: GET /api/state, /api/transcript?tab=, /api/screen?tab=, /api/stats?days=
//      POST /api/card {tab, pinned?, list?, seen?}, /api/lists {lists}, /api/prompt {tab, text, interrupt?},
//           /api/interrupt {tab}, /api/keys {tab, keys[]}, /api/focus {tab}, /api/close {tab}
// System strip (board.sys, header pills): engine memory (/proc/meminfo + PSI) and ag-mac's computer-use queue
// (`ssh ag-mac cua-queue json` every 5 s, in the background).
// Page: ~/.local/share/ag-board/index.html (stowed from the ag repo, ag-board/), re-read on every request.
// Run by the com.nathan.ag-board LaunchAgent (only on ag-mac). Log: /tmp/ag-board.log.

import { execFileSync } from "node:child_process";
import { appendFileSync, closeSync, existsSync, mkdirSync, openSync, readdirSync, readFileSync, readSync, realpathSync, renameSync, statSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import { dirname } from "node:path";
import { constants as zc, createGzip } from "node:zlib";
// Deterministic one-line summaries of tool calls + the machine each runs on (~/ag/toolsum; `toolsum` CLI).
import { sessionHost, summarize } from "../../../toolsum/toolsum.ts";

const PORT = 7376;
// Ag's machine-independent address: the Tailscale Service svc:ag (ag-svc), wherever sessions are hosted.
const AG_FQDN = process.env.AG_FQDN ?? (() => {
	try {
		return `ag.${JSON.parse(execFileSync("/usr/local/bin/tailscale", ["status", "--json"], { encoding: "utf8" })).MagicDNSSuffix}`;
	} catch {
		return "ag.tail44736d.ts.net";
	}
})();
const HTTPS_PORT = 7377; // `tailscale serve` → https://ag.<tailnet>.ts.net:7377 (browsers only allow the mic on https)
const POLL_MS = 1500;
const HOME = homedir();
const AG_MUX = `${HOME}/.local/bin/ag-mux`;
const AG_TEXT = `${HOME}/.local/bin/ag-text`;
const STATE_DIR = `${HOME}/.local/state/ag-board`;
const STATE_FILE = `${STATE_DIR}/state.json`;
const GONE_KEEP_MS = 7 * 24 * 3600_000;
const CLICKS_FILE = `${STATE_DIR}/clicks.jsonl`;
const PAGE = `${HOME}/.local/share/ag-board/index.html`;
const CHAT_PAGE = `${HOME}/.local/share/ag-board/chat.html`; // ChatGPT-desktop-style view at /chat (same APIs)
// Static assets sit next to the page in the ag checkout (the page itself is a symlink into it).
const STATIC_DIR = dirname(realpathSync(PAGE));
const STATIC = new Set(["chat-manifest.json", "editor.js", "marked.umd.js", "purify.min.js", "manifest.json", "icon.svg", "icon-180.png", "icon-192.png", "icon-512.png"]);
const UPLOAD_DIR = `${HOME}/inbox/clipboard`;
const INBOX_URL = process.env.AG_INBOX_URL || "http://ag:7373/prompt?new=1"; // the ag inbox: new items land in Inbox
const STT_URL = "https://tfy.promptlens.trilogy.com/audio/transcriptions";
const STT_MODELS = ["whisper-1", "openai-esw/whisper-1"]; // second is the fallback route
const STT_HINT = "tmux, ag, pi, Arcade, arcade.school, Jev, TrueFoundry, Linear, Honeycomb, Hammerspoon, dotfiles, Roblox, TSA, pinned.";
const FAST_LANE_GAP_MS = 60_000; // at most one fast-lane ping per card per minute
const READY = new Set(["idle", "done", "blocked"]);
const WAKE_EVERY_MS = 15 * 60_000;
const WAKE_MAX = 3;
const WAKE_PREFIX = "[AG Dash] Nathan moved this session to Waiting for.";
const WAKE_PROMPT = `${WAKE_PREFIX} Per "Waiting always wakes up" (AGENTS.md → GTD model), schedule your own wake-up with the tickler now, at an interval you choose: a waitingFor item if you're waiting on a person, or when: "check" with a cheap shell check plus expires for a machine or programmatic signal (if it can't be checked programmatically, the woken session checks by computer use). Don't follow up with outside parties without Nathan's OK; draft it for him instead. Then reply in one or two lines: what you're waiting on and when you'll next check. The card stays flagged "no wake-up" on the board until the tickler item exists.`;
const BIG_LINE = 256 * 1024; // tool results this big (screenshots) are summarised by regex, not parsed
const KEYS = new Set(["esc", "enter", "up", "down", "left", "right", "tab", "backspace", "ctrl+u", "y", "n", "1", "2", "3"]);

type CardState = { goneAt?: number /* tab missing since; forgotten after GONE_KEEP_MS */; waiting?: boolean /* marked by hand */; wakeAskedAt?: number; wakeAsks?: number; pinned?: boolean; hot?: boolean; red?: boolean /* older names of pinned */; list?: string; seenAt: number; status?: string; statusSince: number; pingedAt?: number; wasNeedsYou?: boolean };
type List = { id: string; name: string };
type State = { cards: Record<string, CardState>; lists: List[]; areas?: string[] }; // areas: Ag Chat's sidebar order of workspace ids
type Msg = { role: "user" | "assistant"; text: string; ts: number };
type Tool = { id?: string; name: string; detail: string; sum?: string; hosts?: string[]; ts: number; end?: number; error?: boolean };
type Activity = { kind: "thinking" | "tool" | "idle" | "error"; since: number; tool?: string; detail?: string; sum?: string; hosts?: string[]; error?: string };
type Session = {
	mtime: number;
	size: number;
	offset: number;
	cwd?: string;
	startedAt?: number;
	model?: string;
	thinkingLevel?: string;
	first?: string;
	name?: string; // pi session name (latest session_info): a rename that outlives the tab
	lastUser?: Msg;
	lastAssistant?: Msg;
	thinking?: string;
	thinkingTs?: number;
	tools: Tool[];
	toolCount: number;
	turns: number;
	cost: number;
	ctx: number;
	activity: Activity;
	lastAt: number; // newest entry timestamp (file mtimes aren't reliable: migrations copy files)
};

// ---------- state ----------
mkdirSync(STATE_DIR, { recursive: true });
const firstRun = !existsSync(STATE_FILE);
let state: State = { cards: {}, lists: [{ id: "now", name: "Now" }, { id: "next", name: "Next" }, { id: "later", name: "Later" }] };
try {
	state = { ...state, ...JSON.parse(readFileSync(STATE_FILE, "utf8")) };
} catch {}
// "red" became "hotpath" (hot), then "pinned"; carry old flags over.
for (const cs of Object.values(state.cards)) {
	if (cs.red !== undefined) ((cs.hot = cs.red), delete cs.red);
	if (cs.hot !== undefined) ((cs.pinned = cs.hot), delete cs.hot);
}
let dirty = false;
const save = () => {
	if (!dirty) return;
	writeFileSync(`${STATE_FILE}.tmp`, JSON.stringify(state, null, 1));
	renameSync(`${STATE_FILE}.tmp`, STATE_FILE);
	dirty = false;
};

// ---------- helpers ----------
async function run(args: string[]) {
	const p = Bun.spawn(args, { stdout: "pipe", stderr: "pipe" });
	const [out, err, code] = await Promise.all([new Response(p.stdout).text(), new Response(p.stderr).text(), p.exited]);
	return { code, out, err };
}
const mux = (...a: string[]) => run([AG_MUX, ...a]);
const cleanLabel = (s: string) => s.replace(/\s*●\s*$/, "").trim();
const textOf = (content: unknown): string =>
	typeof content === "string"
		? content
		: Array.isArray(content)
			? content
					.filter((c: any) => c?.type === "text")
					.map((c: any) => c.text)
					.join("\n")
			: "";
const oneLine = (s: string, n: number) => {
	const t = String(s ?? "").replace(/\s+/g, " ").trim();
	return t.length > n ? `${t.slice(0, n - 1)}…` : t;
};
// Short human description of a tool call: the command for bash, the path for file tools, else the first string arg.
function toolDetail(name: string, args: any): string {
	if (!args || typeof args !== "object") return "";
	if (typeof args.command === "string") return oneLine(args.command.split("\n")[0], 140);
	for (const k of ["path", "file_path", "url", "query", "sql", "task", "prompt", "text"]) if (typeof args[k] === "string") return oneLine(args[k], 140);
	const first = Object.values(args).find((v) => typeof v === "string") as string | undefined;
	return oneLine(first ?? "", 140);
}
const shortTool = (n: string) => n.replace(/^mcp_/, "").replace(/_/g, " ");
// detail = the raw command/argument; sum = toolsum's summary when every part matched a rule (else absent);
// hosts = machines the call runs on (the session's own machine for local work).
function toolInfo(name: string, args: any, cwd?: string) {
	const r = summarize(name, args, { host: sessionHost(cwd) });
	return { name: shortTool(name), detail: toolDetail(name, args), sum: r.sum, hosts: r.hosts };
}

// ---------- media ----------
// Images/videos mentioned by path in prompts and answers render on the board. Only media files under the home
// folder or /tmp are served (GET /api/file, with Range support so videos seek).
const MEDIA_TYPES: Record<string, string> = { png: "image/png", jpg: "image/jpeg", jpeg: "image/jpeg", gif: "image/gif", webp: "image/webp", svg: "image/svg+xml", heic: "image/heic", mp4: "video/mp4", m4v: "video/mp4", mov: "video/quicktime", webm: "video/webm" };
const MEDIA_ROOTS = [HOME, "/tmp", "/private/tmp", "/private/var/folders", "/var/folders"];
const MEDIA_RE = /(?:~|\/(?:Users|tmp|private|var))[^\s"'`<>()[\]{}|,;]*?\.(png|jpe?g|gif|webp|svg|heic|mp4|m4v|mov|webm)\b/gi;
type Media = { src: string; kind: "image" | "video"; name: string };
const mediaType = (path: string) => MEDIA_TYPES[path.split(".").pop()!.toLowerCase()];
function allowedMedia(raw: string): string | null {
	let path = raw.replace(/^~(?=\/)/, HOME);
	try {
		path = realpathSync(path);
	} catch {
		return null;
	}
	if (!mediaType(path) || !MEDIA_ROOTS.some((r) => path === r || path.startsWith(`${r}/`))) return null;
	try {
		return statSync(path).isFile() ? path : null;
	} catch {
		return null;
	}
}
const mediaCache = new Map<string, Media[]>();
function mediaIn(text?: string): Media[] {
	if (!text) return [];
	const hit = mediaCache.get(text);
	if (hit) return hit;
	const out: Media[] = [];
	const seen = new Set<string>();
	for (const m of text.matchAll(MEDIA_RE)) {
		const path = allowedMedia(m[0].replace(/[.:]+$/, ""));
		if (!path || seen.has(path)) continue;
		seen.add(path);
		out.push({ src: `/api/file?path=${encodeURIComponent(path)}`, kind: mediaType(path).startsWith("video") ? "video" : "image", name: path.split("/").pop()! });
		if (out.length >= 8) break;
	}
	if (mediaCache.size > 500) mediaCache.clear();
	mediaCache.set(text, out);
	return out;
}
function serveFile(path: string, req: Request): Response {
	const file = Bun.file(path);
	const size = file.size;
	// ETag from size+mtime: after max-age the browser revalidates and gets a 304 instead of the whole file again.
	const etag = `"${size.toString(36)}-${Math.floor(file.lastModified).toString(36)}"`;
	const headers: Record<string, string> = { "content-type": mediaType(path), "accept-ranges": "bytes", "cache-control": "private, max-age=300", etag };
	if (req.headers.get("if-none-match") === etag) return new Response(null, { status: 304, headers });
	const range = req.headers.get("range")?.match(/bytes=(\d*)-(\d*)/);
	if (!range) return new Response(file, { headers: { ...headers, "content-length": String(size) } });
	const start = range[1] ? +range[1] : Math.max(0, size - +range[2]);
	const end = range[1] && range[2] ? Math.min(+range[2], size - 1) : range[1] ? size - 1 : size - 1;
	if (start >= size || start > end) return new Response(null, { status: 416, headers: { "content-range": `bytes */${size}` } });
	return new Response(file.slice(start, end + 1), { status: 206, headers: { ...headers, "content-range": `bytes ${start}-${end}/${size}`, "content-length": String(end - start + 1) } });
}
// Session lines, cached briefly, so embedded images (base64 in the session file) can be served one at a time.
const linesCache = new Map<string, { mtime: number; lines: string[] }>();
function sessionLines(path: string): string[] {
	const mtime = statSync(path).mtimeMs;
	const hit = linesCache.get(path);
	if (hit?.mtime === mtime) return hit.lines;
	const lines = readFileSync(path, "utf8").split("\n");
	if (linesCache.size > 4) linesCache.clear();
	linesCache.set(path, { mtime, lines });
	return lines;
}
const imagesOf = (content: unknown) => (Array.isArray(content) ? content.filter((c: any) => c?.type === "image") : []);

function readRange(path: string, start: number, len: number) {
	const fd = openSync(path, "r");
	try {
		const buf = Buffer.alloc(len);
		const n = readSync(fd, buf, 0, len, start);
		return buf.subarray(0, n).toString("utf8");
	} finally {
		closeSync(fd);
	}
}

// Persist a name in the session file as a pi session_info entry, so it outlives the tab (hibernate, close,
// resume) and pi itself, ag find and ag-tab-name (which pins it) all see it. Parented on the last entry so
// the conversation's leaf stays where it was.
function nameSession(file: string, name: string) {
	const size = statSync(file).size;
	const tail = readRange(file, Math.max(0, size - 65536), Math.min(size, 65536));
	let parentId: string | null = null;
	for (const l of tail.trimEnd().split("\n").reverse()) {
		try {
			parentId = JSON.parse(l).id ?? null;
			if (parentId) break;
		} catch {} // a big line cut off at the window's start, or a half-written one
	}
	const entry = { type: "session_info", id: crypto.randomUUID().slice(0, 8), parentId, timestamp: new Date().toISOString(), name };
	appendFileSync(file, (tail && !tail.endsWith("\n") ? "\n" : "") + JSON.stringify(entry) + "\n");
}

// ---------- session parsing ----------
// Session summaries, read incrementally: the first read scans the whole file, later reads only the
// bytes appended since (Pi appends). A file that shrank was rewritten, so it's rescanned.
const sessions = new Map<string, Session>();
const blank = (): Session => ({ mtime: 0, size: 0, offset: 0, tools: [], toolCount: 0, turns: 0, cost: 0, ctx: 0, activity: { kind: "idle", since: 0 }, lastAt: 0 });

function ingest(s: Session, line: string) {
	if (!line) return;
	// Header / settings entries (small).
	if (line.startsWith('{"type":"session"') || line.includes('"session_info"') || line.includes('"type":"model_change"') || line.includes('"type":"thinking_level_change"')) {
		try {
			const e = JSON.parse(line);
			if (e.type === "session") (s.cwd = e.cwd), (s.startedAt = Date.parse(e.timestamp));
			if (e.type === "session_info") s.name = e.name?.trim() || undefined;
			if (e.type === "model_change") s.model = e.modelId;
			if (e.type === "thinking_level_change") s.thinkingLevel = e.thinkingLevel;
		} catch {}
		return;
	}
	if (!line.includes('"type":"message"')) return;
	if (line.includes('"role":"toolResult"')) {
		let id: string | undefined, error = false, ts = 0;
		if (line.length > BIG_LINE) {
			id = line.match(/"toolCallId":"([^"]+)"/)?.[1];
			error = /"isError":true/.test(line);
			ts = Date.parse(line.match(/"timestamp":"([^"]+)"/)?.[1] ?? "") || 0;
		} else {
			try {
				const e = JSON.parse(line);
				(id = e.message.toolCallId), (error = !!e.message.isError), (ts = Date.parse(e.timestamp) || 0);
			} catch {
				return;
			}
		}
		const t = s.tools.find((x) => x.id === id);
		if (t) (t.end = ts), (t.error = error);
		// All tools of the last call finished → the model is thinking again.
		if (!s.tools.some((x) => !x.end)) s.activity = { kind: "thinking", since: ts };
		return;
	}
	let e: any;
	try {
		e = JSON.parse(line);
	} catch {
		return;
	}
	const m = e.message;
	const ts = Date.parse(e.timestamp) || 0;
	if (ts > s.lastAt) s.lastAt = ts;
	if (m?.role === "user") {
		const text = textOf(m.content).trim();
		s.turns++;
		s.activity = { kind: "thinking", since: ts };
		if (text) (s.lastUser = { role: "user", text, ts }), (s.first ??= text);
		return;
	}
	if (m?.role !== "assistant") return;
	if (m.model) s.model = m.model;
	s.cost += m.usage?.cost?.total ?? 0;
	if (m.usage?.totalTokens) s.ctx = m.usage.totalTokens;
	const content: any[] = Array.isArray(m.content) ? m.content : [];
	const thinking = content
		.filter((c) => c.type === "thinking" && c.thinking)
		.map((c) => c.thinking)
		.join("\n")
		.trim();
	if (thinking) (s.thinking = thinking.slice(-1500)), (s.thinkingTs = ts);
	const text = textOf(content).trim();
	if (text) s.lastAssistant = { role: "assistant", text, ts };
	const calls = content.filter((c) => c.type === "toolCall");
	for (const c of calls) {
		s.tools.push({ id: c.id, ...toolInfo(c.name, c.arguments, s.cwd), ts });
		s.toolCount++;
	}
	if (s.tools.length > 12) s.tools.splice(0, s.tools.length - 12);
	if (calls.length) {
		const c = calls[calls.length - 1];
		const t = toolInfo(c.name, c.arguments, s.cwd);
		s.activity = { kind: "tool", since: ts, tool: t.name, detail: t.detail, sum: t.sum, hosts: t.hosts };
	} else if (m.stopReason === "error" || m.stopReason === "aborted") {
		s.activity = { kind: "error", since: ts, error: m.errorMessage || m.stopReason };
	} else {
		s.activity = { kind: "idle", since: ts };
	}
}

function session(path?: string): Session | undefined {
	if (!path) return;
	let st;
	try {
		st = statSync(path);
	} catch {
		return;
	}
	let s = sessions.get(path);
	if (s && s.mtime === st.mtimeMs && s.size === st.size) return s;
	if (!s || st.size < s.offset) s = blank();
	const chunk = readRange(path, s.offset, st.size - s.offset);
	const complete = chunk.lastIndexOf("\n") + 1; // leave a half-written last line for next time
	for (const l of chunk.slice(0, complete).split("\n")) ingest(s, l);
	s.offset += Buffer.byteLength(chunk.slice(0, complete));
	s.mtime = st.mtimeMs;
	s.size = st.size;
	sessions.set(path, s);
	return s;
}

// ---------- sessions by id ----------
const SESSIONS_DIR = `${HOME}/.pi/agent/sessions`;
const SID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;
const sidOf = (file?: string) => file?.match(/_([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\.jsonl$/)?.[1];
const fileBySid = new Map<string, string>();
function sessionFileFor(sid: string): string | undefined {
	const hit = fileBySid.get(sid);
	if (hit && existsSync(hit)) return hit;
	for (const f of new Bun.Glob(`**/*_${sid}.jsonl`).scanSync({ cwd: SESSIONS_DIR, absolute: true })) {
		fileBySid.set(sid, f);
		return f;
	}
}
// Hibernated panes (pi stopped, sleep screen; focusing the pane wakes it): pane, tab, session file.
async function hibernated(): Promise<{ pane: string; tab: string; file: string }[]> {
	const r = await run([`${HOME}/.local/bin/pi-hibernate`, "status"]);
	return r.out
		.split("\n")
		.map((l) => l.trim().split(/\s+/))
		.filter((x) => x.length >= 3 && x[2].endsWith(".jsonl"))
		.map(([pane, tab, file]) => ({ pane, tab, file }));
}
// Any session's file by id: live card, hibernated pane, or the sessions directory.
async function fileForSid(sid: string): Promise<string | undefined> {
	if (!SID_RE.test(sid)) return;
	return board.cards.find((c) => c.sid === sid)?.sessionFile ?? sessionFileFor(sid) ?? (await hibernated()).find((h) => sidOf(h.file) === sid)?.file;
}
let tabLabels: Record<string, string> = {};
type Resolved =
	| { state: "live"; sid: string; tab: string }
	| { state: "hibernated" | "closed"; sid: string; tab?: string; file: string; title: string; workspaceLabel?: string; cwd?: string; startedAt?: number; lastAt: number; model?: string; stats: Card["stats"] };
async function resolveSession(sid: string): Promise<Resolved | null> {
	const live = board.cards.find((c) => c.sid === sid);
	if (live) return { state: "live", sid, tab: live.tab };
	const h = (await hibernated()).find((x) => sidOf(x.file) === sid);
	const file = h?.file ?? sessionFileFor(sid);
	if (!file || !existsSync(file)) return null;
	const s = session(file)!;
	const title = s.name || (h && cleanLabel(tabLabels[h.tab] ?? "")) || oneLine(s.first ?? "(no prompt)", 70);
	const ws = h ? board.workspaces.find((w) => h.tab.startsWith(`${w.id}:`))?.label : undefined;
	return { state: h ? "hibernated" : "closed", sid, tab: h?.tab, file, title, workspaceLabel: ws, cwd: s.cwd, startedAt: s.startedAt, lastAt: s.lastAt || s.mtime, model: s.model, stats: { cost: Math.round(s.cost * 100) / 100, ctx: s.ctx, turns: s.turns, tools: s.toolCount } };
}
async function resumeSession(sid: string, workspace?: string): Promise<string> {
	const r = await resolveSession(sid);
	if (!r) throw new Error("no such session");
	if (r.state === "live") return r.tab;
	if (r.state === "hibernated" && r.tab) {
		await mux("tab", "focus", r.tab); // focusing a hibernated pane wakes it (pi-hibernate daemon)
		return r.tab;
	}
	const ws = workspace ?? board.workspaces.find((w) => w.label.toLowerCase() === "inbox")?.id ?? board.workspaces[0]?.id;
	const cwd = r.cwd && existsSync(r.cwd) ? r.cwd : HOME;
	const t = await mux("tab", "create", "--workspace", ws, "--cwd", cwd, "--no-focus");
	if (t.code !== 0) throw new Error(t.err.trim() || "tab create failed");
	const { tab, root_pane } = JSON.parse(t.out).result;
	await mux("tab", "rename", tab.tab_id, r.title.slice(0, 60)); // its name (or first prompt), not a number
	const a = await mux("agent", "start", `resume-${sid.slice(-8)}`, "--kind", "pi", "--pane", root_pane.pane_id, "--timeout", "30000", "--", "--session", r.file);
	if (a.code !== 0) throw new Error(a.err.trim() || "pi didn't start");
	return tab.tab_id;
}

// Transcript for the drawer: prompts, answers, thinking, tool calls with a short result, and media
// (images embedded in the session, plus image/video files mentioned by path). The newest `limit` items; `more`
// says older ones exist, and the clients ask for a bigger limit as you scroll up (like ChatGPT's history).
function transcript(file: string, ref: string, limit = 150) {
	const lines = sessionLines(file);
	const out: any[] = [];
	const embedded = (line: number, n: number): Media[] => Array.from({ length: n }, (_, k) => ({ src: `/api/embedded?${ref}&line=${line}&idx=${k}`, kind: "image" as const, name: `image ${k + 1}` }));
	const results = new Map<string, { text: string; error: boolean; media: Media[] }>();
	let cwd: string | undefined;
	try {
		cwd = JSON.parse(lines[0]).cwd;
	} catch {}
	let i = lines.length - 1;
	for (; i >= 0 && out.length < limit; i--) {
		const l = lines[i];
		if (!l.includes('"type":"message"')) continue;
		if (l.includes('"role":"toolResult"')) {
			try {
				const e = JSON.parse(l);
				const t = textOf(e.message.content);
				results.set(e.message.toolCallId, { text: t.length > 2500 ? `${t.slice(0, 2500)}\n…` : t, error: !!e.message.isError, media: [...embedded(i, imagesOf(e.message.content).length), ...mediaIn(t)] });
			} catch {}
			continue;
		}
		let e: any;
		try {
			e = JSON.parse(l);
		} catch {
			continue;
		}
		const m = e.message;
		const ts = Date.parse(e.timestamp) || 0;
		const clip = (t: string, n = 8000) => (t.length > n ? `${t.slice(0, n)}\n…` : t);
		if (m.role === "user") {
			const text = textOf(m.content).trim();
			out.push({ role: "user", ts, text: clip(text), media: [...embedded(i, imagesOf(m.content).length), ...mediaIn(text)] });
		} else if (m.role === "assistant") {
			const c: any[] = Array.isArray(m.content) ? m.content : [];
			if (m.stopReason === "error" || m.stopReason === "aborted") out.push({ role: "error", ts, text: m.errorMessage || m.stopReason });
			for (const x of [...c].reverse()) {
				if (x.type === "toolCall") out.push({ role: "tool", ts, ...toolInfo(x.name, x.arguments, cwd), args: clip(JSON.stringify(x.arguments, null, 1), 3000), result: results.get(x.id) });
				else if (x.type === "text" && x.text?.trim()) out.push({ role: "assistant", ts, text: clip(x.text.trim()), media: mediaIn(x.text) });
				else if (x.type === "thinking" && x.thinking?.trim()) out.push({ role: "thinking", ts, text: clip(x.thinking.trim(), 4000) });
			}
		}
	}
	const more = lines.slice(0, i + 1).some((l) => l.includes('"type":"message"') && /"role":"(user|assistant)"/.test(l));
	return { items: out.reverse(), more };
}

// ---------- waiting for (tickler) ----------
const TICKLER_DIR = `${HOME}/.local/state/tickler`;
type Waiting = { id?: string; title: string; kind: "check" | "event" | "online" | "at" | "person" | "manual"; detail: string; since?: number; due?: number };
function ticklerWaits(): Map<string, Waiting[]> {
	const out = new Map<string, Waiting[]>();
	let files: string[] = [];
	try {
		files = readdirSync(TICKLER_DIR).filter((f) => f.endsWith(".json"));
	} catch {
		return out;
	}
	for (const f of files) {
		let i: any;
		try {
			i = JSON.parse(readFileSync(`${TICKLER_DIR}/${f}`, "utf8"));
		} catch {
			continue;
		}
		const sid = sidOf(i.session);
		if (i.status !== "waiting" || !sid) continue;
		if (i.needs_nathan || /^nathan\b/i.test(i.waiting_for ?? "")) continue; // waiting on Nathan = Needs you, not Waiting for
		const due = i.due ? Date.parse(i.due) : undefined;
		const w: Waiting = i.waiting_for
			? { id: i.id, title: i.title, kind: "person", detail: `on ${i.waiting_for}${i.attempt > 1 ? ` (check-in ${i.attempt})` : ""}`, due }
			: i.when === "check"
				? { id: i.id, title: i.title, kind: "check", detail: oneLine(i.check ?? "", 90), due: i.expires ? Date.parse(i.expires) : undefined }
				: i.when === "event"
					? { id: i.id, title: i.title, kind: "event", detail: "webhook / another session", due: i.expires ? Date.parse(i.expires) : undefined }
					: i.when === "online"
						? { id: i.id, title: i.title, kind: "online", detail: "until Nathan is back at his Mac" }
						: { id: i.id, title: i.title, kind: "at", detail: "scheduled", due };
		w.since = Date.parse(i.created_at) || undefined;
		out.set(sid, [...(out.get(sid) ?? []), w]);
	}
	return out;
}

// ---------- board ----------
type Card = {
	tab: string;
	pane: string;
	workspace: string;
	workspaceLabel: string;
	title: string;
	status: string;
	statusSince: number;
	pinned: boolean;
	list?: string;
	needsYou: boolean;
	resolved: boolean;
	throb: boolean; // pinned, not working, not waiting: the red siren runs
	ping: boolean; // pinned and needs you (not waiting): fast lane + page beep
	waiting: Waiting[]; // non-empty: waiting for something (blue orbit, Waiting for column)
	noWake?: { askedAt?: number; asks: number }; // waiting only by hand: no tickler item will wake it yet
	focused: boolean;
	model?: string;
	thinkingLevel?: string;
	cwd?: string;
	startedAt?: number;
	first?: string;
	lastUser?: Msg;
	lastAssistant?: Msg;
	thinking?: string;
	thinkingTs?: number;
	activity?: Activity;
	tools: Tool[];
	media: Media[];
	stats: { cost: number; ctx: number; turns: number; tools: number };
	sessionFile?: string;
	sid?: string;
};
// ---------- system strip: engine memory + ag-mac's computer-use queue ----------
// Memory: /proc/meminfo (used = 1 - MemAvailable/MemTotal) and PSI (/proc/pressure/memory: % of time tasks
// stalled on memory over the last 10 s; "some" = at least one task, "full" = all). Level ok/warn/bad.
type Mem = { usedPct: number; totalGB: number; availGB: number; swapUsedGB: number; swapTotalGB: number; psiSome: number; psiFull: number; level: "ok" | "warn" | "bad" };
function readMem(): Mem | undefined {
	try {
		const kb = Object.fromEntries(readFileSync("/proc/meminfo", "utf8").split("\n").map((l) => l.split(/:\s+/)).filter((p) => p.length === 2).map(([k, v]) => [k, Number.parseInt(v)]));
		let psiSome = 0, psiFull = 0;
		try {
			const psi = readFileSync("/proc/pressure/memory", "utf8");
			// Whole percents: finer values change every poll and would rebroadcast the board each time.
			psiSome = Math.round(Number(psi.match(/^some avg10=([\d.]+)/m)?.[1] ?? 0));
			psiFull = Math.round(Number(psi.match(/^full avg10=([\d.]+)/m)?.[1] ?? 0));
		} catch {}
		const gb = (k: number) => Math.round((k / 1048576) * 10) / 10;
		const usedPct = Math.round((1 - kb.MemAvailable / kb.MemTotal) * 100);
		const swapUsed = (kb.SwapTotal ?? 0) - (kb.SwapFree ?? 0);
		const level = usedPct >= 95 || psiFull >= 5 ? "bad" : usedPct >= 85 || psiSome >= 10 ? "warn" : "ok";
		return { usedPct, totalGB: gb(kb.MemTotal), availGB: gb(kb.MemAvailable), swapUsedGB: gb(swapUsed), swapTotalGB: gb(kb.SwapTotal ?? 0), psiSome, psiFull, level };
	} catch {
		return undefined;
	}
}
// CUA queue: `cua-queue json` on ag-mac over SSH (shared ControlMaster connection), every CUA_POLL_MS in the
// background so a slow or unreachable ag-mac never stalls the board poll.
type CuaJob = { id: string; status: string; caller: string; task: string; urgent: boolean; created?: number; started?: number; finished?: number; rc?: number; pauses: number };
type Cua = { ok: boolean; error?: string; live: CuaJob[]; recent: CuaJob[] };
const CUA_POLL_MS = 5000;
let cua: Cua = { ok: false, error: "not checked yet", live: [], recent: [] };
async function cuaLoop() {
	for (;;) {
		try {
			const p = Bun.spawn(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", "ag-mac", "cua-queue json"], { stdout: "pipe", stderr: "pipe" });
			const timer = setTimeout(() => p.kill(), 15000);
			const [out, err, code] = await Promise.all([new Response(p.stdout).text(), new Response(p.stderr).text(), p.exited]);
			clearTimeout(timer);
			if (code !== 0) throw new Error(err.trim().split("\n").pop() || `exit ${code}`);
			const j = JSON.parse(out);
			cua = { ok: true, live: j.live ?? [], recent: j.recent ?? [] };
		} catch (e) {
			cua = { ...cua, ok: false, error: String((e as Error).message ?? e).slice(0, 200) };
		}
		await Bun.sleep(CUA_POLL_MS);
	}
}
// ---------- routines ----------
// A routine is a recurring job Ag runs on its own (AGENTS.md → "Routines"): every systemd user timer from the ag
// repo on the session host, plus ag-mac's interval LaunchAgents. GET /api/routines lists them with schedule, last
// run, result and next run; a routine may write ~/.local/state/routines/<name>.json ({at, ok, summary, session})
// to say what its last run did. POST /api/routines/run {id} starts an engine routine now; GET /api/routines/log?id=.
type Routine = { id: string; machine: string; name: string; description: string; schedule: string; last?: number; next?: number; running: boolean; result?: string; exit?: number; duration?: number; outcome?: { at?: string; ok?: boolean; summary?: string; session?: string } };
const ROUTINE_STATE = `${HOME}/.local/state/routines`;
const AG_DIR = (() => { try { return dirname(dirname(dirname(dirname(realpathSync(import.meta.path))))); } catch { return `${HOME}/ag`; } })();
const human = (sec: number) => (sec % 86400 === 0 ? `${sec / 86400}d` : sec % 3600 === 0 ? `${sec / 3600}h` : sec % 60 === 0 ? `${sec / 60} min` : `${sec}s`);
const usec = (s: string) => { const m = s.match(/^(\d+(?:\.\d+)?)(us|ms|s|min|h|d)?$/); if (!m) return 0; return Number(m[1]) * ({ us: 1e-6, ms: 1e-3, s: 1, min: 60, h: 3600, d: 86400 } as any)[m[2] ?? "s"]; };
function outcomeOf(name: string) {
	try { return JSON.parse(readFileSync(`${ROUTINE_STATE}/${name}.json`, "utf8")); } catch { return undefined; }
}
async function engineRoutines(): Promise<Routine[]> {
	const lt = await run(["systemctl", "--user", "list-timers", "--all", "--output=json", "--no-pager"]);
	const timers: { unit: string; activates: string; next?: number; last?: number }[] = lt.code === 0 ? JSON.parse(lt.out || "[]") : [];
	if (!timers.length) return [];
	const props = "Id,Description,FragmentPath,TimersMonotonic,TimersCalendar,ActiveState,SubState,Result,ExecMainStatus,ExecMainStartTimestamp,ExecMainExitTimestamp";
	const sh = await run(["systemctl", "--user", "show", "--timestamp=unix", "-p", props, "--no-pager", ...timers.flatMap((t) => [t.unit, t.activates])]);
	const blocks = new Map<string, Record<string, string>>();
	for (const b of sh.out.split("\n\n")) {
		const o: Record<string, string> = {};
		for (const l of b.split("\n")) { const i = l.indexOf("="); if (i > 0) o[l.slice(0, i)] = (o[l.slice(0, i)] ? `${o[l.slice(0, i)]}\n` : "") + l.slice(i + 1); }
		if (o.Id) blocks.set(o.Id, o);
	}
	const ts = (v?: string) => (v?.startsWith("@") ? Number(v.slice(1)) * 1000 : undefined);
	const out: Routine[] = [];
	for (const t of timers) {
		const tm = blocks.get(t.unit) ?? {};
		const sv = blocks.get(t.activates) ?? {};
		if (!(tm.FragmentPath ?? "").startsWith(`${HOME}/.config/systemd/user`)) continue; // only ag's own timers
		const cal = [...(tm.TimersCalendar ?? "").matchAll(/OnCalendar=([^;]+?)\s*;/g)].map((m) => m[1].trim().replace(/^\*-\*-\* (\d\d:\d\d):00( \S+)?$/, "daily $1$2"));
		const mono = [...(tm.TimersMonotonic ?? "").matchAll(/On(UnitActive|UnitInactive)USec=(\S+)/g)].map((m) => `every ${human(usec(m[2]))}`);
		const name = t.unit.replace(/\.timer$/, "");
		const start = ts(sv.ExecMainStartTimestamp), end = ts(sv.ExecMainExitTimestamp);
		const running = sv.ActiveState === "activating" || sv.SubState === "running" || sv.SubState === "start";
		out.push({
			id: `engine:${name}`, machine: "ag-engine", name, description: sv.Description || tm.Description || name,
			schedule: [...cal, ...mono].join(", ") || "—",
			last: t.last ? Math.round(t.last / 1000) : start, next: t.next ? Math.round(t.next / 1000) : undefined, running,
			result: running ? "running" : sv.Result === "success" ? "ok" : sv.Result || undefined, exit: sv.ExecMainStatus ? Number(sv.ExecMainStatus) : undefined,
			duration: start && end && end >= start ? end - start : undefined, outcome: outcomeOf(name),
		});
	}
	return out;
}
// ag-mac: interval LaunchAgents from the repo (schedule + description from the plist), status from launchctl list.
let macRoutines: Routine[] = [];
let macCheckedAt = 0;
async function refreshMacRoutines() {
	if (Date.now() - macCheckedAt < 30_000) return;
	macCheckedAt = Date.now();
	const dir = `${AG_DIR}/macos-launchagents`;
	const defs: Routine[] = [];
	try {
		for (const f of readdirSync(dir)) {
			if (!f.endsWith(".plist")) continue;
			const x = readFileSync(`${dir}/${f}`, "utf8");
			const iv = x.match(/<key>StartInterval<\/key>\s*<integer>(\d+)<\/integer>/)?.[1];
			const cal = /<key>StartCalendarInterval<\/key>/.test(x);
			if (!iv && !cal) continue;
			// Host-only agents ("machine-role host || exit 0") are inert on ag-mac now that the engine hosts sessions;
			// their engine timers are listed instead.
			if (/machine-role"? host \|\||machine-role[^<]*\)" = host \]/.test(x)) continue;
			const label = f.replace(/\.plist$/, "");
			const desc = x.match(/<!--\s*([\s\S]*?)\s*-->/)?.[1]?.replace(/\s+/g, " ") ?? label;
			defs.push({ id: `mac:${label}`, machine: "ag-mac", name: label.replace(/^com\.nathan\./, ""), description: desc, schedule: iv ? `every ${human(Number(iv))}` : "calendar", running: false });
		}
		const p = Bun.spawn(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", "ag-mac", "launchctl list"], { stdout: "pipe", stderr: "pipe" });
		const timer = setTimeout(() => p.kill(), 10000);
		const outText = await new Response(p.stdout).text();
		clearTimeout(timer);
		const st = new Map(outText.split("\n").map((l) => l.split("\t")).filter((c) => c.length === 3).map(([pid, code, label]) => [label, { pid, code }]));
		for (const d of defs) {
			const s = st.get(d.id.slice(4));
			if (!s) { d.result = "not loaded"; continue; }
			d.running = s.pid !== "-";
			d.exit = Number(s.code);
			d.result = d.running ? "running" : d.exit === 0 ? "ok" : `exit ${d.exit}`;
		}
		macRoutines = defs;
	} catch {}
}
async function routinesJson() {
	void refreshMacRoutines();
	return { now: Date.now(), routines: [...(await engineRoutines()), ...macRoutines] };
}

type Sys = { mem?: Mem; cua: Cua };

let board: { cards: Card[]; lists: List[]; areas?: string[]; workspaces: { id: string; label: string }[]; page: number; sys?: Sys } = { cards: [], lists: state.lists, workspaces: [], page: 0 };
let boardJson = "";
const cardKey = new Map<string, string>(); // tab id → board state key (pi session id, else tab id)
// SSE senders, one per open page. The client Mac reaches ag through a Tailscale relay (~4 Mbps), so each stream is
// gzipped and flushed per message: the ~400 KB board goes out as ~40 KB.
const clients = new Set<(msg: string) => void>();
// Updates after the first go out as a named "delta" event: cards unchanged since the last broadcast are sent as
// {tab, same: 1} and the page reuses its copy (usually only the few working cards change: ~126 KB → a few KB).
// A new page version goes out whole, as a plain message, so pages too old to know deltas still see it and reload.
let cardJson = new Map<string, string>();
let lastPage = 0;
const broadcast = () => {
	const next = new Map(board.cards.map((c) => [c.tab, JSON.stringify(c)]));
	const full = board.page !== lastPage;
	const msg = full ? `data: ${boardJson}\n\n` : `event: delta\ndata: ${JSON.stringify({ ...board, cards: board.cards.map((c) => (cardJson.get(c.tab) === next.get(c.tab) ? { tab: c.tab, same: 1 } : c)) })}\n\n`;
	cardJson = next;
	lastPage = board.page;
	for (const send of clients) {
		try {
			send(msg);
		} catch {
			clients.delete(send);
		}
	}
};
// Gzip a response body when the browser accepts it (the relay makes bytes the bottleneck, not CPU).
const gzipped = (req: Request, body: string | Uint8Array, headers: Record<string, string>, status = 200) =>
	(req.headers.get("accept-encoding") ?? "").includes("gzip") && body.length > 1024
		? new Response(Bun.gzipSync(typeof body === "string" ? Buffer.from(body) : body, { level: 5 }), { status, headers: { ...headers, "content-encoding": "gzip", vary: "accept-encoding" } })
		: new Response(body, { status, headers });
const jsonRes = (req: Request, v: unknown) => gzipped(req, typeof v === "string" ? v : JSON.stringify(v), { "content-type": "application/json", "cache-control": "no-store" });
const pageRes = (req: Request, page = PAGE) => gzipped(req, readFileSync(page), { "content-type": "text/html; charset=utf-8", "cache-control": "no-store" });

function fastLane(card: Card) {
	const snippet = (card.status === "blocked" ? "is blocked and needs you" : "is ready") + (card.lastAssistant ? `: ${oneLine(card.lastAssistant.text, 160)}` : "");
	void run([AG_TEXT, `Pinned: ${card.title} (${card.workspaceLabel}) ${snippet}\n${card.sid ? `http://ag:${PORT}/${card.sid}` : `${HTTPS_URL}/#${card.tab}`}`]);
	void mux("notification", "show", `Pinned: ${card.title}`, "--body", snippet.slice(0, 120), "--sound", "request");
	console.log(new Date().toISOString(), "fast-lane", card.tab, card.title);
}

// One line for an alert: the reply's question if it asks one, else its opening paragraph (cards keep only the
// last 3000 chars, so at that length the first paragraph is probably cut and the next one is used).
function gist(text: string) {
	const paras = text.replace(/\s*\bDONE\s*$/, "").split(/\n\s*\n/).filter((x) => x.trim());
	return (paras.findLast((x) => /\?\s*$/.test(x)) ?? paras[text.length >= 3000 && paras.length > 1 ? 1 : 0] ?? "").replace(/[*`]/g, "");
}

async function poll() {
	const r = await mux("api", "snapshot");
	if (r.code !== 0) return;
	const snap = JSON.parse(r.out).result.snapshot;
	const now = Date.now();
	const wsLabel: Record<string, string> = Object.fromEntries(snap.workspaces.map((w: any) => [w.workspace_id, w.label]));
	const tabs: Record<string, any> = Object.fromEntries(snap.tabs.map((t: any) => [t.tab_id, t]));
	tabLabels = Object.fromEntries(snap.tabs.map((t: any) => [t.tab_id, t.label]));
	const cards: Card[] = [];
	const seenTabs = new Set<string>();
	const keys = new Set<string>(); // state keys still alive this poll
	const waits = ticklerWaits();
	// Panes ag-mux restored asleep (`ag-mux _sleep`; pi starts when the tab is viewed) have no agent yet: show
	// them as idle cards for their session, so a restore or host move doesn't empty the board.
	const awake = new Set(snap.agents.map((a: any) => a.pane_id));
	const sleepers = (snap.panes ?? [])
		.filter((p: any) => p.sleeping_session && !awake.has(p.pane_id))
		.map((p: any) => ({ ...p, agent: "pi", agent_status: "idle", agent_session: { agent: "pi", kind: "path", value: p.sleeping_session } }));
	for (const a of [...snap.agents, ...sleepers]) {
		if (seenTabs.has(a.tab_id)) continue; // one card per tab (first agent pane)
		seenTabs.add(a.tab_id);
		const s = session(a.agent_session?.value);
		// Board state is keyed by the pi session id (stable) rather than the tab id, which changes when the Inbox
		// auto-filer moves a tab; tabs without a session fall back to the tab id. Older tab-keyed entries migrate.
		const key = sidOf(a.agent_session?.value) ?? a.tab_id;
		keys.add(key);
		if (key !== a.tab_id && state.cards[a.tab_id] && !state.cards[key]) ((state.cards[key] = state.cards[a.tab_id]), delete state.cards[a.tab_id], (dirty = true));
		cardKey.set(a.tab_id, key);
		let cs = state.cards[key];
		if (!cs) {
			// First sight. On the board's very first run, treat existing sessions as already seen (clean slate).
			cs = state.cards[key] = { seenAt: firstRun ? now : 0, status: a.agent_status, statusSince: firstRun ? s?.lastAt || now : now };
			dirty = true;
		}
		if (cs.status !== a.agent_status) {
			cs.status = a.agent_status;
			cs.statusSince = now;
			dirty = true;
		}
		const ready = READY.has(a.agent_status);
		const focused = snap.focused_tab_id === a.tab_id;
		if (focused && ready && (s?.lastAssistant?.ts ?? 0) > cs.seenAt) {
			cs.seenAt = now; // he's looking at it in tmux
			dirty = true;
		}
		const sid = sidOf(a.agent_session?.value);
		const tick = (sid && waits.get(sid)) || [];
		if (cs.waiting) {
			// The tickler item takes over from a hand-set wait; new work (a prompt that isn't our wake-up ask) ends it.
			const lu = s?.lastUser;
			const newWork = lu && lu.ts > (cs.wakeAskedAt ?? 0) + 2000 && !/^\[(AG Dash|ag board)\] Nathan moved this session to Waiting for\./.test(lu.text) && cs.wakeAskedAt;
			if (tick.length || newWork) {
				delete cs.waiting, delete cs.wakeAskedAt, delete cs.wakeAsks;
				dirty = true;
			} else if (ready && a.agent_status !== "blocked" && (cs.wakeAsks ?? 0) < WAKE_MAX && now - (cs.wakeAskedAt ?? 0) > WAKE_EVERY_MS) {
				cs.wakeAskedAt = now;
				cs.wakeAsks = (cs.wakeAsks ?? 0) + 1;
				dirty = true;
				void mux("agent", "prompt", a.pane_id, WAKE_PROMPT).then((r) => console.log(new Date().toISOString(), "wake-up ask", a.tab_id, r.code === 0 ? "sent" : r.err.trim()));
			}
		}
		const waiting: Waiting[] = a.agent_status === "working" ? [] : [...tick, ...(cs.waiting ? [{ title: "Marked waiting", kind: "manual" as const, detail: "asked the session to schedule its wake-up" }] : [])];
		const isWaiting = waiting.length > 0 && a.agent_status !== "blocked";
		const needsYou = a.agent_status === "blocked" || (!isWaiting && ready && (s?.lastAssistant?.ts ?? 0) > cs.seenAt);
		const resolved = ready && /(^|\n)\s*DONE\s*$/.test(s?.lastAssistant?.text ?? "");
		const card: Card = {
			tab: a.tab_id,
			pane: a.pane_id,
			workspace: a.workspace_id,
			workspaceLabel: wsLabel[a.workspace_id] ?? a.workspace_id,
			title: cleanLabel(tabs[a.tab_id]?.label ?? a.name ?? a.tab_id),
			status: a.agent_status,
			statusSince: cs.statusSince,
			pinned: !!cs.pinned,
			list: cs.list,
			needsYou,
			resolved,
			throb: !!cs.pinned && a.agent_status !== "working" && !isWaiting,
			ping: !!cs.pinned && needsYou,
			waiting: isWaiting ? waiting : [],
			noWake: cs.waiting && !tick.length ? { askedAt: cs.wakeAskedAt, asks: cs.wakeAsks ?? 0 } : undefined,
			focused,
			model: s?.model,
			thinkingLevel: s?.thinkingLevel,
			cwd: s?.cwd ?? a.cwd,
			startedAt: s?.startedAt,
			first: s?.first?.slice(0, 600),
			lastUser: s?.lastUser && { ...s.lastUser, text: s.lastUser.text.slice(0, 1500) },
			lastAssistant: s?.lastAssistant && { ...s.lastAssistant, text: s.lastAssistant.text.slice(-3000) },
			thinking: s?.thinking?.slice(-600),
			thinkingTs: s?.thinkingTs,
			activity: s?.activity,
			tools: (s?.tools ?? []).slice(-6).map(({ id: _, ...t }) => t),
			media: [...new Map([...mediaIn(s?.lastAssistant?.text), ...mediaIn(s?.lastUser?.text)].map((m) => [m.src, m])).values()].slice(0, 6),
			stats: { cost: Math.round((s?.cost ?? 0) * 100) / 100, ctx: s?.ctx ?? 0, turns: s?.turns ?? 0, tools: s?.toolCount ?? 0 },
			sessionFile: a.agent_session?.value,
			sid,
		};
		if (card.ping && !cs.wasNeedsYou && now - (cs.pingedAt ?? 0) > FAST_LANE_GAP_MS) {
			cs.pingedAt = now;
			fastLane(card);
		}
		if (cs.wasNeedsYou !== needsYou) {
			cs.wasNeedsYou = needsYou;
			dirty = true;
		}
		cards.push(card);
	}
	// Forget cards whose tabs have been gone a week. Not at once: a stopped session layer or a host move
	// briefly shows no agents, and forgetting right away wiped every pin and list on 2026-09-29.
	for (const [id, cs] of Object.entries(state.cards)) {
		if (keys.has(id)) {
			if (cs.goneAt) (delete cs.goneAt, (dirty = true));
		} else if (!cs.goneAt) (cs.goneAt = now), (dirty = true);
		else if (now - cs.goneAt > GONE_KEEP_MS) (delete state.cards[id], (dirty = true));
	}
	save();
	// page: the served index.html's mtime, so open tabs (desktop and the phone PWA) reload themselves onto a new
	// version instead of rendering with stale code until someone refreshes by hand.
	let page = 0;
	try {
		page = statSync(realpathSync(PAGE)).mtimeMs;
	} catch {}
	board = { cards, lists: state.lists, areas: state.areas ?? [], workspaces: snap.workspaces.map((w: any) => ({ id: w.workspace_id, label: w.label })), page, sys: { mem: readMem(), cua } };
	expireMeta(cards, now);
	const json = JSON.stringify(board);
	if (json !== boardJson) {
		boardJson = json;
		broadcast();
	}
}

async function loop() {
	for (;;) {
		try {
			await poll();
		} catch (e) {
			console.error(new Date().toISOString(), "poll failed", e);
		}
		await Bun.sleep(POLL_MS);
	}
}

const markSeen = (tab: string) => {
	const cs = state.cards[cardKey.get(tab) ?? tab];
	if (cs) (cs.seenAt = Date.now()), (dirty = true);
};

// ---------- voice / uploads / new sessions ----------
function tfyToken(): string {
	if (process.env.TFY_TOKEN) return process.env.TFY_TOKEN;
	const m = readFileSync(`${HOME}/.zshenv.local`, "utf8").match(/TFY_TOKEN=["']?([^"'\s]+)/);
	if (!m) throw new Error("TFY_TOKEN not found in ~/.zshenv.local");
	return m[1];
}
async function transcribe(file: File): Promise<string> {
	let last: unknown;
	for (const model of STT_MODELS) {
		try {
			const body = new FormData();
			body.set("model", model);
			body.set("prompt", STT_HINT);
			body.set("file", file, file.name || "voice.webm");
			const res = await fetch(STT_URL, { method: "POST", headers: { authorization: `Bearer ${tfyToken()}` }, body, signal: AbortSignal.timeout(60_000) });
			if (!res.ok) throw new Error(`stt ${model} ${res.status}: ${await res.text()}`);
			return String((await res.json()).text ?? "").trim();
		} catch (e) {
			last = e;
		}
	}
	throw last;
}
async function saveUpload(f: File): Promise<string> {
	mkdirSync(UPLOAD_DIR, { recursive: true });
	const safe = (f.name || "paste").replace(/[^\w.-]+/g, "_").slice(-60);
	const path = `${UPLOAD_DIR}/${new Date().toISOString().replace(/[:.]/g, "-").slice(0, 19)}-board-${safe}`;
	writeFileSync(path, Buffer.from(await f.arrayBuffer()));
	return path;
}
// New item: handed to the ag inbox (?new=1: always a new session in Inbox; it names the tab). With a recording
// the inbox answers at once and transcribes in the background; text alone waits until pi has it and returns the tab.
// What the New item box is for, by Jev (~250 ms): find an existing session, housekeeping on sessions (meta), or
// work for an agent (new or a follow-up; the inbox tells those apart). Tested on ~20 phrasings, all routed right:
// "where's the session about X", "the roblox launch triage one" → find; "pin the roblox ones", "close
// all the fix ag access tabs", "pull up all the faction sessions", "what's waiting on me", "merge …", "move … into
// Dev Setup" → meta; tasks and research → new; "any update on X?" → follow. A bare topic word leans new.
// Any error → "new".
const JEV_URL = "https://tfy.promptlens.trilogy.com/proxy-api/jev-account/jev-endpoint/v1/systemone";
async function newIntent(text: string): Promise<"find" | "meta" | "new"> {
	try {
		const res = await fetch(JEV_URL, {
			method: "POST",
			headers: { authorization: `Bearer ${tfyToken()}`, "content-type": "application/json" },
			body: JSON.stringify({
				model: "jev-latest",
				state: { message: text.slice(0, 8000) },
				questions: {
					intent: {
						type: "choice",
						instructions: "Nathan typed `message` into the New item box of his AI agent dashboard, where every card is an agent session (a task or conversation). What does he want?",
						criteria: {
							find: "He wants to locate and open one existing session or card: where is it, which one was it, show me / open the session about X, or just a short phrase naming a past topic or session (e.g. 'the roblox launch triage one', 'that thing about kids betting'). He wants it surfaced, not new work done.",
							meta: "Housekeeping on his sessions or the dashboard itself, not real work: pin or unpin sessions, close/archive, rename, move or file them to a workspace, mark waiting, merge sessions, pull up or gather several sessions (e.g. 'all the roblox ones'), or list which sessions need him or are stuck.",
							follow: "He asks for a status update on, or adds information or instructions to, work that is already going (e.g. 'any update on X?', 'also make X do Y', 'X is fixed now'). An agent should continue that work.",
							new: "He asks an agent to do a new task, research something, or answer a question: start new work.",
						},
					},
				},
			}),
			signal: AbortSignal.timeout(10_000),
		});
		if (!res.ok) throw new Error(`jev ${res.status}: ${await res.text()}`);
		const c = (await res.json()).answers.intent.choice;
		return c === "find" || c === "meta" ? c : "new";
	} catch (e) {
		console.error(new Date().toISOString(), "new item routing failed", e);
		return "new";
	}
}
// Meta: housekeeping requests ("pin the roblox ones", "close the TSA sessions") get a short-lived session
// in the Meta workspace, done with the `ag` CLI. Meta cards hang around briefly: META_KEEP_MS after one finishes
// (its answer ends with DONE) it closes itself, unless it's pinned, waiting, or focused in tmux.
const META_WS = "Meta";
const META_KEEP_MS = 10 * 60_000;
const metaClosing = new Set<string>();
async function metaItem(text: string): Promise<string> {
	const json = (r: { code: number; out: string; err: string }, what: string) => {
		if (r.code !== 0) throw new Error(r.err.trim() || `${what} failed`);
		return r.out.trim() ? JSON.parse(r.out).result : null;
	};
	const label = oneLine(text, 40);
	const ws = json(await mux("workspace", "list"), "workspace list").workspaces.find((w: any) => w.label === META_WS)?.workspace_id;
	// A new workspace comes with a tab; use it rather than leaving an empty shell beside the session.
	const t = ws
		? json(await mux("tab", "create", "--workspace", ws, "--cwd", HOME, "--label", label, "--no-focus"), "tab create")
		: json(await mux("workspace", "create", "--cwd", HOME, "--label", META_WS, "--no-focus"), "workspace create");
	const tab = t.tab.tab_id, pane = t.root_pane.pane_id;
	if (!ws) await mux("tab", "rename", tab, label);
	const prompt = `[Meta] From AG Dash's New item box, Nathan asked for housekeeping on his sessions or the dashboard:\n\n${text}\n\n---\nDo it with the \`ag\` CLI (\`ag help\`: ls, find, search, pin, close, rename, file, wait/unwait, merge, link, send, peek, read). This isn't real work: don't start tasks inside other sessions beyond what he asked. Be quick. Reply in a line or two with what you did and the AG Dash links (\`ag link\`), then DONE. This tab lives in the ${META_WS} workspace and closes itself ${META_KEEP_MS / 60_000} minutes after you finish; if you need his answer, ask and leave off DONE.`;
	try {
		json(await mux("agent", "start", `meta-${crypto.randomUUID().slice(0, 6)}`, "--kind", "pi", "--pane", pane, "--timeout", "30000"), "agent start");
		json(await mux("agent", "prompt", pane, prompt), "agent prompt");
	} catch (e) {
		await mux("tab", "close", tab);
		throw e;
	}
	return tab;
}
function expireMeta(cards: Card[], now: number) {
	for (const c of cards) {
		if (c.workspaceLabel !== META_WS || !c.resolved || c.pinned || c.focused || c.waiting.length || metaClosing.has(c.tab)) continue;
		if (now - c.statusSince < META_KEEP_MS) continue;
		metaClosing.add(c.tab);
		console.log(new Date().toISOString(), "meta: closing finished", c.tab, c.title);
		void mux("tab", "close", c.tab).then((r) => {
			if (r.code !== 0) console.error(new Date().toISOString(), "meta close failed", c.tab, r.err);
			setTimeout(() => metaClosing.delete(c.tab), 60_000);
		});
	}
}
async function newItem(text: string, audio: File | null): Promise<string | null> {
	if (!audio) {
		const r = await fetch(INBOX_URL, { method: "POST", headers: { "content-type": "text/plain" }, body: text, signal: AbortSignal.timeout(90_000) });
		if (!r.ok) throw new Error((await r.text()).trim() || `inbox ${r.status}`);
		return (await r.json()).tab ?? null;
	}
	const fd = new FormData();
	fd.set("audio", audio, audio.name || "voice.webm");
	if (text) fd.set("text", text);
	const r = await fetch(INBOX_URL, { method: "POST", body: fd, redirect: "manual", signal: AbortSignal.timeout(30_000) });
	if (r.status >= 400) throw new Error((await r.text()).trim() || `inbox ${r.status}`);
	return null;
}
// Dictated reply: answered at once; transcribed here in the background, then sent (typed text first). If
// transcription fails the recording isn't lost: the agent gets its path.
async function sendDictation(pane: string, typed: string, audio: File, interruptFirst: boolean) {
	const path = await saveUpload(new File([audio], audio.name || "voice.webm", { type: audio.type }));
	void (async () => {
		let text: string;
		try {
			const said = await transcribe(audio);
			text = [typed, said].filter(Boolean).join("\n\n");
			if (!text) return;
		} catch (e) {
			console.error(new Date().toISOString(), "dictation stt failed", e);
			text = [typed, `I sent a voice recording but transcription failed. Transcribe it (e.g. Whisper via TrueFoundry) and do what it says:\n${path}`].filter(Boolean).join("\n\n");
		}
		const r = interruptFirst ? await interruptAndSend(pane, text) : await mux("agent", "prompt", pane, text);
		if (r.code !== 0) console.error(new Date().toISOString(), "dictation prompt failed", r.err);
		void after();
	})();
}

// ---------- control ----------
const keys = async (pane: string, ...ks: string[]) => {
	for (const k of ks) {
		const r = await mux("agent", "send-keys", pane, k);
		if (r.code !== 0) return r;
		await Bun.sleep(60);
	}
	return { code: 0, out: "", err: "" };
};
async function interrupt(pane: string) {
	const r = await keys(pane, "esc");
	await Bun.sleep(250);
	return r.code === 0 ? keys(pane, "esc") : r;
}
// Interrupt, wait until the agent is at its prompt, clear whatever Pi put back in the editor, then send.
async function interruptAndSend(pane: string, text: string) {
	await interrupt(pane);
	await mux("agent", "wait", pane, "--until", "idle", "--until", "done", "--timeout", "20000");
	for (let i = 0; i < 8; i++) await keys(pane, "ctrl+u", "backspace");
	return mux("agent", "prompt", pane, text);
}

// ---------- server ----------
const host = execFileSync("/usr/local/bin/tailscale", ["ip", "-4"], { encoding: "utf8" }).trim().split("\n")[0];
const ok = () => Response.json({ ok: true });

// Clicks per control (optionally only the last `days` days), most used first, split by view.
function clickStats(days: number) {
	const since = days > 0 ? Date.now() - days * 86_400_000 : 0;
	const by = new Map<string, { name: string; total: number; desktop: number; phone: number; last: number }>();
	let lines: string[] = [];
	try {
		lines = readFileSync(CLICKS_FILE, "utf8").split("\n");
	} catch {}
	let total = 0;
	for (const l of lines) {
		let e: any;
		try {
			e = JSON.parse(l);
		} catch {
			continue;
		}
		if (!e?.name || e.ts < since) continue;
		const s = by.get(e.name) ?? { name: e.name, total: 0, desktop: 0, phone: 0, last: 0 };
		s.total++, total++;
		s[e.view === "phone" ? "phone" : "desktop"]++;
		s.last = Math.max(s.last, e.ts);
		by.set(e.name, s);
	}
	return { since: since || null, total, controls: [...by.values()].sort((a, b) => b.total - a.total) };
}
const bad = (msg: string, status = 400) => Response.json({ ok: false, error: msg }, { status });
const after = async () => {
	save();
	await poll();
};

const gz = new Map<string, { mtime: number; body: Uint8Array }>();
function staticFile(name: string, req: Request) {
	const path = `${STATIC_DIR}/${name}`;
	const st = statSync(path);
	const type = name.endsWith(".js") ? "text/javascript" : name.endsWith(".svg") ? "image/svg+xml" : name.endsWith(".png") ? "image/png" : "application/manifest+json";
	const etag = `"${st.mtimeMs.toString(36)}"`;
	if (req.headers.get("if-none-match") === etag) return new Response(null, { status: 304 });
	const headers: Record<string, string> = { "content-type": type, etag, "cache-control": "no-cache" };
	if (!(req.headers.get("accept-encoding") ?? "").includes("gzip")) return new Response(Bun.file(path), { headers });
	let hit = gz.get(path);
	if (!hit || hit.mtime !== st.mtimeMs) gz.set(path, (hit = { mtime: st.mtimeMs, body: Bun.gzipSync(readFileSync(path)) }));
	return new Response(hit.body, { headers: { ...headers, "content-encoding": "gzip" } });
}

async function handle(req: Request): Promise<Response> {
		const url = new URL(req.url);
		const p = url.pathname;
		if (req.method === "GET") {
			if (p === "/") return pageRes(req);
			// Chat view: /chat, /chat/<session id>, /chat/t/<tab> (the page routes itself).
			if (/^\/chat(?:\/(?:[0-9a-f-]{36}|[tp]\/[^/]+))?\/?$/.test(p)) return pageRes(req, CHAT_PAGE);
			const sf = p.match(/^\/static\/([\w.-]+)$/)?.[1];
			if (sf && STATIC.has(sf)) return staticFile(sf, req);
			if (p === "/api/file") {
				const path = allowedMedia(url.searchParams.get("path") ?? "");
				return path ? serveFile(path, req) : bad("not an allowed media file", 404);
			}
			if (p === "/api/embedded") {
				const sid = url.searchParams.get("sid");
				const file = sid ? await fileForSid(sid) : board.cards.find((c) => c.tab === url.searchParams.get("tab"))?.sessionFile;
				if (!file) return bad("no such session", 404);
				try {
					const e = JSON.parse(sessionLines(file)[Number(url.searchParams.get("line"))] ?? "");
					const img: any = imagesOf(e.message?.content)[Number(url.searchParams.get("idx") ?? 0)];
					if (!img?.data) return bad("no such image", 404);
					return new Response(Buffer.from(img.data, "base64"), { headers: { "content-type": img.mimeType || "image/png", "cache-control": "private, max-age=3600" } });
				} catch {
					return bad("no such image", 404);
				}
			}
			if (p === "/api/config") return Response.json({ httpsUrl: HTTPS_URL, home: HOME, fileInbox: `http://${AG_FQDN}:7374`, models: piModels() });
			if (p === "/api/stats") return Response.json(clickStats(Number(url.searchParams.get("days")) || 0));
			if (p === "/api/state") return jsonRes(req, boardJson);
			// Stalled pinned cards (siren running), for the client's persistent desktop alerts (hammerspoon ag_pinned.lua).
			if (p === "/api/pinned")
				return Response.json(
					board.cards
						.filter((c) => c.throb)
						.map((c) => ({
							tab: c.tab,
							title: c.title,
							workspace: c.workspaceLabel,
							status: c.status,
							since: c.statusSince,
							body: (c.status === "blocked" ? "Blocked, needs you" : c.needsYou ? "Ready" : "Stalled") + (c.lastAssistant ? `: ${oneLine(gist(c.lastAssistant.text), 160)}` : ""),
							url: c.sid ? `http://ag:${PORT}/${c.sid}` : `${HTTPS_URL}/#${c.tab}`,
						})),
				);
			if (p === "/api/routines") return Response.json(await routinesJson());
			if (p === "/api/upcoming") return Response.json(upcoming());
			if (p === "/api/archived") {
				// Ag Chat's Archived chats: recently closed sessions (`ag find --closed`).
				const days = Math.min(90, Number(url.searchParams.get("days")) || 14);
				const r = await run([`${HOME}/.local/bin/ag`, "find", "--closed", "--json", "--days", String(days), "--limit", "200"]);
				if (r.code !== 0) return bad(r.err.trim() || "ag find failed", 502);
				return new Response(r.out, { headers: { "content-type": "application/json" } });
			}
			if (p === "/api/routines/log") {
				const id = url.searchParams.get("id") ?? "";
				if (!/^engine:[\w.@-]+$/.test(id)) return bad("engine routines only");
				const r = await run(["journalctl", "--user", "-u", `${id.slice(7)}.service`, "-n", "60", "--no-pager", "-o", "short-iso"]);
				return new Response(r.out || r.err, { headers: { "content-type": "text/plain; charset=utf-8" } });
			}
			if (p === "/api/transcript") {
				const sid = url.searchParams.get("sid");
				const file = sid ? await fileForSid(sid) : board.cards.find((c) => c.tab === url.searchParams.get("tab"))?.sessionFile;
				// No file yet (or gone): an empty transcript, never an error the drawer would hang on.
				if (!file || !existsSync(file)) return Response.json([]);
				const limit = Math.min(Math.max(Number(url.searchParams.get("limit")) || 150, 1), 100_000);
				const t = transcript(file, sid ? `sid=${sid}` : `tab=${encodeURIComponent(url.searchParams.get("tab")!)}`, limit);
				const res = jsonRes(req, t.items);
				res.headers.set("x-more", t.more ? "1" : "0");
				return res;
			}
			const sp = p.match(/^\/api\/session\/([0-9a-f-]{36})$/)?.[1];
			if (sp) {
				const r = SID_RE.test(sp) ? await resolveSession(sp) : null;
				return r ? jsonRes(req, r) : bad("no such session", 404);
			}
			// Page URLs (the page routes itself; back/forward walk through them): /<session id>[/live], /t/<tab>[/live],
			// /state|lists|workspaces[/<column>], /routines, /new, /help.
			if (SID_RE.test(p.slice(1).replace(/\/live$/, "")) || /^\/(?:(?:state|lists|workspaces)(?:\/[^/]+)?|routines|new|help|t\/[^/]+(?:\/live)?)\/?$/.test(p)) return pageRes(req);
			if (p === "/api/screen") {
				const card = board.cards.find((c) => c.tab === url.searchParams.get("tab"));
				if (!card) return bad("no such card", 404);
				const r = await mux("agent", "read", card.pane, "--source", "visible", "--lines", "120");
				return new Response(r.code === 0 ? r.out : r.err, { status: r.code === 0 ? 200 : 409, headers: { "content-type": "text/plain; charset=utf-8" } });
			}
			if (p === "/events") {
				const gz = (req.headers.get("accept-encoding") ?? "").includes("gzip");
				let send: (msg: string) => void;
				let ping: Timer;
				const z = gz ? createGzip({ level: 5 }) : null;
				const stop = () => (clients.delete(send), clearInterval(ping), z?.destroy());
				return new Response(
					new ReadableStream({
						start(c) {
							if (z) {
								z.on("data", (chunk: Buffer) => {
									try {
										c.enqueue(new Uint8Array(chunk));
									} catch {
										stop();
									}
								});
								// Sync-flush after every message so the browser gets it now, not when the gzip buffer fills.
								send = (msg) => (z.write(msg), z.flush(zc.Z_SYNC_FLUSH));
							} else send = (msg) => c.enqueue(msg);
							clients.add(send);
							send(`data: ${boardJson}\n\n`);
							ping = setInterval(() => {
								try {
									send(": ping\n\n");
								} catch {
									stop();
								}
							}, 20_000);
						},
						cancel: stop,
					}),
					{ headers: { "content-type": "text/event-stream", "cache-control": "no-store", connection: "keep-alive", ...(gz ? { "content-encoding": "gzip", vary: "accept-encoding" } : {}) } },
				);
			}
			return bad("not found", 404);
		}
		if (req.method !== "POST") return bad("not found", 404);
		// Multipart endpoints first (voice, files).
		if (p === "/api/new") {
			const fd = await req.formData().catch(() => null);
			const text = String(fd?.get("text") ?? "").trim();
			const a = fd?.get("audio");
			const audio = a instanceof File && a.size ? a : null;
			if (!text && !audio) return bad("say or type something");
			try {
				// Route first: looking for an existing session ("find" → the page runs /api/search and shows the
				// cards); otherwise a new item for the ag inbox (which still routes follow-ups into their session).
				// A recording is transcribed here so it can be routed; if that fails the inbox gets the audio as before.
				let said = text, rec = audio;
				if (audio) {
					try {
						said = [text, await transcribe(audio)].filter(Boolean).join("\n\n");
						rec = null;
					} catch (e) {
						console.error(new Date().toISOString(), "new item stt failed", e);
					}
				}
				const intent = fd?.get("route") !== "new" && !rec && said ? await newIntent(said) : "new";
				if (intent === "find") return Response.json({ ok: true, kind: "find", q: said });
				if (intent === "meta") {
					const tab = await metaItem(said);
					void after();
					return Response.json({ ok: true, kind: "meta", tab });
				}
				const tab = await newItem(said, rec);
				// Chat view: "new chat in <project>" files the new Inbox session into that workspace.
				const ws = String(fd?.get("workspace") ?? "");
				if (tab && ws && board.workspaces.some((w: any) => w.id === ws)) await run([`${HOME}/.local/bin/ag`, "file", ws, tab]);
				void after();
				return Response.json({ ok: true, kind: "new", tab });
			} catch (e: any) {
				return bad(String(e?.message ?? e), 502);
			}
		}
		if (p === "/api/dictate") {
			const fd = await req.formData().catch(() => null);
			const a = fd?.get("audio");
			const c = board.cards.find((c) => c.tab === String(fd?.get("tab") ?? ""));
			if (!c || !(a instanceof File) || !a.size) return bad("tab and audio required");
			await sendDictation(c.pane, String(fd?.get("text") ?? "").trim(), a, fd?.get("interrupt") === "1");
			markSeen(c.tab);
			return ok();
		}
		if (p === "/api/transcribe") {
			// Chat view's mic: speech → text for the composer (nothing is sent).
			const a = (await req.formData().catch(() => null))?.get("audio");
			if (!(a instanceof File) || !a.size) return bad("audio required");
			try {
				return Response.json({ ok: true, text: await transcribe(a) });
			} catch (e: any) {
				return bad(String(e?.message ?? e), 502);
			}
		}
		if (p === "/api/upload") {
			const files = (await req.formData()).getAll("file").filter((f): f is File => f instanceof File && f.size > 0);
			if (!files.length) return bad("file required");
			return Response.json({ ok: true, paths: await Promise.all(files.map(saveUpload)) });
		}
		const body: any = await req.json().catch(() => ({}));
		if (p === "/api/click") {
			const name = String(body.name ?? "").trim().slice(0, 80);
			if (!name) return bad("name required");
			const view = body.view === "phone" ? "phone" : "desktop";
			appendFileSync(CLICKS_FILE, JSON.stringify({ ts: Date.now(), name, view }) + "\n");
			return new Response(null, { status: 204 });
		}
		if (p === "/api/routines/run") {
			const id = String(body.id ?? "");
			if (!/^engine:[\w.@-]+$/.test(id)) return bad("engine routines only");
			const r = await run(["systemctl", "--user", "start", "--no-block", `${id.slice(7)}.service`]);
			return r.code === 0 ? Response.json({ ok: true }) : bad(r.err.trim() || "start failed", 409);
		}
		if (p === "/api/search") {
			// The New item box's "find" path: `ag search` has an LLM pick the sessions a description means (~6-10 s).
			const q = String(body.q ?? "").trim().slice(0, 2000);
			if (!q) return bad("q required");
			const r = await run(["timeout", "90", `${HOME}/.local/lib/ag/search`, "--json", "--", q]);
			if (r.code !== 0) return bad(r.err.trim().replace(/^ag: /, "") || "search failed", 502);
			return new Response(r.out, { headers: { "content-type": "application/json" } });
		}
		const tab = String(body.tab ?? "");
		const card = board.cards.find((c) => c.tab === tab);
		const fail = (r: { err: string }, what: string) => bad(r.err.trim() || `${what} failed`, 409);
		switch (p) {
			case "/api/card": {
				const cs = state.cards[cardKey.get(tab) ?? tab];
				if (!cs) return bad("no such card", 404);
				if (typeof (body.pinned ?? body.hot) === "boolean") cs.pinned = body.pinned ?? body.hot; // hot: the old name
				if (typeof body.waiting === "boolean") {
					if (body.waiting) cs.waiting = true; // the next poll asks the session to schedule its wake-up
					else delete cs.waiting, delete cs.wakeAskedAt, delete cs.wakeAsks;
				}
				if ("list" in body) cs.list = body.list || undefined;
				if (body.seen === true) cs.seenAt = Date.now();
				if (body.seen === false) cs.seenAt = 0;
				dirty = true;
				await after();
				return ok();
			}
			case "/api/lists": {
				if (!Array.isArray(body.lists)) return bad("lists required");
				state.lists = body.lists.map((l: any) => ({ id: String(l.id), name: String(l.name).slice(0, 40) }));
				const ids = new Set(state.lists.map((l) => l.id));
				for (const cs of Object.values(state.cards)) if (cs.list && !ids.has(cs.list)) delete cs.list;
				dirty = true;
				await after();
				return ok();
			}
			case "/api/areas": {
				// Ag Chat's sidebar: the order of areas (workspace ids), dragged by hand.
				if (!Array.isArray(body.order)) return bad("order required");
				state.areas = body.order.map(String).slice(0, 200);
				dirty = true;
				await after();
				return ok();
			}
			case "/api/workspace": {
				// Ag Chat's "New area" (an empty workspace with one shell tab), or renaming one ({id, label}).
				const label = String(body.label ?? "").trim().slice(0, 40);
				const id = String(body.id ?? "");
				if (!label) return bad("label required");
				if (board.workspaces.some((w) => w.id !== id && w.label.toLowerCase() === label.toLowerCase())) return bad("an area with that name exists", 409);
				if (id) {
					if (!board.workspaces.some((w) => w.id === id)) return bad("no such area", 404);
					const r = await mux("workspace", "rename", id, label);
					if (r.code !== 0) return fail(r, "workspace rename");
					await after();
					return ok();
				}
				const r = await mux("workspace", "create", "--cwd", HOME, "--label", label, "--no-focus");
				if (r.code !== 0) return fail(r, "workspace create");
				await after();
				return Response.json({ ok: true, id: JSON.parse(r.out).result?.workspace?.workspace_id });
			}
			case "/api/model": {
				// Ag Chat's model picker: pi's own `/model <provider/id>` and `/thinking <level>` (session-only, like
				// ChatGPT's per-chat switch). Only models from pi's enabledModels, so `/model` never opens its selector.
				if (!card) return bad("no such card", 404);
				const model = body.model ? String(body.model) : "";
				const level = body.thinking ? String(body.thinking) : "";
				if (model && !piModels().some((m) => m.id === model)) return bad("unknown model");
				if (level && !THINKING.includes(level)) return bad("unknown thinking level");
				if (!model && !level) return bad("model or thinking required");
				for (const cmd of [model && `/model ${model}`, level && `/thinking ${level}`].filter(Boolean) as string[]) {
					const r = await mux("agent", "prompt", card.pane, cmd);
					if (r.code !== 0) return fail(r, "switch");
				}
				await after();
				return ok();
			}
			case "/api/prompt": {
				const text = String(body.text ?? "").trim();
				if (!card || !text) return bad("tab and text required");
				const r = body.interrupt ? await interruptAndSend(card.pane, text) : await mux("agent", "prompt", card.pane, text);
				if (r.code !== 0) return fail(r, "prompt");
				markSeen(tab);
				void after(); // answer right away; the board refresh follows over SSE
				return ok();
			}
			case "/api/interrupt": {
				if (!card) return bad("no such card", 404);
				const r = await interrupt(card.pane);
				if (r.code !== 0) return fail(r, "interrupt");
				console.log(new Date().toISOString(), "interrupt", tab, card.title);
				await after();
				return ok();
			}
			case "/api/keys": {
				if (!card) return bad("no such card", 404);
				const ks: string[] = Array.isArray(body.keys) ? body.keys.map(String) : [];
				if (!ks.length || ks.some((k) => !KEYS.has(k))) return bad(`keys must be from: ${[...KEYS].join(", ")}`);
				const r = await keys(card.pane, ...ks);
				if (r.code !== 0) return fail(r, "keys");
				await after();
				return ok();
			}
			case "/api/resume": {
				const sid = String(body.sid ?? "");
				if (!SID_RE.test(sid)) return bad("sid required");
				try {
					const id = await resumeSession(sid, body.workspace ? String(body.workspace) : undefined);
					void after();
					return Response.json({ ok: true, tab: id });
				} catch (e: any) {
					return bad(String(e?.message ?? e), 409);
				}
			}
			case "/api/rename": {
				// A live card (tab) or any session by id (sid: hibernated or closed too). The name goes on the
				// tab and into the session file, so it persists.
				const label = String(body.label ?? "").trim().slice(0, 60);
				const sid = body.sid ? String(body.sid) : card?.sid;
				const r = !card && sid && SID_RE.test(sid) ? await resolveSession(sid) : null;
				const tabId = card?.tab ?? r?.tab;
				const file = card ? card.sessionFile : r?.state === "live" ? board.cards.find((c) => c.tab === r.tab)?.sessionFile : r?.file;
				if (!label || (!tabId && !file)) return bad("tab or sid, and label required");
				if (tabId) {
					const m = await mux("tab", "rename", tabId, label);
					if (m.code !== 0) return fail(m, "rename");
				}
				if (file && existsSync(file)) nameSession(file, label);
				await after();
				return ok();
			}
			case "/api/focus": {
				if (!card) return bad("no such card", 404);
				const r = await mux("tab", "focus", tab);
				if (r.code !== 0) return fail(r, "focus");
				markSeen(tab);
				await after();
				return ok();
			}
			case "/api/file": {
				// Chat view's "Move to project": `ag file <workspace> <tab>`.
				const ws = String(body.workspace ?? "");
				if (!card || !board.workspaces.some((w: any) => w.id === ws)) return bad("tab and workspace required");
				const r = await run([`${HOME}/.local/bin/ag`, "file", ws, tab]);
				if (r.code !== 0) return fail(r, "file");
				await after();
				return ok();
			}
			case "/api/close": {
				if (!card) return bad("no such card", 404);
				const r = await mux("tab", "close", tab);
				if (r.code !== 0) return fail(r, "close");
				await after();
				return ok();
			}
		}
		return bad("not found", 404);
}

// Ag Chat's Upcoming (Things 3): the tickler's pending items (~/.local/state/tickler/<id>.json), soonest first.
// sid: the deferring session, so the page can open it.
function upcoming() {
	const dir = `${HOME}/.local/state/tickler`;
	const out: any[] = [];
	for (const f of existsSync(dir) ? readdirSync(dir) : []) {
		if (!f.endsWith(".json")) continue;
		try {
			const t = JSON.parse(readFileSync(`${dir}/${f}`, "utf8"));
			if (t.status !== "waiting") continue;
			out.push({ id: t.id, title: t.title, workspace: t.workspace, due: t.due ?? null, when: t.when ?? null, waitingFor: t.waiting_for ?? null, check: !!t.check, expires: t.expires ?? null, sid: String(t.session ?? "").match(/([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\.jsonl$/)?.[1] ?? null });
		} catch {}
	}
	return out.sort((a, b) => (a.due ?? "9") < (b.due ?? "9") ? -1 : 1);
}

// pi's enabled models (settings.json enabledModels: "provider/model-id"), for Ag Chat's model picker.
const THINKING = ["off", "minimal", "low", "medium", "high", "xhigh"];
function piModels(): { id: string; name: string }[] {
	try {
		const st = JSON.parse(readFileSync(`${HOME}/.pi/agent/settings.json`, "utf8"));
		return (st.enabledModels ?? []).map((id: string) => ({ id, name: id.split("/").slice(1).join("/") }));
	} catch {
		return [];
	}
}

const serveOpts = { port: PORT, idleTimeout: 0 /* SSE streams stay open */, maxRequestBodySize: 64 * 1024 * 1024, fetch: handle };
Bun.serve({ ...serveOpts, hostname: host });
Bun.serve({ ...serveOpts, hostname: "127.0.0.1" }); // tailscale serve proxies here (it can't reach ag-mac's own Tailscale IP)
// HTTPS on the tailnet (idempotent; persists in tailscaled). Voice needs it: browsers only allow the mic on https.
const HTTPS_URL = (() => {
	try {
		execFileSync("/usr/local/bin/tailscale", ["serve", "--bg", `--https=${HTTPS_PORT}`, `http://127.0.0.1:${PORT}`], { stdio: "ignore", timeout: 15_000 });
		// Links use the Tailscale Service svc:ag (ag-svc), never this machine's own name.
		return `https://${AG_FQDN}:${HTTPS_PORT}`;
	} catch (e) {
		console.error("tailscale serve failed", e);
		return `http://ag:${PORT}`;
	}
})();
console.log(`ag-board listening on http://${host}:${PORT}, http://127.0.0.1:${PORT}, ${HTTPS_URL}`);
void loop();
void cuaLoop();
