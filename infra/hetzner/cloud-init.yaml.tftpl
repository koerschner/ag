#cloud-config
# Ag machine first boot: user, base packages, persistent volume (engine), Tailscale, then the ag repo
# (private; cloned with a read-only deploy key) then the owner's dotfiles if dotfiles_repo is set; bootstrap-linux stows them when the checkout exists.
hostname: ${hostname}
users:
  - name: ${user}
    shell: /bin/bash
    groups: [sudo, docker]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
      - ${ssh_public_key}
ssh_pwauth: false
disable_root: true
package_update: true
packages: [git, curl, jq, unzip, zsh, stow, ripgrep, fd-find, build-essential, docker.io, ca-certificates]
write_files:
  - path: /etc/ag-role
    content: "${role}\n"
runcmd:
%{ if volume_device != "" ~}
  - mkdir -p /data
  - echo '${volume_device} /data ext4 discard,nofail,defaults 0 0' >> /etc/fstab
  - mount /data
  # Bind-mount (not symlink) the persistent dirs so stow sees real directories inside them.
  - install -d -o ${user} -g ${user} /data/pi /data/inbox /data/state /home/${user}/.pi /home/${user}/inbox /home/${user}/.local /home/${user}/.local/state
  - printf '%s\n' '/data/pi /home/${user}/.pi none bind,nofail 0 0' '/data/inbox /home/${user}/inbox none bind,nofail 0 0' '/data/state /home/${user}/.local/state none bind,nofail 0 0' >> /etc/fstab
  - mount -a
%{ endif ~}
  - curl -fsSL https://tailscale.com/install.sh | sh
  - tailscale up --auth-key='${ts_auth_key}' --hostname=${hostname} --ssh --advertise-tags=${ts_tags}
  - install -d -m 0700 -o ${user} -g ${user} /home/${user}/.ssh
  - printf '%s\n' '${ag_deploy_key_b64}' | base64 -d > /home/${user}/.ssh/ag-deploy && chown ${user}:${user} /home/${user}/.ssh/ag-deploy && chmod 600 /home/${user}/.ssh/ag-deploy
  - sudo -u ${user} -H GIT_SSH_COMMAND='ssh -i ~/.ssh/ag-deploy -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new' git clone ${ag_repo} /home/${user}/ag
  - sudo -u ${user} -H git -C /home/${user}/ag config core.sshCommand 'ssh -i ~/.ssh/ag-deploy -o IdentitiesOnly=yes'
%{ if dotfiles_repo != "" ~}
  - sudo -u ${user} -H git clone ${dotfiles_repo} /home/${user}/dotfiles
%{ endif ~}
  - "[ -x /home/${user}/ag/bootstrap-linux ] && sudo -u ${user} -H /home/${user}/ag/bootstrap-linux || true"
