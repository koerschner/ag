#!/usr/bin/env zsh
# ag-mac's own macOS login password, kept in ag-mac's login Keychain so agents on ag-mac can
# answer ag-mac's admin/password prompts without reaching into the client Mac.
#
#   ag-login-password set    # the user, once: prompts (hidden), verifies it, stores it
#   ag-login-password check  # exit 0 if stored and still correct
#   ag-login-password type   # type it + Return into the focused password field on ag-mac
#   ag-login-password sudo CMD...  # run CMD as root on ag-mac (password fed to sudo -S on stdin)
#
# Never prints the password. Keychain: service "ag Mac login", account = this Mac's login user.
set -euo pipefail
svc="ag Mac login" acct=$(id -un)

verify() { print -r -- "$1" | dscl . -authonly "$acct" >/dev/null 2>&1; }
stored() {
  security find-generic-password -s "$svc" -a "$acct" -w 2>/dev/null && return
  # SSH has its own macOS security session where the login Keychain reads as locked. Like op-ag,
  # read it through a one-shot job in the logged-in GUI session, via a private FIFO (no file).
  local d label pw rc=1
  d=$(mktemp -d) label=com.ag.ag-login-password.$RANDOM$RANDOM
  mkfifo -m 600 "$d/p"
  /usr/libexec/PlistBuddy -c "Add :Label string $label" -c 'Add :RunAtLoad bool true' \
    -c 'Add :ProgramArguments array' -c 'Add :ProgramArguments:0 string /usr/bin/security' \
    -c 'Add :ProgramArguments:1 string find-generic-password' -c "Add :ProgramArguments:2 string -s" \
    -c "Add :ProgramArguments:3 string $svc" -c 'Add :ProgramArguments:4 string -a' \
    -c "Add :ProgramArguments:5 string $acct" -c 'Add :ProgramArguments:6 string -w' \
    -c "Add :StandardOutPath string $d/p" -c 'Add :StandardErrorPath string /dev/null' "$d/j.plist" >/dev/null
  if launchctl bootstrap gui/$UID "$d/j.plist" 2>/dev/null; then
    exec {fd}<>"$d/p"  # open read-write so the open can't block if the job never writes
    read -r -t 10 -u $fd pw && [[ -n $pw ]] && { print -r -- "$pw"; rc=0; }
    exec {fd}<&-
  fi
  launchctl bootout gui/$UID/$label 2>/dev/null; rm -rf "$d"; unset pw
  return $rc
}

case ${1:-} in
  set)
    [[ -t 0 ]] || { echo "run this in a terminal (it prompts)" >&2; exit 2; }
    read -rs "pw?ag login password for $acct: "; echo
    verify "$pw" || { echo "That isn't ag-mac's login password; nothing stored." >&2; exit 1; }
    # Over SSH the login Keychain is usually locked for writes (-25308); unlock it with the same
    # password, again via security -i on stdin (quotes and backslashes escaped for its parser).
    esc=${pw//\\/\\\\}; esc=${esc//\"/\\\"}
    print -r -- "unlock-keychain -p \"$esc\" $HOME/Library/Keychains/login.keychain-db" | security -i >/dev/null 2>&1 || true
    unset esc
    hex=$(print -rn -- "$pw" | xxd -p | tr -d '\n'); unset pw
    # Replace any old copy: one made elsewhere (e.g. Keychain Access) can carry an ACL that
    # refuses `security` over SSH, so updating it fails with -25308 and reads come back empty.
    security delete-generic-password -s "$svc" -a "$acct" >/dev/null 2>&1 || true
    # via security -i on stdin so the secret never appears in argv; -T lets `security` read it
    print -r -- "add-generic-password -U -T /usr/bin/security -s \"$svc\" -a $acct -l \"$svc\" -j \"ag-mac's own login password, for agents answering ag-mac's auth prompts\" -X $hex" | security -i >/dev/null
    unset hex
    echo "Stored in ag-mac's login Keychain ('$svc'). Agents can now use: ag-login-password type" ;;
  check)
    pw=$(stored) || { echo "missing: run 'ag-login-password set'" >&2; exit 1; }
    verify "$pw" && echo ok || { echo "stale: run 'ag-login-password set'" >&2; exit 1; } ;;
  type)
    AGPW=$(stored) || { echo "missing: ask the user to run 'ag-login-password set' on ag-mac" >&2; exit 1; }
    AGPW=$AGPW osascript -e 'tell application "System Events" to keystroke (system attribute "AGPW")' \
      -e 'delay 0.3' -e 'tell application "System Events" to key code 36' ;;
  sudo)
    shift; (( $# )) || { echo "usage: ag-login-password sudo CMD..." >&2; exit 2; }
    pw=$(stored) || { echo "missing: ask the user to run 'ag-login-password set' on ag-mac" >&2; exit 1; }
    # sudo -S reads the password line from stdin byte by byte; the rest of stdin (if piped) goes to CMD.
    # (A separate `sudo -v` doesn't carry over: without a tty the ticket is keyed to the parent pid.)
    { print -r -- "$pw"; unset pw; [[ -t 0 ]] || cat; } | sudo -S -p '' "$@" ;;
  *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
