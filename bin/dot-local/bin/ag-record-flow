#!/usr/bin/env bun
// ag-record-flow — record a browser flow headlessly as an iPhone-playable mp4 (Playwright recordVideo + ffmpeg).
//
//   ag-record-flow <url> [flow.ts] [-o out.mp4] [--size 1280x800] [--mobile] [--storage state.json] [--trace]
//
//   flow.ts (optional) default-exports the steps; without it the page just loads and sits for 3s:
//     export default async ({ page, context, pause }) => {
//       await page.getByRole("button", { name: "Play" }).click();
//       await pause(1500);                       // give the viewer time to see each step
//     };
//
//   --mobile         iPhone 15 viewport, touch, and user agent
//   --storage FILE   Playwright storageState (cookies/localStorage), e.g. a signed-in staging session
//   --trace          also write <out>.trace.zip (open with `npx playwright show-trace`)
//
// Prints the mp4 path. Default output: /tmp/ag-record-flow/<host>-<time>.mp4. Show it with `ag-show <mp4>`.
// Playwright lives in ~/.cache/ag-record-flow (installed on first run), independent of any repo.
import { parseArgs } from "node:util";
import { existsSync, mkdirSync, mkdtempSync, rmSync } from "node:fs";
import { tmpdir, homedir } from "node:os";
import { join, resolve } from "node:path";

const PW_VERSION = "1.63.0";
const CACHE = join(homedir(), ".cache/ag-record-flow");

const { values: o, positionals } = parseArgs({
	allowPositionals: true,
	options: {
		out: { type: "string", short: "o" },
		size: { type: "string", default: "1280x800" },
		mobile: { type: "boolean", default: false },
		storage: { type: "string" },
		trace: { type: "boolean", default: false },
		help: { type: "boolean", short: "h" },
	},
});
const [url, flowFile] = positionals;
if (o.help || !url) {
	console.error("usage: ag-record-flow <url> [flow.ts] [-o out.mp4] [--size WxH] [--mobile] [--storage state.json] [--trace]");
	process.exit(o.help ? 0 : 2);
}

const run = (cmd: string[], cwd?: string) => {
	const p = Bun.spawnSync(cmd, { cwd, stdout: "ignore", stderr: "pipe" });
	if (p.exitCode !== 0) throw new Error(`${cmd.join(" ")} failed:\n${p.stderr.toString().slice(-2000)}`);
};
if (!existsSync(join(CACHE, "node_modules/playwright"))) {
	mkdirSync(CACHE, { recursive: true });
	console.error(`ag-record-flow: installing playwright@${PW_VERSION} into ${CACHE} (first run)…`);
	await Bun.write(join(CACHE, "package.json"), JSON.stringify({ private: true }));
	run(["bun", "add", `playwright@${PW_VERSION}`], CACHE);
}
const { chromium, devices } = await import(join(CACHE, "node_modules/playwright/index.mjs"));

const launch = async () => {
	try { return await chromium.launch(); } catch (e) {
		if (!/Executable doesn't exist/.test(String(e))) throw e;
		console.error("ag-record-flow: installing Chromium…");
		run([join(CACHE, "node_modules/.bin/playwright"), "install", "chromium"], CACHE);
		return chromium.launch();
	}
};

const [w, h] = o.size!.split("x").map(Number);
const device = o.mobile ? devices["iPhone 15"] : { viewport: { width: w, height: h } };
const videoDir = mkdtempSync(join(tmpdir(), "ag-record-flow-"));
const stamp = new Date().toISOString().replace(/[:.]/g, "-").slice(0, 19);
const out = resolve(o.out ?? `/tmp/ag-record-flow/${new URL(url).hostname}-${stamp}.mp4`);
mkdirSync(join(out, ".."), { recursive: true });

const browser = await launch();
const context = await browser.newContext({
	...device,
	storageState: o.storage,
	recordVideo: { dir: videoDir, size: device.viewport },
});
if (o.trace) await context.tracing.start({ screenshots: true, snapshots: true });
const page = await context.newPage();
const pause = (ms = 1000) => page.waitForTimeout(ms);
let failed: unknown;
try {
	await page.goto(url, { waitUntil: "networkidle" }).catch(() => page.waitForLoadState("load"));
	if (flowFile) await (await import(resolve(flowFile))).default({ page, context, pause });
	else await pause(3000);
	await pause(800); // hold the last frame
} catch (e) {
	failed = e; // still save the video: it shows where the flow broke
}
if (o.trace) await context.tracing.stop({ path: out.replace(/\.mp4$/, "") + ".trace.zip" });
const video = page.video();
await context.close();
await browser.close();
const webm = await video!.path();

// H.264 + yuv420p + faststart so it plays inline on iPhone Safari and in QuickTime.
run(["ffmpeg", "-y", "-loglevel", "error", "-i", webm, "-c:v", "libx264", "-preset", "veryfast", "-crf", "23",
	"-pix_fmt", "yuv420p", "-vf", "scale=trunc(iw/2)*2:trunc(ih/2)*2", "-movflags", "+faststart", out]);
rmSync(videoDir, { recursive: true, force: true });
console.log(out);
if (failed) {
	console.error(`ag-record-flow: flow failed (video saved up to the failure): ${failed}`);
	process.exit(1);
}
