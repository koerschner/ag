# Archive this machine's Pi sessions to koerschner/pi-sessions-NNN (redacted, git-crypt). docs/ag.md.
[Unit]
Description=Archive Pi sessions to GitHub

[Service]
Type=oneshot
# The session host also pulls the client's sessions, as ag-mac's LaunchAgent did.
ExecStart=/bin/zsh -c 'if %h/.local/bin/machine-role host; then exec pi-sessions-sync --remote ag-client; else exec pi-sessions-sync; fi'
