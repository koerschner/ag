{
  "_doc": "Canonical Herdr shortcuts. Edit here, then run herdr-shortcuts-check. Hammerspoon reads this file (Mac); herdr's config.toml must bind each `key` directly (Moshi forwards Cmd) and via `prefix` (Mac Hammerspoon chord, and fallback anywhere). See herdr/SHORTCUTS.md. `moshi` is how the key behaves in Moshi (\"direct\" = Moshi forwards Cmd to herdr).",
  "shortcuts": [
    {
      "key": "cmd+t",
      "prefix": "t",
      "action": "New tab running Pi",
      "binding": "keys.command herdr-new-pi-tab",
      "moshi": "direct (verified)"
    },
    {
      "key": "cmd+w",
      "prefix": "x",
      "action": "Close pane",
      "binding": "close_pane",
      "moshi": "Moshi keeps it: `Ctrl+B` `x`"
    },
    {
      "key": "cmd+d",
      "prefix": "v",
      "action": "Split side by side",
      "binding": "split_vertical",
      "moshi": "direct"
    },
    {
      "key": "cmd+shift+d",
      "prefix": "minus",
      "action": "Split stacked",
      "binding": "split_horizontal",
      "moshi": "direct"
    },
    {
      "key": "cmd+[",
      "prefix": "[",
      "action": "Focus history back",
      "binding": "keys.command herdr-nav back",
      "moshi": "direct"
    },
    {
      "key": "cmd+]",
      "prefix": "]",
      "action": "Focus history forward",
      "binding": "keys.command herdr-nav forward",
      "moshi": "direct"
    },
    {
      "key": "cmd+1..9",
      "prefix": "1..9",
      "action": "Switch to tab 1-9",
      "binding": "switch_tab",
      "moshi": "Moshi keeps it: `Ctrl+B` `1\u20139`"
    }
  ]
}
