#!/usr/bin/env zsh
# ag-type-secret — type a 1Password secret into the focused field on ag-mac, without it ever
# appearing in a prompt, transcript, log, or screenshot report.
#
#   ag-type-secret [--app "Google Chrome"] op://<vault>/<item>/<field>
#
# Use it from INSIDE a computer-use run: put this command in the `ag cua` task ("click the card-number
# field, then run `ag-type-secret --app 'Google Chrome' op://machine-shared/<item>/ccnum`"). The run
# holds the screen (ag-screen-queue), so the keystrokes can't land in another job's window, and the
# CUA model never sees the secret as text. Outside a queued job it refuses (use `ag screen exec` or a CUA task).
# --app: refuse unless that app is frontmost. Vault machine-shared → op-shared, ag-vault → op-work,
# anything else → op-ag. Prints only how many characters it typed.
set -uo pipefail
app=
while (( $# )); do
  case $1 in
    --app) app=${2:?--app needs a name}; shift 2 ;;
    -h|--help) sed -n '2,13p' $0; exit 0 ;;
    *) break ;;
  esac
done
ref=${1:?usage: ag-type-secret [--app NAME] op://vault/item/field}
[[ $ref == op://* ]] || { print -u2 "ag-type-secret: expected an op:// reference"; exit 2; }
if [[ -z ${CUA_QUEUE_INNER:-} ]]; then
  print -u2 "ag-type-secret: refusing to type outside a screen-queue job; run it from an \`ag cua\` task (or \`ag-mac gui\`)"
  exit 3
fi
case ${${ref#op://}%%/*} in
  machine-shared) op=op-shared ;;
  ag-vault) op=op-work ;;
  *) op=op-ag ;;
esac
if [[ -n $app ]]; then
  front=$(osascript -e 'tell application "System Events" to get name of first process whose frontmost is true')
  [[ $front == "$app" ]] || { print -u2 "ag-type-secret: frontmost app is '$front', not '$app'; nothing typed"; exit 4; }
fi
secret=$($op read "$ref" </dev/null) || { print -u2 "ag-type-secret: could not read the reference"; exit 5; }
[[ $ref == */ccnum ]] && secret=${secret//[ -]/}
secret=${secret%$'\n'}
# Passed in the environment, not argv (argv shows in `ps` to every user).
AG_SECRET=$secret osascript -e 'tell application "System Events" to keystroke (system attribute "AG_SECRET")' ||
  { print -u2 "ag-type-secret: keystroke failed"; exit 6; }
print "ag-type-secret: typed ${#secret} characters"
