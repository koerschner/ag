const WAKE_MAX = 3;
// The user's display name: $AG_USER_NAME, else its line in the private ~/ag-personal/env, else "the user".
const USER_NAME = process.env.AG_USER_NAME || (() => { try { return readFileSync(`${HOME}/ag-personal/env`, "utf8").match(/^AG_USER_NAME=(.*)$/m)?.[1].trim() ?? ""; } catch { return ""; } })() || "the user";
// A tickler item "waiting for" the user themselves (their first name, "me", "the user") belongs in Needs you.
const USER_RE = new RegExp(`^(${[...(USER_NAME === "the user" ? [] : [USER_NAME.split(/\s+/)[0].replace(/[.*+?^${}()|[\]\\]/g, "\\$&")]), "me", "you", "the user"].join("|")})\\b`, "i");
const waitingOnUser = (who: string) => USER_RE.test(who.trim());
const WAKE_PREFIX = "[ag-dash] The user moved this session to Waiting for.";
const WAKE_NOTE = `${WAKE_PREFIX} Per "Waiting always wakes up" (AGENTS.md → GTD model), schedule your own wake-up with the ag-tickler now, at an interval you choose: a waitingFor item if you're waiting on a person, or when: "check" with a cheap shell check plus expires for a machine or programmatic signal (if it can't be checked programmatically, the woken session checks by computer use). Don't follow up with outside parties without the user's OK; draft it for them instead. Then reply in one or two lines: what you're waiting on and when you'll next check. The card stays flagged "no wake-up" on the board until the ag-tickler item exists.`;
// The visible text is the action; the why and how ride in an origin tag (a chip in the UIs).
const WAKE_PROMPT = `${originTag({ kind: "dash", label: "You moved this to Waiting for", note: WAKE_NOTE })}\nSchedule your wake-up.`;
const BIG_LINE = 256 * 1024; // tool results this big (screenshots) are summarised by regex, not parsed
const KEYS = new Set(["esc", "enter", "up", "down", "left", "right", "tab", "backspace", "ctrl+u", "y", "n", "1", "2", "3"]);

type CardState = { judged?: { ts: number; done: boolean } /* Jev's verdict on the answer at ts */; archived?: number /* archived while working: hidden, closes when it finishes cleanly */; goneAt?: number /* tab missing since; forgotten after GONE_KEEP_MS */; waiting?: boolean /* marked by hand */; wakeAskedAt?: number; wakeAsks?: number; pinned?: boolean; pinnedAt?: number /* when pinned: ag-dash chat's Pinned order */; hot?: boolean; red?: boolean /* older names of pinned */; list?: string; seenAt: number; status?: string; statusSince: number; pingedAt?: number; wasNeedsYou?: boolean };
type List = { id: string; name: string };
type State = { cards: Record<string, CardState>; lists: List[]; pinnedModels?: string[] /* models pinned to the top of its model picker */ };
type Msg = { role: "user" | "assistant"; text: string; ts: number; raw?: string /* user text with origin tags, for media paths */ };
type Tool = { id?: string; name: string; detail: string; sum?: string; hosts?: string[]; ts: number; end?: number; error?: boolean };
type Activity = { kind: "thinking" | "tool" | "idle" | "error"; since: number; tool?: string; detail?: string; sum?: string; hosts?: string[]; error?: string };
type Session = {
	mtime: number;
	size: number;
	offset: number;
	cwd?: string;
	startedAt?: number;
	model?: string;
	thinkingLevel?: string;
	first?: string;
	name?: string; // pi session name (latest session_info): a rename that outlives the tab
	lastUser?: Msg;
	lastAssistant?: Msg;
	thinking?: string;
	thinkingTs?: number;
	tools: Tool[];
	toolCount: number;
	turns: number;
	cost: number;
	ctx: number;
	activity: Activity;
	lastAt: number; // newest entry timestamp (file mtimes aren't reliable: migrations copy files)
	replied?: boolean; // the user has prompted it after its first prompt: it's out of the Inbox
};

// ---------- state ----------
