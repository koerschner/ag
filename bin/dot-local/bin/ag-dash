const STATIC = new Set(["telemetry.js", "keys.js", "manifest.json", "icon.svg", "icon-180.png", "icon-192.png", "icon-512.png"]); // keys.js: the Mac app's quick entry box
const UPLOAD_DIR = `${HOME}/inbox/clipboard`;
const INBOX_URL = process.env.AG_INBOX_URL || "http://ag:7373/prompt?new=1"; // the ag-inbox: new items land in Inbox
// The AI gateway (TrueFoundry): $AG_AI_GATEWAY, else its line in the private ~/ag-personal/env.
const AI_GATEWAY = (process.env.AG_AI_GATEWAY || (() => { try { return readFileSync(`${HOME}/ag-personal/env`, "utf8").match(/^AG_AI_GATEWAY=(.*)$/m)?.[1].trim() ?? ""; } catch { return ""; } })()).replace(/\/$/, "");
const STT_URL = `${AI_GATEWAY}/audio/transcriptions`;
