#!/usr/bin/env zsh
# ag's own macOS login password, kept in ag's login Keychain so agents on ag can
# answer ag's admin/password prompts without reaching into the client Mac.
#
#   ag-login-password set    # Nathan, once: prompts (hidden), verifies it, stores it
#   ag-login-password check  # exit 0 if stored and still correct
#   ag-login-password type   # type it + Return into the focused password field on ag
#
# Never prints the password. Keychain: service "ag Mac login", account natkoersch.
set -euo pipefail
svc="ag Mac login" acct=natkoersch

verify() { print -r -- "$1" | dscl . -authonly "$acct" >/dev/null 2>&1; }
stored() { security find-generic-password -s "$svc" -a "$acct" -w 2>/dev/null; }

case ${1:-} in
  set)
    [[ -t 0 ]] || { echo "run this in a terminal (it prompts)" >&2; exit 2; }
    read -rs "pw?ag login password for $acct: "; echo
    verify "$pw" || { echo "That isn't ag's login password; nothing stored." >&2; exit 1; }
    hex=$(print -rn -- "$pw" | xxd -p | tr -d '\n'); unset pw
    # via security -i on stdin so the secret never appears in argv
    print -r -- "add-generic-password -U -s \"$svc\" -a $acct -l \"$svc\" -j \"ag's own login password, for agents answering ag's auth prompts\" -X $hex" | security -i >/dev/null
    unset hex
    echo "Stored in ag's login Keychain ('$svc'). Agents can now use: ag-login-password type" ;;
  check)
    pw=$(stored) || { echo "missing: run 'ag-login-password set'" >&2; exit 1; }
    verify "$pw" && echo ok || { echo "stale: run 'ag-login-password set'" >&2; exit 1; } ;;
  type)
    AGPW=$(stored) || { echo "missing: ask Nathan to run 'ag-login-password set' on ag" >&2; exit 1; }
    AGPW=$AGPW osascript -e 'tell application "System Events" to keystroke (system attribute "AGPW")' \
      -e 'delay 0.3' -e 'tell application "System Events" to key code 36' ;;
  *) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
