#!/usr/bin/env bash
# Validate, then apply ag tailscale/policy.hujson to the tailnet (the policy's source of truth).
set -euo pipefail
policy="$(cd "$(dirname "$(readlink -f "$0")")/../../.." && pwd)/tailscale/policy.hujson"
out=$(ts-api POST tailnet/-/acl/validate -H 'Content-Type: application/hujson' --data-binary @"$policy")
[[ $out == "{}" || -z $out ]] || { echo "invalid policy: $out" >&2; exit 1; }
ts-api POST tailnet/-/acl -H 'Content-Type: application/hujson' --data-binary @"$policy" >/dev/null
echo "applied $policy"
