#!/bin/sh
# ag-text: send the user a short message on their phone, from "ag".
#   ag-text "<message>"      (or pipe the message on stdin)
# Transport, first that works:
#   1. Telegram bot "ag": token in login Keychain item "ag telegram bot" (account: this Mac's login user),
#      chat id in "ag telegram chat". Messages come from a separate contact, so they notify.
#      Otherwise (Linux, or a Mac whose Keychain is locked over SSH): ~/.config/ag/telegram
#      (mode 600), lines `token=…` and `chat=…`. Recovery copy in op-shared
#      item "ag telegram bot".
#      `ag-telegram send` sends it to the feed and records it (origin: $AG_TEXT_SESSION, else
#      $PI_SESSION_ID; $AG_TEXT_ORIGIN names a routine or alert; $AG_TEXT_KIND=notify marks ag-notify's
#      ✅/⚠️ texts, whose status emoji ag-telegram edits later) in ~/.local/state/ag-telegram/store.db,
#      so the user's Telegram replies route back to that work (docs/reference.md, "Telegram").
#   2. iMessage from the client Mac to the user's number (needs the client awake; texts their own
#      number, so it may arrive silently). $AG_TEXT_CLIENT, default ag-client.
set -eu
msg=${1:-$(cat)}
[ -n "$msg" ] || { echo "ag-text: empty message" >&2; exit 2; }
if "$(dirname "$0")/ag-telegram" send "$msg" >/dev/null; then exit 0; fi
echo "ag-text: telegram failed, falling back to iMessage" >&2

client=${AG_TEXT_CLIENT:-ag-client}
# The user's number: $AG_TEXT_NUMBER, else the AG_TEXT_NUMBER= line in ~/ag-personal/env (private checkout).
number=${AG_TEXT_NUMBER:-$(sed -n 's/^AG_TEXT_NUMBER=//p' ~/ag-personal/env 2>/dev/null | tail -n 1 | tr -d '"'"'"' ')}
[ -n "$number" ] || { echo "ag-text: no phone number: set AG_TEXT_NUMBER or add AG_TEXT_NUMBER=+1… to ~/ag-personal/env" >&2; exit 1; }
timeout 30 ssh -o ConnectTimeout=8 "$client" \
  "osascript -e 'on run argv' -e 'tell application \"Messages\" to send (item 2 of argv) to participant (item 1 of argv) of (1st account whose service type = iMessage)' -e 'end run' '$number' \"\$(cat)\"" <<EOF
$msg
EOF
