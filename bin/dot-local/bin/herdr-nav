#!/usr/bin/env python3
"""Browser-style back/forward focus history for Herdr.

  herdr-nav daemon    watch Herdr focus events and serve back/forward requests
  herdr-nav back      focus the previous pane in history
  herdr-nav forward   focus the next pane in history
  herdr-nav status    print the history (for debugging)

The daemon subscribes to Herdr's socket API (pane/tab/workspace focus events),
records the focused pane after each change, and listens on a control socket.
Hammerspoon binds Cmd+[ / Cmd+] to `back` / `forward`.
Stdlib only on purpose: launchd runs it with the system python3.
"""

import json
import os
import socket
import sys
import threading
import time

HERDR_SOCK = os.path.expanduser(os.environ.get("HERDR_SOCKET", "~/.config/herdr/herdr.sock"))
STATE_DIR = os.path.expanduser("~/.local/state/herdr-nav")
CTL_SOCK = os.path.join(STATE_DIR, "ctl.sock")
MAX_HISTORY = 200
# Focus events that arrive this soon after our own jump are treated as part of it.
JUMP_SETTLE_S = 0.4


def herdr_request(method, params=None, timeout=3.0):
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(timeout)
    try:
        s.connect(HERDR_SOCK)
        s.sendall((json.dumps({"id": "nav", "method": method, "params": params or {}}) + "\n").encode())
        line = s.makefile().readline()
    finally:
        s.close()
    resp = json.loads(line)
    if "error" in resp:
        raise RuntimeError(resp["error"])
    return resp.get("result")


def snapshot():
    return herdr_request("session.snapshot")["snapshot"]


class History:
    def __init__(self):
        self.lock = threading.Lock()
        self.entries = []  # pane ids
        self.index = -1
        self.jump_target = None
        self.jump_deadline = 0.0

    def record(self, pane_id):
        with self.lock:
            now = time.monotonic()
            if self.jump_target is not None and now < self.jump_deadline:
                # Part of our own back/forward jump: don't rewrite history.
                if pane_id == self.jump_target:
                    self.jump_target = None
                return
            self.jump_target = None
            if self.index >= 0 and self.entries[self.index] == pane_id:
                return
            del self.entries[self.index + 1 :]
            self.entries.append(pane_id)
            if len(self.entries) > MAX_HISTORY:
                del self.entries[: len(self.entries) - MAX_HISTORY]
            self.index = len(self.entries) - 1

    def step(self, direction):
        snap = snapshot()
        live = {p["pane_id"] for p in snap["panes"]}
        current = snap.get("focused_pane_id")
        with self.lock:
            # Drop closed panes, then collapse adjacent duplicates they leave behind.
            kept, new_index = [], -1
            for i, pid in enumerate(self.entries):
                if pid in live and (not kept or kept[-1] != pid):
                    kept.append(pid)
                if i == self.index:
                    new_index = len(kept) - 1
            self.entries, self.index = kept, new_index
            if current and (self.index < 0 or self.entries[self.index] != current):
                # Focus changed without us seeing it (e.g. daemon started late).
                del self.entries[self.index + 1 :]
                self.entries.append(current)
                self.index = len(self.entries) - 1
            target = self.index + direction
            if not 0 <= target < len(self.entries):
                return None
            self.index = target
            pane_id = self.entries[target]
            self.jump_target = pane_id
            self.jump_deadline = time.monotonic() + JUMP_SETTLE_S
        herdr_request("pane.focus", {"pane_id": pane_id})
        return pane_id

    def dump(self):
        with self.lock:
            return {"index": self.index, "entries": list(self.entries)}


def watch_focus(history):
    subs = [{"type": t} for t in ("pane.focused", "tab.focused", "workspace.focused")]
    while True:
        try:
            s = socket.socket(socket.AF_UNIX)
            s.connect(HERDR_SOCK)
            s.sendall((json.dumps({"id": "nav-sub", "method": "events.subscribe", "params": {"subscriptions": subs}}) + "\n").encode())
            f = s.makefile()
            first = snapshot().get("focused_pane_id")
            if first:
                history.record(first)
            for line in f:
                try:
                    msg = json.loads(line)
                except ValueError:
                    continue
                data = msg.get("data") or {}
                if msg.get("event") == "pane_focused" and data.get("pane_id"):
                    history.record(data["pane_id"])
                elif msg.get("event") in ("tab_focused", "workspace_focused"):
                    pid = snapshot().get("focused_pane_id")
                    if pid:
                        history.record(pid)
        except (OSError, RuntimeError, ValueError, KeyError):
            pass
        time.sleep(1)  # Herdr not running / restarted: retry.


def serve(history):
    os.makedirs(STATE_DIR, exist_ok=True)
    if os.path.exists(CTL_SOCK):
        os.unlink(CTL_SOCK)
    srv = socket.socket(socket.AF_UNIX)
    srv.bind(CTL_SOCK)
    srv.listen(8)
    while True:
        conn, _ = srv.accept()
        with conn:
            try:
                cmd = conn.makefile().readline().strip()
                if cmd in ("back", "forward"):
                    moved = history.step(-1 if cmd == "back" else 1)
                    reply = {"ok": True, "pane_id": moved}
                elif cmd == "status":
                    reply = {"ok": True, **history.dump()}
                else:
                    reply = {"ok": False, "error": f"unknown command {cmd!r}"}
            except Exception as e:  # keep serving no matter what
                reply = {"ok": False, "error": str(e)}
            try:
                conn.sendall((json.dumps(reply) + "\n").encode())
            except OSError:
                pass


def client(cmd):
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(3)
    try:
        s.connect(CTL_SOCK)
    except OSError:
        sys.exit("herdr-nav daemon not running (launchctl kickstart gui/$UID/com.nathan.herdr-nav)")
    s.sendall((cmd + "\n").encode())
    print(s.makefile().readline().strip())


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "daemon":
        history = History()
        threading.Thread(target=watch_focus, args=(history,), daemon=True).start()
        serve(history)
    elif cmd in ("back", "forward", "status"):
        client(cmd)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
