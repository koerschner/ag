#!/usr/bin/env zsh
# Compile (when the source changes) and run headless-display. See the .m file.
set -euo pipefail
src=$HOME/.local/share/headless-display/headless-display.m
bin=$HOME/Library/Caches/headless-display/headless-display
if [[ ! -x $bin || $src -nt $bin ]]; then
  mkdir -p ${bin:h}
  xcrun clang -O2 -fobjc-arc -Wno-deprecated-declarations \
    -framework Foundation -framework CoreGraphics -framework IOKit \
    ${src:A} -o $bin
fi
exec $bin "$@"
