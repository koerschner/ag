<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ag.ag-sms-watch</string>
  <!-- Every 5 min: text the user when SMS reach ag-mac's chat.db late, i.e. Text Message Forwarding stopped (bin/dot-local/bin/ag-sms-watch). Acts on ag-mac only. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>exec "$HOME/.local/bin/ag-sms-watch" check</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/ag-sms-watch.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/ag-sms-watch.log</string>
</dict>
</plist>
