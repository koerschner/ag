const AG_DIR = (() => { try { return dirname(dirname(dirname(dirname(realpathSync(import.meta.path))))); } catch { return `${HOME}/ag`; } })();
// The app (React; source in <ag>/ag-dash/web, built and committed to its dist/): /chat… serves its index.html (it
// routes itself), /assets/… its hashed bundles. Static files (icons, manifest) sit in ag-dash/dot-local/share/ag-dash.
