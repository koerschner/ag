#!/usr/bin/env bash
# Assemble the global agent instructions (pi/dot-pi/agent/AGENTS.md, untracked) from agents.md/ plus your own layer.
#   sections/NNN-name.md   one top-level `##` section each, concatenated in filename order
#                          (renumber to reorder; leave gaps of 10 to insert between)
#   includes/NAME.md       longer docs pulled into a section by a line `<!-- include: NAME.md -->`,
#                          headings demoted two levels so they nest under that section
#   Your layer: $AG_USER_AGENTS (default ~/.ag/agents.md, e.g. stowed from your dotfiles) with the same
#   sections/ and includes/ layout. Its sections merge into the same filename order (a same-named file
#   replaces ag's), and its includes win over ag's. ag ships only the generic sections; personal rules
#   (such as how agents attribute what they write) belong in your layer.
#   build          write the generated file
#   build --check  exit 1 if the generated file is out of date
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
user="${AG_USER_AGENTS:-$HOME/.ag/agents.md}"
out="$here/../pi/dot-pi/agent/AGENTS.md"

sections() {
  # basename<TAB>path, user layer last so it wins on equal names; then keep the last per basename
  { for f in "$here"/sections/*.md; do printf '%s\t%s\t0\n' "$(basename "$f")" "$f"; done
    for f in "$user"/sections/*.md; do [[ -f $f ]] && printf '%s\t%s\t1\n' "$(basename "$f")" "$f"; done
  } | sort -t$'\t' -k1,1 -k3,3 | awk -F'\t' '{ last[$1] = $2; order[$1] = NR } END { for (k in last) print order[k] "\t" k "\t" last[k] }' |
    sort -t$'\t' -k2,2 | cut -f3
}

render() {
  printf '<!-- GENERATED by agents.md/build from agents.md/ (and %s). Do not edit; edit the sources and rebuild. -->\n\n' "${user/#$HOME/\~}"
  local first=1 section
  while IFS= read -r section; do
    # Sections are separated by one blank line; each source file ends at its last line.
    (( first )) || printf '\n'
    first=0
    while IFS= read -r line || [[ -n $line ]]; do
      if [[ $line =~ ^\<!--\ include:\ ([A-Za-z0-9._-]+)\ --\>$ ]]; then
        src="$user/includes/${BASH_REMATCH[1]}"
        [[ -f $src ]] || src="$here/includes/${BASH_REMATCH[1]}"
        [[ -f $src ]] || { echo "build: missing include ${BASH_REMATCH[1]}" >&2; exit 1; }
        awk '/^```/ { fence = !fence } !fence && /^#/ { $0 = "##" $0 } { print }' "$src"
      else
        printf '%s\n' "$line"
      fi
    done < <(sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$section")
  done < <(sections)
}

if [[ ${1:-} == --check ]]; then
  diff -q <(render) "$out" >/dev/null 2>&1 || { echo "build: $out is stale; run agents.md/build" >&2; exit 1; }
else
  render > "$out.tmp" && mv "$out.tmp" "$out"
fi
