#!/usr/bin/env bun
// ag-inbox: the ag inbox, the top-level endpoint that starts a new pi session on ag.
//
// POST a prompt to http://ag:7373/prompt (or use the test page at /). Every capture path uses it:
// the Mac quick capture (Hammerspoon), the iPhone Action Button, file-inbox's "New session".
// Pipeline, one function per step, one JSON log line per step (~/.local/state/ag-inbox/log.jsonl):
//   receive → label (cheap model names the tab) + screenshot gate (Jev) → launch (new tab in Inbox, start pi, send)
// Body: raw text, or a form with `text` and optional fields:
//   id          the phone's queue file name: a repeat id within 24h is acknowledged but not relaunched,
//               so the iOS offline queue can safely resend an item whose first response was lost.
//   screenshot  image file (multipart). Saved to ~/inbox/capture; Jev decides whether the prompt needs it
//   app, window frontmost app and window title when captured (context for Jev and the agent)
//   attach      "always" = skip Jev and attach (e.g. Nathan annotated it)
// Listens only on ag's Tailscale IP. Never focuses anything, so attached Herdr clients aren't disturbed.
// Run by the com.nathan.ag-inbox LaunchAgent.

import { execFileSync } from "node:child_process";
import { appendFileSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";

const PORT = 7373;
const HOME = homedir();
const HERDR = `${HOME}/.local/bin/herdr`;
const LOG_DIR = `${HOME}/.local/state/ag-inbox`;
const CAPTURE_DIR = `${HOME}/inbox/capture`;
const INBOX = "Inbox";
const MODEL = "gemini-group/gemini-3.5-flash-lite";
const TFY_URL = "https://tfy.promptlens.trilogy.com/chat/completions";
const JEV_URL = "https://tfy.promptlens.trilogy.com/proxy-api/jev-account/jev-endpoint/v1/systemone";
const ATTACH_THRESHOLD = 0.5; // P(prompt needs the screen); tested on ~10 typical captures

mkdirSync(LOG_DIR, { recursive: true });
mkdirSync(CAPTURE_DIR, { recursive: true });

function log(id: string, step: string, data: Record<string, unknown> = {}) {
	const line = JSON.stringify({ ts: new Date().toISOString(), id, step, ...data });
	appendFileSync(`${LOG_DIR}/log.jsonl`, line + "\n");
	console.log(line);
}

function herdr(...args: string[]): any {
	const out = execFileSync(HERDR, args, { encoding: "utf8", timeout: 60_000 });
	return out.trim() ? JSON.parse(out).result : null;
}

// launchd doesn't source zsh files; read the token the same way tfy-env does.
function tfyToken(): string {
	if (process.env.TFY_TOKEN) return process.env.TFY_TOKEN;
	const m = readFileSync(`${HOME}/.zshenv.local`, "utf8").match(/TFY_TOKEN=["']?([^"'\s]+)/);
	if (!m) throw new Error("TFY_TOKEN not found in ~/.zshenv.local");
	return m[1];
}

// Step 2: name the tab. Every capture lands in the Inbox workspace (GTD inbox);
// Nathan files it into a topic workspace himself.
async function tabLabel(text: string): Promise<string> {
	const prompt = `Name this task in 1-3 words, Title Case. Reply with only the name.\n\nTask:\n${text.slice(0, 4000)}`;
	const res = await fetch(TFY_URL, {
		method: "POST",
		headers: { authorization: `Bearer ${tfyToken()}`, "content-type": "application/json" },
		body: JSON.stringify({ model: MODEL, messages: [{ role: "user", content: prompt }] }),
		signal: AbortSignal.timeout(20_000),
	});
	if (!res.ok) throw new Error(`model ${res.status}: ${await res.text()}`);
	const name = String((await res.json()).choices[0].message.content).replace(/["'`*\n]/g, " ").trim();
	return name.slice(0, 40) || "Inbox Task";
}

type Shot = { path: string; app: string; window: string; always: boolean };

// Step 2b: does the prompt need the screenshot? Jev answers from the text and window context
// (it can't see images). "why is this failing?" → yes; "renew my passport next month" → no.
async function needsScreen(text: string, shot: Shot): Promise<number> {
	const res = await fetch(JEV_URL, {
		method: "POST",
		headers: { authorization: `Bearer ${tfyToken()}`, "content-type": "application/json" },
		body: JSON.stringify({
			model: "jev-latest",
			state: { prompt: text.slice(0, 8000), frontmost_app: shot.app, window_title: shot.window },
			questions: {
				screen: {
					type: "noul",
					instructions:
						"Nathan typed `prompt` into a quick-capture box that starts a new AI coding-agent session. When he pressed the capture key, `frontmost_app` was focused with the window `window_title`. Would the agent need a screenshot of his screen to understand or do what `prompt` asks?",
					criteria: {
						true: "The prompt points at something on screen (this, that, here, this page, this error, this message) or can't be done well without seeing it.",
						false: "The prompt is self-contained and makes sense without seeing the screen.",
					},
				},
			},
		}),
		signal: AbortSignal.timeout(10_000),
	});
	if (!res.ok) throw new Error(`jev ${res.status}: ${await res.text()}`);
	return (await res.json()).answers.screen.noul;
}

function withShot(text: string, shot: Shot): string {
	const where = [shot.app, shot.window].filter(Boolean).join(" — ");
	return `${text}\n\nScreenshot of my screen when I wrote this${where ? ` (${where})` : ""}; read it to view:\n${shot.path}`;
}

// Step 3: new tab in Inbox (created if missing, no focus), start pi in it, send the text.
function launch(id: string, text: string, label: string) {
	const inbox = herdr("workspace", "list").workspaces.find((w: any) => w.label.toLowerCase() === INBOX.toLowerCase());
	let pane: string;
	if (inbox) {
		pane = herdr("tab", "create", "--workspace", inbox.workspace_id, "--cwd", HOME, "--label", label, "--no-focus").root_pane.pane_id;
	} else {
		const w = herdr("workspace", "create", "--cwd", HOME, "--label", INBOX, "--no-focus");
		pane = w.root_pane.pane_id;
		herdr("tab", "rename", w.tab.tab_id, label);
	}
	log(id, "tab", { pane, label });

	const agent = `inbox-${id}`;
	herdr("agent", "start", agent, "--kind", "pi", "--pane", pane, "--timeout", "60000");
	log(id, "pi_started", { agent });

	herdr("agent", "prompt", agent, text);
	log(id, "sent");
}

async function attachDecision(id: string, text: string, shot: Shot | null): Promise<string> {
	if (!shot) return text;
	if (shot.always) {
		log(id, "screenshot", { attach: true, reason: "always" });
		return withShot(text, shot);
	}
	// On a Jev failure, attach: an unneeded screenshot costs less than a missing one.
	const p = await needsScreen(text, shot).catch(() => needsScreen(text, shot)).catch((e) => {
		log(id, "jev_failed", { error: String(e) });
		return 1;
	});
	const attach = p >= ATTACH_THRESHOLD;
	log(id, "screenshot", { attach, p, path: shot.path });
	return attach ? withShot(text, shot) : text;
}

async function handle(id: string, text: string, shot: Shot | null) {
	try {
		// One retry: the model gateway returns the occasional transient 502.
		const [label, prompt] = await Promise.all([
			tabLabel(text).catch(() => tabLabel(text)).catch((e) => {
				log(id, "label_failed", { error: String(e) });
				return "Inbox Task";
			}),
			attachDecision(id, text, shot),
		]);
		launch(id, prompt, label);
	} catch (e) {
		log(id, "failed", { error: String(e) });
	}
}

const PAGE = `<!doctype html><meta name=viewport content="width=device-width,initial-scale=1">
<title>ag inbox</title>
<style>body{font:16px system-ui;max-width:640px;margin:2rem auto;padding:0 1rem}textarea{width:100%;height:40vh;font:inherit}button{font:inherit;padding:.5rem 1.5rem;margin-top:.5rem}</style>
<form method=post action=/prompt><textarea name=text autofocus placeholder="prompt…"></textarea><br><button>Send</button></form>`;

const host = execFileSync("/usr/local/bin/tailscale", ["ip", "-4"], { encoding: "utf8" }).trim().split("\n")[0];

// Client ids accepted in the last day (rebuilt from the log so restarts don't forget them).
// Expiring matters: iOS may send the capture text itself as the id, and a repeat capture days later must go through.
const DEDUP_MS = 24 * 3600_000;
const seen = new Map<string, number>();
try {
	for (const l of readFileSync(`${LOG_DIR}/log.jsonl`, "utf8").split("\n")) {
		if (l.includes('"received"') && l.includes('"clientId"')) {
			const e = JSON.parse(l);
			if (e.clientId) seen.set(e.clientId, Date.parse(e.ts));
		}
	}
} catch {}

Bun.serve({
	hostname: host,
	maxRequestBodySize: 64 * 1024 * 1024,
	port: PORT,
	async fetch(req) {
		const url = new URL(req.url);
		if (req.method === "GET" && url.pathname === "/") return new Response(PAGE, { headers: { "content-type": "text/html" } });
		if (req.method !== "POST" || url.pathname !== "/prompt") return new Response("not found", { status: 404 });

		const type = req.headers.get("content-type") ?? "";
		// Forms (test page, Shortcuts, curl -F) carry a "text" field; anything else (curl -d) is the raw body.
		const form = type.includes("form") ? await req.formData() : null;
		const field = (k: string) => {
			const v = form?.get(k);
			return typeof v === "string" ? v.trim() : "";
		};
		const text = form ? field("text") : (await req.text()).trim();
		const clientId = field("id") || null;
		if (!text) return new Response("empty", { status: 400 });

		if (clientId && Date.now() - (seen.get(clientId) ?? 0) < DEDUP_MS) {
			log("dup", "duplicate", { clientId });
			return new Response(null, { status: 202 });
		}
		if (clientId) seen.set(clientId, Date.now());
		const id = crypto.randomUUID().slice(0, 8);
		const file = form?.get("screenshot");
		let shot: Shot | null = null;
		if (file instanceof File && file.size) {
			const ext = file.type === "image/jpeg" ? "jpg" : "png";
			const path = `${CAPTURE_DIR}/${new Date().toISOString().replace(/[:.]/g, "-").slice(0, 19)}-${id}.${ext}`;
			writeFileSync(path, Buffer.from(await file.arrayBuffer()));
			shot = { path, app: field("app"), window: field("window"), always: field("attach") === "always" };
		}
		log(id, "received", { chars: text.length, text, clientId, screenshot: shot?.path });
		void handle(id, text, shot);
		// Send-only: no result. The form just lands back on a blank page.
		return type.includes("form") ? new Response(null, { status: 303, headers: { location: "/" } }) : new Response(null, { status: 202 });
	},
});
console.log(`ag-inbox listening on http://${host}:${PORT}`);
