#!/usr/bin/env bash
# ag-t3-update: put the T3 Code server (ag-t3.service, docs/t3.md) on upstream's newest nightly, or a given version.
# Upstream's standalone runtime, installed the way https://t3.codes/install.sh does it, into
# ~/.t3/runtime/versions/<version>; ~/.local/bin/t3 is the launcher the service runs.
#
#   ag-t3-update [--version V] [--backup] [--now]
#     --version V   install V instead of the newest nightly (npm dist-tag `nightly`)
#     --backup      stop the server and copy its database to ~/.t3/backups/ before switching (rollback point)
#     --now         restart even while turns are running (default: wait up to 3 h for them to finish)
#   ag-t3-update --status
#
# Restarting the server cancels running turns, so it waits until none is running. If the new version isn't healthy
# within 2 minutes, it restores the previous launcher (and, with --backup, the database) and exits 1.
set -euo pipefail
LIVE=${T3_HOME:-$HOME/.t3}
BIN=$HOME/.local/bin/t3
UNIT=ag-t3.service
PORT=3773
LOG=$LIVE/ag-t3-update.jsonl
KEEP=3
say() { printf '▸ %s\n' "$*" >&2; }
record() { printf '{"ts":"%s","version":"%s","result":"%s","note":%s}\n' "$(date -u +%FT%TZ)" "${VER:-}" "$1" "$(jq -Rn --arg s "${2:-}" '$s')" >>"$LOG"; }
die() { say "ag-t3-update: $*"; record fail "$*"; exit 1; }
running_version() { curl -fsS -m 3 "http://127.0.0.1:$PORT/.well-known/t3/environment" 2>/dev/null | jq -r '.serverVersion // empty' 2>/dev/null || true; }
healthy() { for _ in $(seq 60); do [[ $(running_version) == "$1" ]] && return 0; sleep 2; done; return 1; }
busy() { # a turn is running (a failed read counts as busy)
	local n
	n=$(python3 - "$LIVE/userdata/statev2.sqlite" 2>/dev/null <<'PY'
import sqlite3, sys
db = sqlite3.connect(f"file:{sys.argv[1]}?mode=ro", uri=True, timeout=60)
print(db.execute("select count(*) from orchestration_v2_projection_runs where status in ('preparing','starting','running','waiting')").fetchone()[0])
PY
	) || return 0
	[[ $n != 0 ]]
}

VER="" BACKUP=0 NOW=0
while (($#)); do case $1 in
	--version) VER=$2; shift ;;
	--backup) BACKUP=1 ;;
	--now) NOW=1 ;;
	--status) echo "running: $(running_version)"; echo "launcher: $(cat "$BIN" 2>/dev/null | tail -1)"; tail -n 5 "$LOG" 2>/dev/null || true; exit 0 ;;
	*) sed -n '2,14p' "$0"; exit 2 ;;
esac; shift; done

exec 9>"$LIVE/.ag-t3-update.lock"; flock -n 9 || { say "another ag-t3-update is running"; exit 1; }
VER=${VER:-$(npm view t3@nightly version 2>/dev/null)}
[[ -n $VER ]] || die "couldn't resolve the newest nightly (npm view t3@nightly version)"
CUR=$(running_version)
if [[ $CUR == "$VER" ]] && grep -qF "/runtime/versions/$VER/" "$BIN" 2>/dev/null; then echo "up to date: $VER"; exit 0; fi

# 1. Install the runtime next to the running one (the installer writes its launcher into a scratch dir, not $BIN).
RUNTIME=$LIVE/runtime/versions/$VER/t3
if [[ ! -x $RUNTIME ]]; then
	say "install T3 Code $VER"
	scratch=$(mktemp -d)
	curl -fsSL https://t3.codes/install.sh | T3CODE_VERSION=$VER T3CODE_HOME=$LIVE T3CODE_INSTALL_BIN_DIR=$scratch sh >/dev/null 2>&1 || { rm -rf "$scratch"; die "install.sh failed for $VER"; }
	rm -rf "$scratch"
fi
[[ -x $RUNTIME ]] || die "no runtime at $RUNTIME after install"

# 2. Wait for running turns to finish (up to 3 h, then restart anyway, like ag/ship did).
if ((!NOW)) && busy; then
	say "turns are running: waiting for them to finish"
	for _ in $(seq 2160); do busy || break; sleep 5; done
fi

# 3. Switch the launcher, restart, health-check; restore the previous launcher (and database) on failure.
prev=$(mktemp); cp -p "$BIN" "$prev" 2>/dev/null || : >"$prev"
backup=""
if ((BACKUP)); then
	backup=$LIVE/backups/statev2-before-$VER-$(date +%Y%m%d%H%M%S)
	mkdir -p "$backup"
	say "stop the server and back up its database to $backup"
	systemctl --user stop "$UNIT"
	cp -p "$LIVE"/userdata/statev2.sqlite* "$backup"/ || die "database backup failed (server stopped; start it with: systemctl --user start $UNIT)"
fi
rm -f "$BIN"
printf "#!/bin/sh\n# Generated by ag-t3-update (docs/t3.md): upstream T3 Code %s.\nexec '%s' \"\$@\"\n" "$VER" "$RUNTIME" >"$BIN"
chmod +x "$BIN"
say "restart $UNIT on $VER"
systemctl --user restart "$UNIT"
if ! healthy "$VER"; then
	journalctl --user -u "$UNIT" -n 40 --no-pager >&2 || true
	say "unhealthy: restoring the previous launcher${backup:+ and database}"
	systemctl --user stop "$UNIT"
	if [[ -s $prev ]]; then cp -p "$prev" "$BIN"; fi
	if [[ -n $backup ]]; then rm -f "$LIVE"/userdata/statev2.sqlite-wal "$LIVE"/userdata/statev2.sqlite-shm; cp -p "$backup"/statev2.sqlite* "$LIVE"/userdata/; fi
	systemctl --user start "$UNIT"
	rm -f "$prev"
	die "$VER didn't come up healthy; rolled back to ${CUR:-the previous launcher}"
fi
rm -f "$prev"

# 4. Prune old runtimes (keep the newest $KEEP and the running one).
for old in $(ls -1t "$LIVE/runtime/versions" | tail -n +$((KEEP + 1))); do
	[[ $old == "$VER" ]] || rm -rf "${LIVE:?}/runtime/versions/$old"
done
record ok "${CUR:-?} -> $VER${backup:+ (backup $backup)}"
echo "T3 Code $VER is live (was ${CUR:-?})"
