# Herdr (herdr.dev): the persistent default session that `ag herdr` and Moshi's session picker attach to.
# Session host only. Under systemd its panes survive SSH logouts, T3 and agent restarts, and reboots (linger);
# `herdr server stop` ends it until the next boot or `systemctl --user start herdr`. docs/reference.md, "Herdr".
[Unit]
Description=Herdr server (default session)
Documentation=https://herdr.dev/tui/docs/persistence-remote/

[Service]
ExecCondition=%h/.local/bin/ag-machine-role host
ExecStart=%h/.local/bin/herdr server
# A clean exit (herdr server stop) stays stopped; a crash restarts it, and Herdr restores the session's layout.
Restart=on-failure
RestartSec=2
# Stopping sends SIGTERM to the server alone, so it closes its own panes; leftovers get SIGKILL once it exits.
KillMode=mixed
# Every pane runs in this unit's cgroup, so cap them together (tmux panes get one cap each, tmux-spawn-.scope.d):
# a runaway type-check is throttled and OOM-killed in here instead of exhausting the whole engine.
MemoryHigh=20G
MemoryMax=28G
WorkingDirectory=%h
# Panes inherit this PATH; zsh's ~/.zshenv adds the rest.
Environment=PATH=%h/.local/bin:%h/.bun/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
