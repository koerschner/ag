#!/bin/sh
# session-link: print a phone link that opens this pi session in Moshi (iPhone).
# Served by file-inbox (GET /m/<session id>), which finds the session's current Herdr
# pane at tap time and redirects to moshi://herdr?workspace&tab&pane.
# Usage: session-link [pi session file]   (default: $PI_SESSION_FILE)
set -eu
f=${1:-${PI_SESSION_FILE:?not in a pi session; pass a session file}}
id=$(basename "$f" .jsonl | sed 's/.*_//')
ip=$(/Applications/Tailscale.app/Contents/MacOS/Tailscale ip -4 2>/dev/null || echo 100.107.192.32)
echo "http://$ip:7374/m/$id"
