{
  "settings": {
    "toolPrefix": "mcp",
    "requestTimeoutMs": 30000,
    "maxRetries": 5
  },
  "mcpServers": {
    "linear": {
      "transport": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "export MCP_REMOTE_CONFIG_DIR=\"$HOME/.local/share/arcade-linear-return/mcp-destination\"; exec npx -y mcp-remote@0.14.3 https://mcp.linear.app/mcp --transport http-only --static-oauth-client-metadata \"@$HOME/.local/share/arcade-linear-return/mcp-destination/client-metadata.json\""
      ],
      "lifecycle": "eager"
    },
    "arcade_school": {
      "transport": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "exec \"$HOME/.bun/bin/bunx\" --bun mcp-remote@0.8.3 https://api.texassportsacademy.com/mcp --transport http-only --header-file \"$HOME/.config/mcp/arcade-school.headers\" --silent"
      ],
      "lifecycle": "eager"
    },
    "honeycomb": {
      "transport": "stdio",
      "command": "bunx",
      "args": [
        "--bun",
        "mcp-remote@0.8.3",
        "https://mcp.honeycomb.io/mcp"
      ],
      "lifecycle": "eager"
    },
    "slack": {
      "transport": "streamable-http",
      "url": "https://mcp.slack.com/mcp",
      "auth": {
        "type": "oauth",
        "clientId": "8722850230503.12095494058659",
        "redirectUrl": "http://localhost:19876/callback",
        "scope": "search:read.public search:read.private search:read.mpim search:read.im search:read.users search:read.files channels:history groups:history im:history mpim:history channels:read groups:read im:read mpim:read users:read users:read.email files:read chat:write"
      },
      "lifecycle": "eager"
    },
    "tsa_courses": {
      "transport": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "exec \"$HOME/.bun/bin/bunx\" --bun mcp-remote@0.8.3 https://api.texassportsacademy.com/api/courses-mcp --transport http-only --header-file \"$HOME/.config/mcp/tsa-courses.headers\" --silent"
      ],
      "lifecycle": "eager"
    }
  }
}
