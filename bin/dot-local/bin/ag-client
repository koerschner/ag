#!/usr/bin/env bash
# ag-client: reach the client Mac (the one the user sits at) from the engine for plain CLI work.
# Use it for client-only files and devices: ag-client-cua's files under /tmp, a YubiKey over USB
# (ykman), T3 or Hammerspoon logs. Prefer ag-engine or ag-mac (ag-mac run) when the work can run there.
#
#   ag-client run <cmd...>           run a shell command on the client in a login shell (Homebrew on PATH;
#                                    exit code and stdin pass through). One argument = a shell snippet;
#                                    several = argv, quoted for the remote shell.
#                                    Never for driving the screen: that's `ag cua --client --why "…"`.
#   ag-client push <local> [remote]  copy a file/dir to the client. remote ending in / or an existing dir:
#                                    into it (default ~/inbox/from-engine/); otherwise exactly that path
#   ag-client pull <remote> [local]  copy a file/dir from the client, same rules (default: into ./)
#   ag-client status                 is the client reachable, and is the user at it (ag-presence)?
#
# Host: SSH alias `ag-client`; set CLIENT_HOST (or CLIENT_CUA_HOST, as ag cua does) for another client.
set -euo pipefail
HOST=${CLIENT_HOST:-${CLIENT_CUA_HOST:-ag-client}}
SSH=(ssh -o ConnectTimeout=10 -o BatchMode=yes)
q() { printf '%q ' "$@"; }
# Plain ssh gets no login env on macOS (no Homebrew on PATH), so run everything in the user's login shell.
ssh_() { "${SSH[@]}" "$HOST" "exec \"\${SHELL:-/bin/zsh}\" -lc $(q "$1")"; }
rsync_() { rsync -az -e "${SSH[*]}" "$@"; }
usage() { sed -n '2,15p' "$0"; }
source "$(dirname "$(readlink -f "$0")")/../lib/ag-remote-copy.sh" # remote_push, remote_pull

cmd=${1:-help}; shift || true
[[ ${1:-} == -h || ${1:-} == --help ]] && { usage; exit 0; }
case $cmd in
  run)
    [[ $# -gt 0 ]] || { echo "usage: ag-client run <cmd...>" >&2; exit 2; }
    if [[ $# -eq 1 ]]; then ssh_ "$1"; else ssh_ "$(q "$@")"; fi ;;
  push) remote_push "$@" ;;
  pull) remote_pull "$@" ;;
  status)
    if "${SSH[@]}" "$HOST" true 2>/dev/null; then echo "$HOST: reachable"
    else echo "$HOST: UNREACHABLE"; rc=1; fi
    ag-presence 2>/dev/null | tail -1 || true
    exit ${rc:-0} ;;
  *) usage; [[ $cmd == help || $cmd == -h || $cmd == --help ]] || exit 2 ;;
esac
