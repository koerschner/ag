<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nathan.file-inbox</string>
  <!-- File inbox on ag: phone uploads → ~/inbox/phone. Only runs on ag. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>[[ $(scutil --get LocalHostName) == ag ]] || { sleep 3600; exit 0; }; exec "$HOME/.local/bin/file-inbox"</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!-- Restarts it if it dies, e.g. Tailscale wasn't up yet at login. -->
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>15</integer>
  <key>StandardOutPath</key>
  <string>/tmp/file-inbox.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/file-inbox.log</string>
</dict>
</plist>
