// Tailscale policy for tailnet nathankoerschner@gmail.com (tail44736d.ts.net).
// Source of truth: ag repo tailscale/policy.hujson. Apply with `tailscale/apply-policy`
// (needs the "Tailscale OAuth client (ag)" item in ag-vault via op-work). Don't edit it in the admin console.
{
	// Ag machines join with auth keys minted for these tags (see tailscale/README.md).
	"tagOwners": {
		// The OAuth client "ag IaC and auth key minting" carries these tags, and keys it mints are owned
		// by them, so the tags must own themselves for new machines to be allowed to advertise them.
		"tag:ag-engine":  ["autogroup:admin", "tag:ag-engine", "tag:ag-worker"],
		"tag:ag-worker": ["autogroup:admin", "tag:ag-engine", "tag:ag-worker"],
	},

	"grants": [
		// Nathan's own devices (ag-mac, the client Mac, the phone) reach everything.
		{"src": ["autogroup:member"], "dst": ["*"], "ip": ["*"]},
		// The engine drives everything too: ag-mac for computer use, workers, Nathan's devices.
		{"src": ["tag:ag-engine"], "dst": ["*"], "ip": ["*"]},
		// Workers only talk to the engine and each other, never to Nathan's personal devices.
		{"src": ["tag:ag-worker"], "dst": ["tag:ag-engine", "tag:ag-worker"], "ip": ["*"]},
	],

	"ssh": [
		// Nathan's devices (including ag) SSH into Ag machines with no browser check,
		// so scripts and Herdr can connect unattended.
		{
			"action": "accept",
			"src":    ["autogroup:member"],
			"dst":    ["tag:ag-engine", "tag:ag-worker"],
			"users":  ["autogroup:nonroot", "root"],
		},
		// The engine SSHes into workers it spins up.
		{
			"action": "accept",
			"src":    ["tag:ag-engine"],
			"dst":    ["tag:ag-worker"],
			"users":  ["autogroup:nonroot", "root"],
		},
		// Default: members SSH into their own devices in check mode.
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],

	// Tailscale Service `svc:ag` (ag.tail44736d.ts.net, short name `ag`): Ag's machine-independent address
	// for AG Dash, the inbox, show/phone review and the private chat. Whichever machine hosts sessions
	// advertises it (ag-engine; until the move it forwards to ag-mac). See docs/tmux-port.md.
	"autoApprovers": {
		"services": {
			"svc:ag": ["tag:ag-engine"],
		},
	},

	"nodeAttrs": [
		{
			// Funnel for Nathan's own devices.
			"target": ["autogroup:member"],
			"attr":   ["funnel"],
		},
	],

	"tests": [
		{"src": "nathankoerschner@gmail.com", "accept": ["tag:ag-engine:22", "tag:ag-worker:22"]},
		{"src": "tag:ag-engine", "accept": ["tag:ag-worker:22", "nathankoerschner@gmail.com:22"]},
		{"src": "tag:ag-worker", "accept": ["tag:ag-engine:22"], "deny": ["nathankoerschner@gmail.com:22"]},
	],
	"sshTests": [
		{"src": "nathankoerschner@gmail.com", "dst": ["tag:ag-engine", "tag:ag-worker"], "accept": ["root", "natkoersch"]},
		{"src": "tag:ag-engine", "dst": ["tag:ag-worker"], "accept": ["root"]},
	],
}
