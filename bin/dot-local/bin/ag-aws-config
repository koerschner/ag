#!/usr/bin/env bash
# Writes ~/.aws/config on EC2 Ag machines: [default] and the profile named by AG_AWS_PROFILE
# (~/ag-personal/env) get the instance role through ag-aws-instance-role, so tools that disable the
# SDK's metadata lookup (AWS_EC2_METADATA_DISABLED=true) still sign in. Region only, no keys.
# Does nothing off EC2. Run by bootstrap-linux; safe to rerun.
set -euo pipefail
curl -fsS --max-time 2 -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 10' \
  http://169.254.169.254/latest/api/token >/dev/null 2>&1 || { echo "  not on EC2, ~/.aws/config left alone"; exit 0; }
profile=$(sed -n 's/^AG_AWS_PROFILE=//p' ~/ag-personal/env 2>/dev/null | tail -n 1)
region=${AWS_DEFAULT_REGION:-us-east-1}
cp="credential_process = $HOME/.local/bin/ag-aws-instance-role"
mkdir -p ~/.aws && chmod 700 ~/.aws
{
  echo "# Generated by ag-aws-config (ag repo). No keys: credentials come from the EC2 instance role"
  echo "# via instance metadata, through credential_process. Edit bin/dot-local/bin/ag-aws-config instead."
  printf '[default]\nregion = %s\noutput = json\n%s\n' "$region" "$cp"
  [ -z "$profile" ] || [ "$profile" = default ] || printf '\n[profile %s]\nregion = %s\noutput = json\n%s\n' "$profile" "$region" "$cp"
} >~/.aws/config.tmp
mv ~/.aws/config.tmp ~/.aws/config
echo "  ~/.aws/config: default${profile:+ + $profile} -> instance role"
