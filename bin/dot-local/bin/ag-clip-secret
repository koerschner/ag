#!/usr/bin/env zsh
# ag-clip-secret — save the clipboard into a 1Password field on ag-mac, then clear the clipboard,
# without the secret ever appearing in a prompt, transcript, log, argument, or screenshot report.
#
#   ag-clip-secret [--text] op://<vault>/<item>/<field>
#
# For keys a site shows once (API keys, client secrets, bearer tokens). Use it from INSIDE a
# computer-use run: put it in the `ag cua` task ("click the Copy button next to the Client Secret,
# then run `ag-clip-secret 'op://ag-vault/X API - ag app/client_secret'`"). Creates the item
# (category API Credential) if it doesn't exist and adds or replaces the field: concealed, or plain
# text with --text (for ids that aren't secret). Vault machine-shared → op-shared, ag-vault → op-work,
# anything else → op-ag. Item names can't contain "/". Prints only the field and how many characters
# it stored. The counterpart for typing a secret into a field is ag-type-secret.
set -uo pipefail
setopt extendedglob
type=CONCEALED
case ${1:-} in
  -h|--help) awk 'NR>1 && /^set -uo/{exit} NR>1' $0; exit 0 ;;
  --text) type=STRING; shift ;;
esac
ref=${1:?usage: ag-clip-secret [--text] op://vault/item/field}
rest=${ref#op://}
vault=${rest%%/*} rest=${rest#*/}
item=${rest%/*} field=${rest##*/}
[[ $ref == op://*/*/* && -n $vault && -n $item && -n $field && $item != */* ]] ||
  { print -u2 "ag-clip-secret: expected op://vault/item/field"; exit 2; }
case $vault in
  machine-shared) op=op-shared ;;
  ag-vault) op=op-work ;;
  *) op=op-ag ;;
esac
command -v pbpaste >/dev/null || { print -u2 "ag-clip-secret: needs pbpaste (run it on ag-mac)"; exit 3; }
secret=$(pbpaste)
secret=${secret##[[:space:]]#} secret=${secret%%[[:space:]]#}
(( ${#secret} )) || { print -u2 "ag-clip-secret: the clipboard is empty; nothing stored"; exit 4; }
tmp=$(mktemp -d) && chmod 700 $tmp || exit 5
trap 'rm -rf $tmp' EXIT
if $op item get "$item" --vault "$vault" --format json </dev/null >$tmp/item.json 2>$tmp/err; then
  print -rn -- "$secret" | jq --rawfile v /dev/stdin --arg f "$field" --arg t "$type" \
    '.fields = ((.fields // []) | map(select(.label != $f))) + [{label: $f, type: $t, value: $v}]' \
    $tmp/item.json >$tmp/new.json &&
    $op item edit "$item" --vault "$vault" --template $tmp/new.json </dev/null >/dev/null ||
    { print -u2 "ag-clip-secret: could not update '$item'"; exit 6; }
elif grep -q "isn't an item" $tmp/err; then
  print -rn -- "$secret" | jq -n --rawfile v /dev/stdin --arg title "$item" --arg f "$field" --arg t "$type" \
    '{title: $title, category: "API_CREDENTIAL", fields: [{label: $f, type: $t, value: $v}]}' |
    $op item create --vault "$vault" - >/dev/null ||
    { print -u2 "ag-clip-secret: could not create '$item'"; exit 6; }
else
  print -u2 "ag-clip-secret: could not read '$item': $(head -c 300 $tmp/err)"; exit 6
fi
print -n '' | pbcopy
print "ag-clip-secret: stored $field (${#secret} chars) in $vault/$item; clipboard cleared"
