# Shared MCP bridges for every Pi session (127.0.0.1:7381-7385). Runs on the session host only (machines/README.md role host); ported from macos-launchagents.
[Unit]
Description=Shared MCP bridges for every Pi session (127.0.0.1:7381-7385)
After=network-online.target ag-mux.service

[Service]
ExecCondition=%h/.local/bin/ag-machine-role host
ExecStart=/usr/bin/zsh -lc 'exec %h/.local/bin/ag-mcp-gateway'
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
