#!/usr/bin/env python3
"""ag close — close a session's tab (default: this one; the session file stays, ag resume reopens it).

    ag close [session] [--after N] [--pane]
Closing your own tab runs detached after N seconds (default 2), so this call returns first. In a tab with
several panes it closes only the session's pane unless the tab has just that one, or you passed the tab id.
Works on any tab or pane, agent or not (a dev server or watcher tab you opened).
"""
import os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from aglib import *


def main(argv):
    o, pos = flags(argv, {"--after": True, "--pane": False})
    if o.get("--help"):
        return usage(__doc__)
    ix = Index()
    s = resolve(" ".join(pos) or None, ix)
    if s.state == "closed":
        print(f"{s.title} is already closed")
        return 0
    me = None
    try:
        me = self_session(ix)
    except AgError:
        pass
    mine = me is not None and me.tab == s.tab
    # A tab id closes the whole tab; a session or pane id in a shared tab closes just that pane.
    pane_only = o.get("--pane") or (s.pane_count > 1 and s.by != "tab")
    cmd = [AG_MUX, "pane" if pane_only else "tab", "close", s.pane if pane_only else s.tab]
    after = float(o["--after"]) if o.get("--after") else (2 if mine else 0)
    what = f"{'pane ' + s.pane + ' of ' if pane_only else ''}{s.title} ({s.tab})"
    if after > 0:
        detach(f"sleep {after}; {' '.join(shq(c) for c in cmd)}")
        print(f"closing {what} in {after:g}s  {s.link or ''}")
    else:
        mux(*cmd[1:])
        print(f"closed {what}  {s.link or ''}")


run_main(main)
