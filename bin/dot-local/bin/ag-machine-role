#!/bin/zsh
# Print this machine's role ("host", "extremity", "client") from machines/README.md, matched
# by LocalHostName (a row may list several, comma-separated, e.g. during a rename).
# Unlisted machines count as clients.
#   ag-machine-role            # -> host | client
#   ag-machine-role host && …  # exit 0 if this machine has that role (several roles: any of them)
# host = runs Ag's sessions and services; extremity = the always-on Mac Ag drives (computer use,
# Mac-only apps); client = where the user sits.
repo=${0:A:h:h:h:h}
inv=~/ag-personal/machines.md; [[ -f $inv ]] || inv=$repo/machines/README.md  # private inventory first
name=$(scutil --get LocalHostName 2>/dev/null || hostname -s)
role=$(awk -F'|' -v n="$name" '{gsub(/[ `]/,"",$3); gsub(/ /,"",$4); k=split($3,names,","); for (i=1;i<=k;i++) if (names[i]==n) {print $4; exit}}' "$inv")
role=${role:-client}
if (( $# )); then (( ${@[(Ie)$role]} )); else print $role; fi
