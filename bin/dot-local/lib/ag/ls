#!/usr/bin/env python3
"""ag ls — list open sessions (AG Dash's cards), grouped by workspace.

    ag ls [workspace] [--hot] [--waiting] [--needs-you] [--working] [--json]
    workspace: id or label (prefix ok). Filters combine with OR.
Columns: tab, state (🔥 hot, ⏳ waiting, ❗ needs you, 💤 hibernated), title, last activity, AG Dash link.
"""
import json, os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from aglib import *


def main(argv):
    o, pos = flags(argv, {"--hot": False, "--waiting": False, "--needs-you": False, "--working": False, "--json": False})
    if o.get("--help"):
        return usage(__doc__)
    ix = Index()
    if ix.board is None:
        raise AgError("AG Dash (ag-board) is unreachable")
    ws = workspace_id(" ".join(pos), ix) if pos else None
    asleep = {p["tab_id"] for p in ix.panes.values() if p.get("sleeping_session")}
    want = [k for k in ("--hot", "--waiting", "--needs-you", "--working") if o.get(k)]
    test = {"--hot": lambda c: c.get("hot"), "--waiting": lambda c: c.get("waiting"),
            "--needs-you": lambda c: c.get("needsYou") and not c.get("waiting"), "--working": lambda c: c.get("status") == "working"}
    rows = []
    for c in ix.board["cards"]:
        if ws and c["workspace"] != ws:
            continue
        if want and not any(test[k](c) for k in want):
            continue
        last = max([(c.get(k) or {}).get("ts", 0) for k in ("lastUser", "lastAssistant")] + [c.get("statusSince") or 0]) / 1000
        rows.append({"tab": c["tab"], "workspace": c["workspaceLabel"], "title": c["title"], "status": c["status"],
                     "hot": c.get("hot"), "waiting": [w.get("title") for w in c.get("waiting") or []], "needs_you": c.get("needsYou"),
                     "hibernated": c["tab"] in asleep, "sid": c.get("sid"), "link": link(c["sid"]) if c.get("sid") else None, "last": last})
    if o.get("--json"):
        print(json.dumps(rows, ensure_ascii=False, indent=1))
        return 0
    order = [w["id"] for w in ix.board["workspaces"]]
    rows.sort(key=lambda r: (order.index(next((w["id"] for w in ix.board["workspaces"] if w["label"] == r["workspace"]), order[0])) if order else 0, -r["last"]))
    cur = None
    for r in rows:
        if r["workspace"] != cur:
            cur = r["workspace"]
            print(f"{'' if cur == rows[0]['workspace'] else chr(10)}{cur}")
        flags_ = ("🔥" if r["hot"] else "") + ("⏳" if r["waiting"] else "") + ("❗" if r["needs_you"] and not r["waiting"] else "") + ("💤" if r["hibernated"] else "")
        st = "working" if r["status"] == "working" else flags_ or r["status"]
        pad = 8 - sum(2 if ord(ch) > 0x2000 else 1 for ch in st)
        print(f"  {r['tab']:<9} {st}{' ' * max(pad, 1)} {clip(r['title'], 44):<44} {ago(r['last']):>8}  {r['link'] or ''}")
    if not rows:
        print("(none)", file=sys.stderr)


run_main(main)
