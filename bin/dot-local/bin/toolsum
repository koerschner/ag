#!/usr/bin/env bun
// toolsum: check and measure the deterministic tool-call summaries AG Dash shows (library: ~/ag/toolsum/toolsum.ts).
//
//   toolsum check                 run the fixtures (~/ag/toolsum/fixtures.json); exit 1 on any mismatch
//   toolsum coverage [--days N] [--json] [--top K]
//                                 summarise every tool call in Pi sessions from the last N days (default 7) and
//                                 report how many got a summary, per tool, plus the most common unmatched shapes
//   toolsum try <tool> '<json args>' [--host ag-engine]
//   toolsum sh '<shell command>'   shorthand for try bash
//   toolsum sample [--days N] [--n K]  print K random summarised calls (raw → summary) to eyeball quality
//
// The toolsum-review routine (systemd timer) runs `coverage --json` daily and, when there are new gaps, has an
// agent extend the rules; see ~/ag/toolsum/README.md.

import { readdirSync, readFileSync, statSync } from "node:fs";
import { homedir } from "node:os";
import { join } from "node:path";
import { sessionHost, summarize } from "../../../toolsum/toolsum.ts";

const HOME = homedir();
const FIXTURES = join(import.meta.dir, "../../../toolsum/fixtures.json");
const argv = process.argv.slice(2);
const opt = (name: string, def: string) => {
	const i = argv.indexOf(name);
	return i >= 0 ? argv[i + 1] : def;
};

type Call = { name: string; args: any; host: string; file: string };
function* calls(days: number): Generator<Call> {
	const root = join(HOME, ".pi/agent/sessions");
	const since = Date.now() - days * 86_400_000;
	for (const d of readdirSync(root)) {
		let files: string[];
		try {
			files = readdirSync(join(root, d));
		} catch {
			continue;
		}
		for (const f of files) {
			if (!f.endsWith(".jsonl")) continue;
			const path = join(root, d, f);
			if (statSync(path).mtimeMs < since) continue;
			let host = "ag-engine";
			for (const line of readFileSync(path, "utf8").split("\n")) {
				if (!line || line.length > 512 * 1024) continue;
				if (line.includes('"type":"session"')) {
					try { host = sessionHost(JSON.parse(line).cwd); } catch {}
					continue;
				}
				if (!line.includes('"toolCall"')) continue;
				let e: any;
				try { e = JSON.parse(line); } catch { continue; }
				const ts = Date.parse(e.timestamp);
				if (ts && ts < since) continue;
				for (const c of e.message?.content ?? []) if (c.type === "toolCall") yield { name: c.name, args: c.arguments, host, file: path };
			}
		}
	}
}

const shape = (miss: string) => {
	const w = miss
		.replace(/^\|\s*/, "| ")
		.replace(/^((?:\|\s)?)(?:(?:[A-Za-z_]\w*=\S*|timeout\s+(?:-\S+\s+)*\d+\S*|time|nohup|sudo|exec)\s+)+/, "$1")
		.trim()
		.split(/\s+/);
	const head = w[0] === "|" ? `| ${w[1] ?? ""}` : w[0];
	const sub = w[0] === "|" ? "" : w[1] && /^[a-z][\w-]*$/.test(w[1]) && ["git", "gh", "mac", "herdr", "ag-mux", "bun", "op-ag", "systemctl", "launchctl", "npm", "docker"].includes(w[0]) ? ` ${w[1]}` : "";
	return (head + sub).slice(0, 60);
};

const cmd = argv[0];
if (cmd === "check") {
	const fx: { tool: string; args: any; host?: string; sum: string | null; hosts?: string[] }[] = JSON.parse(readFileSync(FIXTURES, "utf8"));
	let bad = 0;
	for (const f of fx) {
		const r = summarize(f.tool, f.args, { host: f.host ?? "ag-engine" });
		const okSum = (r.sum ?? null) === f.sum;
		const okHosts = !f.hosts || JSON.stringify(r.hosts) === JSON.stringify(f.hosts);
		if (!okSum || !okHosts) {
			bad++;
			console.log(`✗ ${f.tool} ${JSON.stringify(f.args).slice(0, 160)}\n    want ${JSON.stringify(f.sum)} ${f.hosts ? JSON.stringify(f.hosts) : ""}\n    got  ${JSON.stringify(r.sum ?? null)} ${JSON.stringify(r.hosts)}${r.miss ? ` (miss: ${r.miss.slice(0, 80)})` : ""}`);
		}
	}
	console.log(`${fx.length - bad}/${fx.length} fixtures pass`);
	process.exit(bad ? 1 : 0);
} else if (cmd === "coverage") {
	const days = Number(opt("--days", "7"));
	const top = Number(opt("--top", "40"));
	const per = new Map<string, { n: number; ok: number }>();
	const misses = new Map<string, { n: number; ex: string[] }>();
	let n = 0;
	let ok = 0;
	for (const c of calls(days)) {
		const r = summarize(c.name, c.args, { host: c.host });
		const tool = c.name.startsWith("mcp_") ? "mcp" : c.name;
		const p = per.get(tool) ?? { n: 0, ok: 0 };
		p.n++;
		n++;
		if (r.sum) (p.ok++, ok++);
		per.set(tool, p);
		if (!r.sum) {
			const key = c.name === "bash" ? (r.miss ? shape(r.miss) : "(empty)") : c.name;
			const m = misses.get(key) ?? { n: 0, ex: [] };
			m.n++;
			if (m.ex.length < 3) m.ex.push(String(c.name === "bash" ? r.miss ?? c.args?.command : JSON.stringify(c.args)).replace(/\s+/g, " ").slice(0, 200));
			misses.set(key, m);
		}
	}
	const tools = [...per].sort((a, b) => b[1].n - a[1].n).map(([tool, p]) => ({ tool, calls: p.n, summarised: p.ok, pct: Math.round((1000 * p.ok) / p.n) / 10 }));
	const gaps = [...misses].sort((a, b) => b[1].n - a[1].n).slice(0, top).map(([shape, m]) => ({ shape, calls: m.n, examples: m.ex }));
	const report = { days, calls: n, summarised: ok, pct: n ? Math.round((1000 * ok) / n) / 10 : 0, tools, gaps };
	if (argv.includes("--json")) console.log(JSON.stringify(report, null, 1));
	else {
		console.log(`${ok}/${n} tool calls summarised (${report.pct}%) over the last ${days} days\n`);
		for (const t of tools.slice(0, 15)) console.log(`  ${t.tool.padEnd(14)} ${String(t.summarised).padStart(6)}/${String(t.calls).padEnd(6)} ${t.pct}%`);
		console.log("\nTop unmatched shapes:");
		for (const g of gaps) console.log(`  ${String(g.calls).padStart(5)}  ${g.shape}\n         e.g. ${g.examples[0]}`);
	}
} else if (cmd === "try" || cmd === "sh") {
	const tool = cmd === "sh" ? "bash" : argv[1];
	const args = cmd === "sh" ? { command: argv[1] } : JSON.parse(argv[2] ?? "{}");
	console.log(JSON.stringify(summarize(tool, args, { host: opt("--host", "ag-engine") }), null, 1));
} else if (cmd === "sample") {
	const all = [...calls(Number(opt("--days", "3")))];
	const k = Number(opt("--n", "40"));
	for (let i = 0; i < k && all.length; i++) {
		const c = all.splice(Math.floor(Math.random() * all.length), 1)[0];
		const r = summarize(c.name, c.args, { host: c.host });
		const raw = c.name === "bash" ? String(c.args?.command).split("\n")[0] : JSON.stringify(c.args);
		console.log(`${r.sum ? "✓" : "·"} [${r.hosts.join(",")}] ${c.name}: ${r.sum ?? "—"}\n      ${raw.replace(/\s+/g, " ").slice(0, 150)}`);
	}
} else {
	console.log(readFileSync(import.meta.path, "utf8").split("\n").filter((l) => l.startsWith("//")).map((l) => l.slice(3)).join("\n"));
}
