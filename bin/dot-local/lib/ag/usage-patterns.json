[
  {"id": "self-lookup", "verb": "me", "re": "ag-mux pane list.*(agent_session|PI_SESSION_FILE)", "what": "find my own pane/tab from pane list + jq"},
  {"id": "stale-self-env", "verb": "me", "re": "\\$\\{?AG_TAB_ID", "what": "trust $AG_TAB_ID (stale after a pane move)"},
  {"id": "tab-by-label", "verb": "ls", "re": "ag-mux tab list[^|\\n]*\\|[^\\n]*\\.label", "what": "find a tab by label with tab list + jq"},
  {"id": "board-state", "verb": "ls", "re": ":7376/api/state", "what": "read ag-dash state with curl + jq"},
  {"id": "find-session-grep", "verb": "find", "re": "grep -l\\w* [^|\\n]*(\\.pi/agent/sessions|\\.jsonl)", "what": "grep -l over session files to find a session"},
  {"id": "transcript-jq", "verb": "read", "re": "(\\.pi/agent/sessions|\\.jsonl|api/transcript)[\\s\\S]*(message\\.role|\\.role ?==)|(message\\.role|\\.role ?==)[\\s\\S]*(\\.pi/agent/sessions|\\.jsonl)", "what": "pull user/assistant text out of a transcript"},
  {"id": "pane-read", "verb": "peek", "re": "ag-mux (pane|agent) read|tmux -L ag capture-pane", "what": "read another session's screen"},
  {"id": "inbox-curl", "verb": "spawn", "re": ":7373/prompt", "what": "spin out via curl to the ag-inbox"},
  {"id": "report-back", "verb": "report", "re": "Report from split-out", "what": "hand-built report back to the originating session"},
  {"id": "agent-prompt", "verb": "send", "re": "ag-mux agent prompt", "what": "prompt another session via agent prompt"},
  {"id": "merge-jsonl", "verb": "merge", "re": "merged-into", "what": "hand-built merged-into / session_info JSONL"},
  {"id": "card-curl", "verb": "pin/wait", "re": ":7376/api/card", "what": "pin / waiting via POST /api/card"},
  {"id": "tab-close", "verb": "close", "re": "ag-mux tab close", "what": "close a tab"},
  {"id": "tab-rename", "verb": "rename", "re": "ag-mux tab rename", "what": "rename a tab"},
  {"id": "tab-create-start", "verb": "spawn", "re": "ag-mux agent start", "what": "tab create + agent start by hand"},
  {"id": "manual-sync", "verb": "sync", "re": "ssh (-\\S+ )*(ag-mac|ag-client|ag-engine)[^\\n]*git (pull|-C)", "what": "pull/restow ag or dotfiles on each machine by hand"},
  {"id": "agents-build", "verb": "sync", "re": "agents\\.md/build", "what": "rebuild AGENTS.md by hand"},
  {"id": "service-ctl", "verb": "status/logs/restart", "re": "systemctl --user (status|restart|start|stop) (ag-|pi-)|launchctl (kickstart|list|print)[^|;\\n]*\\bag[.-]", "what": "check or restart an Ag service by hand"},
  {"id": "service-logs", "verb": "logs", "re": "journalctl --user[^|;\\n]*-u (ag-|pi-)|\\.local/state/ag-[\\w-]+(/[^ ]*)?\\.log", "what": "read an Ag service log by hand"},
  {"id": "routine-state", "verb": "routine", "re": "state/routines/[\\w-]+\\.json\\b|systemctl --user list-timers", "what": "inspect routine status/timers by hand (not a routine using its own state dir)"},
  {"id": "agent-status", "verb": "ls", "re": "ag-mux (agent|pane) get", "what": "check another session's agent status with agent/pane get + jq"},
  {"id": "mux-snapshot", "verb": "ls", "re": "ag-mux (api snapshot|tab list)", "what": "dump the whole mux state (snapshot / tab list) + jq"},
  {"id": "dev-tab", "verb": "(none yet)", "re": "ag-mux tab create", "what": "open a labeled dev-process tab (server, watcher) by hand"}
]
