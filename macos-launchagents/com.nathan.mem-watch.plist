<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nathan.mem-watch</string>
  <!-- Every 5 min: sample memory, log it, notify Nathan on high pressure/swap/hog (bin/dot-local/bin/mem-watch). All machines. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>exec "$HOME/.local/bin/mem-watch" check</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/mem-watch.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/mem-watch.log</string>
</dict>
</plist>
