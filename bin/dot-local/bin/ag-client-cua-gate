#!/usr/bin/env bun
// ag-client-cua-gate: decide whether an agent on ag-mac may drive the CLIENT Mac's desktop.
//
// Driving the client (ag-client-cua, or ssh + osascript/Hammerspoon UI automation) is an antipattern:
// work belongs on ag. It's allowed only when the thing exists solely on the client (a dialog or
// permission prompt showing there, iPhone Mirroring, a client-only setting). The ag-rule for hook
// `cua` (default ag-client-cua-gate in ~/ag/ag-rules: Jev judges each attempt against that rule)
// decides. Unjustified, unsure, or the rule failing → blocked (fail closed); no `cua` rule at all → allowed,
// since the rule is the policy. On a block, a new Inbox session is spun out (ag-inbox) to get the
// missing access onto ag-mac so it never happens again.
//
//   ag-client-cua-gate [--kind cua|ssh] [--why TEXT] [--goal TEXT] [--session FILE] [--pane ID] -- <command or task>
//     prints a JSON verdict; exit 0 = allowed (verdict.token lets ag-client-cua skip re-checking), 3 = blocked
//   ag-client-cua-gate --consume <token>   exit 0 if the token is a fresh approval (single use)
//
// Callers: the Pi extension ag-client-cua-guard.ts (before a bash tool call runs) and ag-client-cua itself
// (so Codex, Claude Code, and scripts hit the same gate). Log: ~/.local/state/ag-client-cua-gate/log.jsonl

import { createHash, randomUUID } from "node:crypto";
import { appendFileSync, existsSync, mkdirSync, readFileSync, rmSync, statSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import * as agRules from "../../../ag-rules/engine.ts"; // hook `cua`

const HOME = homedir();
const STATE = `${HOME}/.local/state/ag-client-cua-gate`;
const INBOX_URL = process.env.CLIENT_CUA_GATE_INBOX ?? "http://ag:7373/prompt?new=1";
const TOKEN_TTL_MS = 10 * 60_000;
const SPAWN_DEDUP_MS = 6 * 3600_000; // same blocked task → one access session
const SESSION_DEDUP_MS = 3600_000; // one access session per blocked agent session per hour


mkdirSync(`${STATE}/tokens`, { recursive: true });
const log = (event: string, data: object) =>
	appendFileSync(`${STATE}/log.jsonl`, JSON.stringify({ ts: new Date().toISOString(), event, ...data }) + "\n");


// Flags take one value; everything else (or all after "--") is the command. Bun eats a leading "--".
const args = process.argv.slice(2);
const flags: Record<string, string> = {};
const rest: string[] = [];
for (let i = 0; i < args.length; i++) {
	if (args[i] === "--") { rest.push(...args.slice(i + 1)); break; }
	if (/^--(kind|why|goal|session|pane|consume)$/.test(args[i])) flags[args[i].slice(2)] = args[++i] ?? "";
	else rest.push(args[i]);
}
const opt = (name: string) => flags[name.slice(2)];

if ("consume" in flags) {
	const f = `${STATE}/tokens/${flags.consume.replace(/[^\w-]/g, "")}`;
	const ok = !!flags.consume && existsSync(f) && Date.now() - statSync(f).mtimeMs < TOKEN_TTL_MS;
	if (existsSync(f)) rmSync(f);
	process.exit(ok ? 0 : 1);
}

const command = rest.join(" ").trim() || (await Bun.stdin.text()).trim();
if (!command) {
	console.error("usage: ag-client-cua-gate [--kind cua|ssh] [--why TEXT] [--goal TEXT] [--session FILE] [--pane ID] -- <command>");
	process.exit(2);
}
const kind = opt("--kind") ?? "cua";
const why = opt("--why") ?? "";
const goal = opt("--goal") ?? "";
const session = opt("--session") ?? "";
const pane = opt("--pane") ?? process.env.AG_PANE_ID ?? process.env.TMUX_PANE ?? "";

type Verdict = { allow: boolean; reason: string; justified?: number; drives?: number };
async function judge(): Promise<Verdict> {
	if (!agRules.rulesFor("cua").length) return { allow: true, reason: "no cua ag-rule enabled, so nothing to check" };
	const v = await agRules.runRule<Verdict>("cua", { kind, command, why, goal });
	return v ?? { allow: false, reason: "the cua ag-rule gave no verdict; failing closed" };
}
function accessPrompt(verdict: string): string {
	return `Get missing access onto ag-mac (spun out by the client-CUA guard)

An agent on ag-mac tried to drive the client Mac's desktop (ag-client) instead of doing its work on ag-mac. The user's rule: computer use on the client is an antipattern; it's only for things that exist solely on the client (a dialog or permission prompt showing there, iPhone Mirroring, a client-only setting), never "because it's already signed in on the client". The guard (ag-client-cua-gate, judged by Jev) blocked it: ${verdict}

Blocked command:
\`\`\`
${command.slice(0, 4000)}
\`\`\`
Agent's justification: ${why || "(none given)"}
Its session goal: ${goal || "(unknown)"}
Blocked pi session: ${session || "(not a pi session)"}${pane ? `\nBlocked agent's tmux pane: ${pane}` : ""}

Your job: make sure this never needs the client again, by getting the right access onto ag.
1. Read the blocked session (if given) and work out exactly what it needed (app, account, API, MCP server, permission) and why ag couldn't do it. First check whether an open session is already getting this access (\`ag find <topic>\`); if so, hand it this context with \`ag send <session> "…"\` instead of duplicating the work, and close this tab.
2. Fix what you can safely yourself, preferring programmatic access: an API/CLI/MCP credential (store a scoped key in the canonical vault with op-ag, or op-shared for the user's personal services, never printing it), install the tool or app on ag-mac (Brewfile), start the app's sign-in flow on ag-mac with ag-chatgpt-cua, grant ag-mac's permission dialogs.
3. For a login only the user can do, ask them clearly and politely: exactly what to sign in to on ag-mac, and why (message them with ag-text as well as here).
4. Record the fix in the ag repo (~/ag: README, secrets checklist, docs) or dotfiles (Brewfile), commit, push, and sync every machine in machines/README.md.
5. Once ag-mac has the access, tell the blocked agent${pane ? ` (\`ag-mux agent prompt ${pane} "..."\`, starting with a line saying it's from the access session)` : ""} so it can finish its task on ag-mac.
Don't use ag-client-cua or drive the client desktop yourself; the guard blocks that too.`;
}

// One access session per blocked task (and per blocked agent session) at a time.
async function spawnAccessSession(verdict: string): Promise<string> {
	const key = createHash("sha1").update(command.replace(/\s+/g, " ")).digest("hex").slice(0, 16);
	const sessKey = session ? createHash("sha1").update(session).digest("hex").slice(0, 16) : "";
	const spawnedFile = `${STATE}/spawned.json`;
	let spawned: Record<string, number> = {};
	try { spawned = JSON.parse(readFileSync(spawnedFile, "utf8")); } catch {}
	const recent = (k: string, ms: number) => !!k && Date.now() - (spawned[k] ?? 0) < ms;
	if (recent(key, SPAWN_DEDUP_MS) || recent(`s:${sessKey}`, SESSION_DEDUP_MS)) return "already requested (an access session was spun out for this recently; look in ag-dash's Inbox)";
	const res = await fetch(INBOX_URL, {
		method: "POST",
		headers: { "content-type": "text/plain" },
		body: accessPrompt(verdict),
		signal: AbortSignal.timeout(40_000), // the inbox answers once pi has the prompt (the guard allows 60s total)
	});
	if (!res.ok) throw new Error(`ag-inbox ${res.status}`);
	spawned[key] = Date.now();
	if (sessKey) spawned[`s:${sessKey}`] = Date.now();
	writeFileSync(spawnedFile, JSON.stringify(spawned));
	return "spun out a new Inbox session to get this access onto ag-mac";
}

let verdict: Verdict;
try {
	verdict = await judge();
} catch (e) {
	verdict = { allow: false, reason: `the cua ag-rule failed (${e}); failing closed` };
}
const allow = verdict.allow;
const scores = verdict.reason;
const answers = { justified: verdict.justified, drives: verdict.drives };
const error = "";
const out: Record<string, unknown> = { allow, kind, ...answers, error: error || undefined };

if (allow) {
	const token = randomUUID();
	writeFileSync(`${STATE}/tokens/${token}`, "");
	out.token = token;
	out.reason = `Allowed: ${scores}.`;
} else {
	let access: string;
	try { access = await spawnAccessSession(scores); } catch (e) { access = `couldn't spin out the access session (${e}); tell the user`; }
	out.access = access;
	out.reason = `Blocked by the client-CUA guard (${scores}). Driving the client Mac's desktop is an antipattern: it's only for things that exist solely on the client (a dialog or permission prompt showing there, iPhone Mirroring, a client-only setting), never because something is already signed in on the client. Do the task on ag-mac instead (API/CLI/MCP, or ag-chatgpt-cua on ag-mac's own desktop). Access: ${access}. If you can't proceed without it, tell the user what ag-mac is missing and wait for the access session instead of retrying on the client.`;
}
log(allow ? "allowed" : "blocked", { kind, command: command.slice(0, 2000), why, session, pane, answers, error: error || undefined, access: out.access });
console.log(JSON.stringify(out));
process.exit(allow ? 0 : 3);
