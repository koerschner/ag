#!/usr/bin/env python3
"""ag spawn — split work out into a new pi session that reports back to this one.

    ag spawn "prompt" | -f prompt.md | (prompt on stdin)  [--cwd D] [--label L] [--no-report] [--json]
Default: through the ag-inbox (a new tab, named by its router, never routed into an existing session).
--cwd/--label: open the tab yourself in that directory / with that name instead.
Appends the report-back footer naming this session (an <ag-origin kind="spawn" sid=…> tag), so the new session's `ag report`
reaches you; --no-report leaves it off. Give it everything in this first prompt: a session stays in the Inbox
until its second prompt, which counts as the user's first reply. Prints the new tab and its ag-dash link.
"""
import json, os, secrets, sys, time
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from aglib import *


def wait_sid(pane, secs=20):
    end = time.time() + secs
    while time.time() < end:
        try:
            p = mux_json("pane", "get", pane)["pane"]
            s = sid_of((p.get("agent_session") or {}).get("value"))
            if s:
                return s
        except AgError:
            pass
        time.sleep(0.5)
    return None


def main(argv):
    o, pos = flags(argv, {"-f": True, "--file": "-f", "--cwd": True, "--label": True,
                          "--no-report": False, "--json": False})
    if o.get("--help"):
        return usage(__doc__)
    if o.get("-f"):
        text = open(os.path.expanduser(o["-f"]), encoding="utf-8").read()
    elif pos and pos != ["-"]:
        text = " ".join(pos)
    elif not sys.stdin.isatty():
        text = sys.stdin.read()
    else:
        return usage(__doc__)
    text = text.strip()
    if not text:
        raise AgError("empty prompt")
    ix = Index()
    if not o.get("--no-report"):
        try:
            me = self_session(ix)
            text += "\n\n" + origin_tag(
                "spawn", "Spawned by", title=me.title, sid=me.sid,
                note=f"Spawned by session “{me.title}” ({me.link}). When you're done or blocked, report back with "
                     f"`ag report \"<what happened, links, anything the user must do>\"`; it reaches that session (or the ag-inbox if it's gone).")
        except AgError:
            print("ag spawn: not in a session, so no report-back footer", file=sys.stderr)

    if o.get("--cwd") or o.get("--label"):
        args = ["tab", "create", "--cwd", os.path.expanduser(o.get("--cwd") or "~"), "--no-focus"]
        if o.get("--label"):
            args += ["--label", o["--label"]]
        t = mux_json(*args)
        tab, pane = t["tab"]["tab_id"], t["root_pane"]["pane_id"]
        try:
            mux("agent", "start", f"sp-{secrets.token_hex(3)}", "--kind", "pi", "--pane", pane, "--timeout", "30000")
            mux("agent", "prompt", pane, text)
        except AgError:
            mux("tab", "close", tab, check=False)
            raise
        res = {"tab": tab, "pane": pane, "label": o.get("--label")}
    else:
        res = http("POST", INBOX + "?new=1", text, ctype="text/plain", timeout=90)
        if not isinstance(res, dict) or not res.get("tab"):
            raise AgError(f"ag-inbox: {res}")
    sid = wait_sid(res["pane"])
    res["sid"] = sid
    res["link"] = link(sid) if sid else None
    if o.get("--json"):
        print(json.dumps(res))
    else:
        try:
            title = resolve(res["tab"]).title
        except AgError:
            title = res.get("label") or res["tab"]
        print(f"spawned {title} ({res['tab']})  {res['link'] or ''}")


run_main(main)
