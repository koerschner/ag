#!/usr/bin/env -S uv run --quiet --script
"""Run 1Password CLI with a single-vault service-account Keychain credential.

Invoked as op-ag: arcade.school vault. Invoked as op-shared (a symlink to this
file): Nathan's machine-shared vault. Each name maps to its own Keychain item.
"""
import os
import plistlib
import subprocess
import sys
import tempfile
import threading
import time
import uuid
from pathlib import Path

SERVICES = {
    "op-ag": "ag 1Password service account",
    "op-shared": "ag machine-shared service account",
}
NAME = Path(__file__).name
if NAME not in SERVICES:
    print(f"{NAME}: unknown wrapper name (expected one of {', '.join(SERVICES)})",
          file=sys.stderr)
    sys.exit(1)
KEYCHAIN_COMMAND = [
    "/usr/bin/security", "find-generic-password", "-a", "natkoersch",
    "-s", SERVICES[NAME], "-w",
]


def read_token():
    result = subprocess.run(KEYCHAIN_COMMAND, capture_output=True, timeout=10)
    if result.returncode == 0:
        return result.stdout.strip()

    # SSH has a separate macOS security session. A one-shot job in the logged-in
    # user's GUI session can read the same Keychain item. The credential travels
    # through a private FIFO into memory; no token file or persistent agent exists.
    target = f"gui/{os.getuid()}"
    label = f"com.nathan.{NAME}-keychain." + uuid.uuid4().hex
    with tempfile.TemporaryDirectory(prefix=f"{NAME}-") as directory:
        folder = Path(directory)
        pipe = folder / "token.pipe"
        os.mkfifo(pipe, 0o600)
        descriptor = os.open(pipe, os.O_RDONLY | os.O_NONBLOCK)
        job = folder / "job.plist"
        job.write_bytes(plistlib.dumps({
            "Label": label, "ProgramArguments": KEYCHAIN_COMMAND,
            "RunAtLoad": True, "StandardOutPath": str(pipe),
            "StandardErrorPath": "/dev/null",
        }))
        try:
            result = subprocess.run(
                ["/bin/launchctl", "bootstrap", target, str(job)],
                capture_output=True, timeout=10,
            )
            if result.returncode != 0:
                raise RuntimeError("the logged-in macOS session is unavailable")
            data = b""
            deadline = time.monotonic() + 10
            while time.monotonic() < deadline:
                try:
                    data += os.read(descriptor, 65536)
                except BlockingIOError:
                    pass
                if b"\n" in data:
                    return data.strip()
                if len(data) > 65536:
                    break
                time.sleep(0.05)
            raise RuntimeError("unlock the login Keychain or provision the token")
        finally:
            # Bootstrap can time out after registering the job, so always clean up.
            try:
                cleanup = subprocess.run(
                    ["/bin/launchctl", "bootout", f"{target}/{label}"],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                    timeout=10,
                )
                if cleanup.returncode != 0:
                    check = subprocess.run(
                        ["/bin/launchctl", "print", f"{target}/{label}"],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                        timeout=5,
                    )
                    if check.returncode == 0:
                        raise RuntimeError("could not unload the temporary Keychain job")
            finally:
                os.close(descriptor)


# Fail fast instead of hanging forever. `op` opens 1Password's Group Container at
# startup; while macOS shows an unanswered "... would like to access data from
# other apps" prompt, that open() blocks with no timeout (2026-09-28: agents hung
# ~1h). The wrapper shares op's TCC attribution, so probe the same path first.
GROUP_CONTAINER = Path.home() / "Library/Group Containers/2BUA8C4S2C.com.1password"
PROBE_SECONDS = 5
# Whole-command cap (not for `op run`, which wraps arbitrary long commands).
TIMEOUT_SECONDS = float(os.environ.get("OP_AG_TIMEOUT", "120"))


def fail(message):
    print(f"{NAME}: {message}", file=sys.stderr)
    sys.stderr.flush()
    os._exit(1)  # a probe thread may still be blocked in the kernel


def probe_group_container():
    def touch():
        try:
            os.listdir(GROUP_CONTAINER)
        except OSError:
            pass  # missing or denied is fine: op then just skips app integration

    probe = threading.Thread(target=touch, daemon=True)
    probe.start()
    probe.join(PROBE_SECONDS)
    if probe.is_alive():
        fail(
            "macOS is blocking access to 1Password's app data, most likely an "
            "unanswered privacy prompt ('\u2026 would like to access data from "
            "other apps', often shown as \"bun\") on ag's screen. Answer it "
            "(Don't Allow is enough), then retry."
        )


os.umask(0o077)
probe_group_container()
try:
    token = read_token().decode("ascii")
    if not token:
        raise RuntimeError("the service token is empty")
except (RuntimeError, OSError, subprocess.TimeoutExpired, UnicodeError) as error:
    print(f"{NAME}: {error}", file=sys.stderr)
    sys.exit(1)

# Inherited Connect credentials must not select a broader identity.
environment = os.environ.copy()
environment.pop("OP_CONNECT_HOST", None)
environment.pop("OP_CONNECT_TOKEN", None)
environment["OP_SERVICE_ACCOUNT_TOKEN"] = token
command = ["op", *sys.argv[1:]]
if sys.argv[1:2] == ["run"] or TIMEOUT_SECONDS <= 0:
    os.execvpe("op", command, environment)
try:
    child = subprocess.run(command, env=environment, timeout=TIMEOUT_SECONDS)
except subprocess.TimeoutExpired:
    fail(
        f"op did not finish within {TIMEOUT_SECONDS:g}s and was stopped. Check "
        "ag's network and for pending macOS/1Password prompts on its screen "
        "(set OP_AG_TIMEOUT to change the limit)."
    )
except KeyboardInterrupt:
    sys.exit(130)
sys.exit(child.returncode if child.returncode >= 0 else 128 - child.returncode)
