#!/usr/bin/env bash
# Assemble the global agent instructions (pi/dot-pi/agent/AGENTS.md) from agents.md/.
#   sections/NNN-name.md   one top-level `##` section each, concatenated in filename order
#                          (renumber to reorder; leave gaps of 10 to insert between)
#   includes/NAME.md       longer docs pulled into a section by a line `<!-- include: NAME.md -->`,
#                          headings demoted two levels so they nest under that section
#   build          write the generated file
#   build --check  exit 1 if the generated file is out of date
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
out="$here/../pi/dot-pi/agent/AGENTS.md"

render() {
  printf '<!-- GENERATED by agents.md/build from agents.md/sections/ and agents.md/includes/. Do not edit; edit the sources and rebuild. -->\n\n'
  local first=1
  for section in "$here"/sections/*.md; do
    # Sections are separated by one blank line; each source file ends at its last line.
    (( first )) || printf '\n'
    first=0
    while IFS= read -r line || [[ -n $line ]]; do
      if [[ $line =~ ^\<!--\ include:\ ([A-Za-z0-9._-]+)\ --\>$ ]]; then
        src="$here/includes/${BASH_REMATCH[1]}"
        [[ -f $src ]] || { echo "build: missing include $src" >&2; exit 1; }
        awk '/^```/ { fence = !fence } !fence && /^#/ { $0 = "##" $0 } { print }' "$src"
      else
        printf '%s\n' "$line"
      fi
    done < <(sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$section")
  done
}

if [[ ${1:-} == --check ]]; then
  diff -q <(render) "$out" >/dev/null || { echo "build: $out is stale; run agents.md/build" >&2; exit 1; }
else
  render > "$out"
fi
