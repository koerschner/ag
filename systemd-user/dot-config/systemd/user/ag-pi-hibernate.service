# Hibernate idle Pi sessions, wake them when viewed. Runs on the session host only (machines/README.md role host); ported from macos-launchagents.
[Unit]
Description=Hibernate idle Pi sessions, wake them when viewed
After=network-online.target ag-mux.service

[Service]
ExecCondition=%h/.local/bin/ag-machine-role host
ExecStart=/usr/bin/zsh -lc 'exec %h/.local/bin/ag-pi-hibernate daemon'
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
