#!/usr/bin/env python3
"""ag-verify-move: prove Ag's session data moved cleanly from ag-mac to the engine (docs/tmux-port.md).

  ag-verify-move pre   [--spot N]   before the switch: hashes, plus a trial restore on an isolated tmux
                                    server on the engine (tab → session mapping, N tabs actually resumed)
  ag-verify-move post  [--spot N]   after the switch: hashes (mac-side files must match exactly now) and
                                    the live engine's tabs vs the exported Herdr layout
  --no-hashes / --no-tabs / --no-archive   skip a check (ag-move-host checks data before it starts the
                engine's services, which then change their own state, and tabs after the restore)
  --html FILE   also write a review page;  --layout FILE  exported layout (default: fresh export-herdr pre,
                ~/.local/state/cutover/layout.json post)

Checks:
  1. every Pi session file under ~/.pi/agent/sessions on ag-mac exists on the engine with the same sha256,
     counted per project dir (files still being written count as "live", not missing);
  2. every tab maps to the same workspace, label and session file after restore; N random tabs are woken
     and must report that session;
  3. service state (AG Dash, tickler, inbox, activity, notify/tab-name logs…), ~/inbox and ~/review files
     are identical;
  4. the pi-sessions archive runs from the engine.
Exit 1 on any mismatch. Paths need no remap: /Users/natkoersch is a symlink to the engine's home.
"""
import hashlib, html, json, os, random, subprocess, sys, time

ENGINE = os.environ.get("AG_MOVE_TO", "ag-engine")
HOME = os.path.expanduser("~")
STATE = [".local/state/" + d for d in ("tickler", "ag-board", "ag-inbox", "presence", "activity", "ag-notify",
                                       "herdr-tab-name", "herdr-inbox-file", "client-cua-gate", "pi-hibernate")]
TREES = {"Pi sessions": [".pi/agent/sessions"], "Service state": STATE, "~/inbox and ~/review": ["inbox", "review"]}
LIVE_S = 120  # a file modified this recently on ag-mac is still being written

HASHER = r'''
import hashlib, json, os, sys
home = os.path.expanduser("~"); out = {}
for top in json.loads(sys.argv[1]):
    root = os.path.join(home, top)
    for d, _, files in os.walk(root):
        for f in files:
            p = os.path.join(d, f)
            try:
                h = hashlib.sha256()
                with open(p, "rb") as fh:
                    for b in iter(lambda: fh.read(1 << 20), b""): h.update(b)
                st = os.stat(p); out[os.path.relpath(p, home)] = [h.hexdigest(), st.st_size, st.st_mtime]
            except OSError:
                pass
json.dump(out, sys.stdout)
'''


def local_hashes(tops):
    return json.loads(subprocess.run([sys.executable, "-c", HASHER, json.dumps(tops)], capture_output=True, text=True, check=True).stdout)


def engine(cmd, input=None, timeout=600):
    return subprocess.run(["ssh", ENGINE, cmd], input=input, capture_output=True, text=True, timeout=timeout)


def engine_hashes(tops):
    r = engine(f"python3 -c {sh(HASHER)} {sh(json.dumps(tops))}")
    return json.loads(r.stdout or "{}")


def sh(s):
    return "'" + s.replace("'", "'\\''") + "'"


def compare(name, tops, strict):
    mine, theirs = local_hashes(tops), engine_hashes(tops)
    now = time.time()
    rows, bad = {}, []
    for rel, (h, size, mt) in mine.items():
        group = rel.split("/")[3] if rel.startswith(".pi/agent/sessions/") and rel.count("/") >= 4 else "/".join(rel.split("/")[:3])
        r = rows.setdefault(group, {"files": 0, "same": 0, "live": 0, "missing": 0, "differ": 0})
        r["files"] += 1
        t = theirs.get(rel)
        if t and t[0] == h:
            r["same"] += 1
        elif not strict and now - mt < LIVE_S:
            r["live"] += 1
        elif not t:
            r["missing"] += 1
            bad.append(f"missing on engine: ~/{rel}")
        else:
            r["differ"] += 1
            bad.append(f"differs: ~/{rel} (ag-mac {size} B, engine {t[1]} B)")
    extra = len([k for k in theirs if k not in mine])
    tot = {k: sum(r[k] for r in rows.values()) for k in ("files", "same", "live", "missing", "differ")}
    return {"name": name, "rows": rows, "total": tot, "engine_only": extra, "problems": bad}


def herdr_export():
    r = subprocess.run([os.path.join(HOME, ".local/bin/ag-mux"), "export-herdr"], capture_output=True, text=True,
                       env={**os.environ, "AG_MUX_BACKEND": "herdr"}, check=True)
    return json.loads(r.stdout)


def tab_map(layout):
    out = {}
    for w in layout["workspaces"]:
        for t in w["tabs"]:
            leaves, stack = [], [t["root"]]
            while stack:
                n = stack.pop()
                if n.get("type") == "split":
                    stack += [n["second"], n["first"]]
                elif n.get("session"):
                    leaves.append(os.path.basename(n["session"]))
            out[t["id"]] = {"workspace": w["label"], "label": t["label"], "sessions": sorted(leaves)}
    return out


def restored_map(snap):
    ws = {w["workspace_id"]: w["label"] for w in snap["workspaces"]}
    tabs = {t["tab_id"]: {"workspace": ws.get(t["workspace_id"]), "label": t["label"].rstrip(" ●"), "sessions": []} for t in snap["tabs"]}
    for p in snap["panes"]:
        s = (p.get("agent_session") or {}).get("value") or p.get("sleeping_session")
        if s and p["tab_id"] in tabs:
            tabs[p["tab_id"]]["sessions"].append(os.path.basename(s))
    for t in tabs.values():
        t["sessions"].sort()
    return tabs


def compare_tabs(want, got):
    bad, same = [], 0
    for tid, w in want.items():
        g = got.get(tid)
        if not g:
            bad.append(f"tab {tid} ({w['workspace']} › {w['label']}) not restored")
        elif (g["workspace"], g["label"], g["sessions"]) != (w["workspace"], w["label"], w["sessions"]):
            bad.append(f"tab {tid}: expected {w['workspace']} › {w['label']} {w['sessions']}, got {g['workspace']} › {g['label']} {g['sessions']}")
        else:
            same += 1
    return {"tabs": len(want), "same": same, "problems": bad}


TRIAL = r'''
set -u
export AG_MUX_TMUX=agverify AG_MUX_STATE=/tmp/agverify AG_MUX_SOCKET=/tmp/agverify/agd.sock AG_MUX_BACKEND=tmux AG_MUX_NO_RESTORE=1
M=~/.local/bin/ag-mux
tmux -L agverify kill-server 2>/dev/null; rm -rf /tmp/agverify; mkdir -p /tmp/agverify
cp /tmp/agverify-layout.json /tmp/agverify/layout.json
setsid $M daemon >/tmp/agverify/agd.log 2>&1 < /dev/null & echo $! > /tmp/agverify/pid
for i in $(seq 50); do $M status >/dev/null 2>&1 && break; sleep 0.2; done
$M restore --from /tmp/agverify/layout.json >/dev/null
$M api snapshot
'''
TRIAL_WAKE = r'''
export AG_MUX_SOCKET=/tmp/agverify/agd.sock AG_MUX_BACKEND=tmux
M=~/.local/bin/ag-mux
for p in "$@"; do $M pane send-keys "$p" enter >/dev/null; done
for i in $(seq 120); do
  n=$($M agent list | jq --argjson want "$#" '[.result.agents[] | select(.agent_session.value)] | length')
  [ "$n" -ge "$#" ] && break; sleep 1
done
$M agent list
'''
TRIAL_END = r'''kill $(cat /tmp/agverify/pid) 2>/dev/null; tmux -L agverify kill-server 2>/dev/null; rm -rf /tmp/agverify'''


def spot_check(snap, n):
    sleepers = [p for p in snap["panes"] if p.get("sleeping_session")]
    pick = random.sample(sleepers, min(n, len(sleepers)))
    r = engine("bash -s -- " + " ".join(sh(p["pane_id"]) for p in pick), input=TRIAL_WAKE, timeout=200)
    agents = {a["pane_id"]: a for a in json.loads(r.stdout or '{"result":{"agents":[]}}')["result"]["agents"]}
    out = []
    for p in pick:
        a = agents.get(p["pane_id"])
        got = os.path.basename((a or {}).get("agent_session", {}).get("value") or "")
        out.append({"pane": p["pane_id"], "tab": p["tab_id"], "expected": os.path.basename(p["sleeping_session"]), "resumed": got,
                    "ok": got == os.path.basename(p["sleeping_session"])})
    return out


def archive_check():
    r = engine("systemctl --user start pi-sessions-sync.service; systemctl --user show -p Result,ExecMainStatus --value pi-sessions-sync.service; "
               "journalctl --user -u pi-sessions-sync -n 3 --no-pager -o cat", timeout=900)
    lines = r.stdout.strip().splitlines()
    ok = len(lines) >= 2 and lines[0] == "success" and lines[1] == "0"
    return {"ok": ok, "detail": "\n".join(lines[2:])[-600:]}


def page(rep, path):
    e = html.escape
    def table(c):
        rows = "".join(f"<tr><td>{e(g)}</td><td>{r['files']}</td><td>{r['same']}</td><td>{r['live']}</td><td class={'bad' if r['missing'] else ''}>{r['missing']}</td><td class={'bad' if r['differ'] else ''}>{r['differ']}</td></tr>"
                       for g, r in sorted(c["rows"].items()))
        t = c["total"]
        return (f"<h3>{e(c['name'])}</h3><table><tr><th>where</th><th>files</th><th>identical</th><th>live (being written)</th><th>missing</th><th>differ</th></tr>{rows}"
                f"<tr class=tot><td>total</td><td>{t['files']}</td><td>{t['same']}</td><td>{t['live']}</td><td>{t['missing']}</td><td>{t['differ']}</td></tr></table>"
                f"<p class=note>{c['engine_only']} files exist only on the engine (sessions started there).</p>")
    probs = rep["problems"]
    tabs = rep.get("tabs")
    spot = rep.get("spot") or []
    body = f"""<h1>Ag move: session data check ({e(rep['phase'])})</h1>
<p class=big>{'✅ Clean: no mismatches.' if not probs else f'⚠️ {len(probs)} mismatch(es) — listed below.'}</p>
<p>{e(rep['when'])} · ag-mac → {e(ENGINE)}</p>
{''.join(table(c) for c in rep['trees'])}
<h3>Tabs → sessions</h3>
{f"<p>{tabs['same']} of {tabs['tabs']} tabs come back with the same workspace, label and session file" + (" (trial restore on an isolated tmux server)" if rep['phase']=='pre' else "") + ".</p>" if tabs else ""}
{"<table><tr><th>tab</th><th>expected session</th><th>resumed</th></tr>" + "".join(f"<tr><td>{e(s['tab'])}</td><td>{e(s['expected'])}</td><td class={'' if s['ok'] else 'bad'}>{e(s['resumed'] or '—')}</td></tr>" for s in spot) + "</table>" if spot else ""}
<h3>pi-sessions archive from the engine</h3><p>{'✅ ran' if rep.get('archive', {}).get('ok') else '⚠️ failed'}</p><pre>{e(rep.get('archive', {}).get('detail', ''))}</pre>
{"<h3>Mismatches</h3><ul>" + "".join(f"<li>{e(p)}</li>" for p in probs[:200]) + "</ul>" if probs else ""}"""
    open(path, "w").write(f"""<!doctype html><meta charset=utf-8><meta name=viewport content="width=device-width,initial-scale=1"><title>Ag move check</title>
<style>body{{font:15px system-ui;margin:24px;max-width:900px;color:#222}}table{{border-collapse:collapse;margin:8px 0}}td,th{{border:1px solid #ddd;padding:4px 8px;text-align:right}}
td:first-child,th:first-child{{text-align:left}}.bad{{background:#fdd}}.tot{{font-weight:600}}.big{{font-size:20px}}.note{{color:#777;font-size:13px}}pre{{background:#f5f5f5;padding:8px;white-space:pre-wrap}}</style>{body}""")


def main():
    args = sys.argv[1:]
    phase = args[0] if args and args[0] in ("pre", "post") else sys.exit(__doc__)
    opt = lambda k, d=None: args[args.index(k) + 1] if k in args else d
    spot_n = int(opt("--spot", "3"))
    strict = phase == "post"
    rep = {"phase": phase, "when": time.strftime("%Y-%m-%d %H:%M %Z"), "trees": [], "problems": []}
    for name, tops in ({} if "--no-hashes" in args else TREES).items():
        c = compare(name, tops, strict)
        rep["trees"].append(c)
        rep["problems"] += c["problems"]
    tabs = None
    if "--no-tabs" in args:
        pass
    elif phase == "pre":
        layout = json.load(open(opt("--layout"))) if opt("--layout") else herdr_export()
        subprocess.run(["ssh", ENGINE, "cat > /tmp/agverify-layout.json"], input=json.dumps(layout), text=True, check=True)
        r = engine("bash -s", input=TRIAL, timeout=300)
        try:
            snap = json.loads(r.stdout)["result"]["snapshot"]
            tabs = compare_tabs(tab_map(layout), restored_map(snap))
            rep["spot"] = spot_check(snap, spot_n)
        finally:
            engine(TRIAL_END)
    else:
        layout = json.load(open(opt("--layout", os.path.join(HOME, ".local/state/cutover/layout.json"))))
        snap = json.loads(engine("~/.local/bin/ag-mux api snapshot").stdout)["result"]["snapshot"]
        tabs = compare_tabs(tab_map(layout), restored_map(snap))
    rep["tabs"] = tabs
    rep["problems"] += (tabs or {"problems": []})["problems"] + [f"spot-check: tab {s['tab']} resumed {s['resumed'] or 'nothing'} instead of {s['expected']}" for s in rep.get("spot", []) if not s["ok"]]
    rep["archive"] = {"ok": True, "detail": "skipped"} if "--no-archive" in args else archive_check()
    if not rep["archive"]["ok"]:
        rep["problems"].append("pi-sessions archive failed on the engine")
    print(json.dumps({"phase": phase, "problems": len(rep["problems"]), "trees": {c["name"]: c["total"] for c in rep["trees"]},
                      "tabs": {k: tabs[k] for k in ("tabs", "same")} if tabs else None, "spot": rep.get("spot"), "archive_ok": rep["archive"]["ok"]}, indent=1))
    for p in rep["problems"][:40]:
        print("  -", p)
    if opt("--html"):
        os.makedirs(os.path.dirname(os.path.abspath(opt("--html"))), exist_ok=True)
        page(rep, opt("--html"))
    os.makedirs(os.path.join(HOME, ".local/state/cutover"), exist_ok=True)
    json.dump(rep, open(os.path.join(HOME, f".local/state/cutover/verify-{phase}{'-data' if '--no-tabs' in args else '-tabs' if '--no-hashes' in args else ''}.json"), "w"), indent=1)
    sys.exit(1 if rep["problems"] else 0)


if __name__ == "__main__":
    main()
