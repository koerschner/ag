#!/usr/bin/env python3
"""ag me — who am I: this session's tab, pane, session id, file and ag-dash link.

Found fresh from $PI_SESSION_ID / $PI_SESSION_FILE (else $TMUX_PANE), never $AG_TAB_ID, which goes stale when the
pane moves to another tab.

    ag me [--json]          all of it
    ag me tab|pane|sid|file|link|title    just that value (for scripts: ag close "$(ag me tab)")
"""
import json, os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from aglib import *


def main(argv):
    o, pos = flags(argv, {"--json": False})
    if o.get("--help"):
        return usage(__doc__)
    s = self_session()
    d = s.as_dict()
    if pos:
        key = {"session": "sid", "id": "sid", "label": "title"}.get(pos[0], pos[0])
        if key not in d:
            raise AgError(f"unknown field {pos[0]} (tab, pane, sid, file, link, title)")
        print(d[key] if d[key] is not None else "")
    elif o.get("--json"):
        print(json.dumps(d, indent=1))
    else:
        print(f"{s.title}  ({s.state})")
        print(f"  tab       {s.tab}  pane {s.pane}")
        print(f"  session   {s.sid}")
        print(f"  file      {s.file}")
        print(f"  link      {s.link}")


run_main(main)
