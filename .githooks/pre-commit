#!/usr/bin/env bash
# Reject commits where the generated AGENTS.md doesn't match agents.md/ sources.
cd "$(git rev-parse --show-toplevel)"
if ! agents.md/build --check 2>/dev/null; then
  echo "pre-commit: pi/dot-pi/agent/AGENTS.md is out of date with agents.md/." >&2
  echo "  Edit agents.md/sections/*.md or agents.md/includes/*.md (not the generated file), run agents.md/build, and stage both." >&2
  exit 1
fi
